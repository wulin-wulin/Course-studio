{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-knowledge-forest:schema:textbook-content:2.0",
  "title": "Textbook Content Blocks",
  "description": "按阅读顺序保存教材依据与模型补充；每个块独立记录来源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "textbook-content/2.0"
    },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/block"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin": {
                    "const": "textbook"
                  }
                },
                "required": [
                  "origin"
                ]
              }
            },
            "required": [
              "provenance"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin": {
                    "const": "model"
                  }
                },
                "required": [
                  "origin"
                ]
              }
            },
            "required": [
              "provenance"
            ]
          },
          "minContains": 1
        }
      ]
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialId",
        "blockIds",
        "headingPath",
        "lineStart",
        "lineEnd",
        "assetRefs",
        "excerptSha256"
      ],
      "properties": {
        "materialId": {
          "type": "string",
          "minLength": 1
        },
        "blockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "headingPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "assetRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excerptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "markdown",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "kind": {
          "enum": [
            "definition",
            "explanation",
            "mechanism",
            "procedure",
            "formula",
            "example",
            "worked-example",
            "comparison",
            "application",
            "code",
            "table",
            "figure",
            "warning",
            "misconception",
            "exercise",
            "summary",
            "note",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/textbookProvenance"
            },
            {
              "$ref": "#/$defs/modelProvenance"
            }
          ]
        }
      }
    },
    "textbookProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "representation",
        "sourceSpans"
      ],
      "properties": {
        "origin": {
          "const": "textbook"
        },
        "representation": {
          "enum": [
            "quote",
            "paraphrase"
          ]
        },
        "sourceSpans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        }
      }
    },
    "modelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "basedOnBlockIds"
      ],
      "properties": {
        "origin": {
          "const": "model"
        },
        "basedOnBlockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "sourceSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        }
      }
    }
  }
}
