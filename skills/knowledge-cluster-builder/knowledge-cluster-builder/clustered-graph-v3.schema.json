{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-knowledge-forest:schema:clustered-graph:3.0",
  "title": "Thin Clustered Knowledge Graph",
  "description": "textbook-content/2.0 的薄关系图。正文与来源证据保留在 canonical point 文件中，图谱只保存冻结身份和关系。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "generation", "clusters", "points"],
  "properties": {
    "schema_version": { "const": "clustered-graph/3.0" },
    "subject": { "$ref": "#/$defs/subject" },
    "generation": { "$ref": "#/$defs/generation" },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cluster" }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/point" }
    },
    "sequences": { "$ref": "#/$defs/sequences" }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "input", "normalizedTitle", "inputType", "language",
        "audience", "depth", "scope", "exclusions", "outcomes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "input": { "type": "string", "minLength": 1 },
        "normalizedTitle": { "type": "string", "minLength": 1 },
        "inputType": { "enum": ["course", "domain"] },
        "language": { "type": "string", "minLength": 2 },
        "audience": { "type": "string", "minLength": 1 },
        "depth": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt", "sourceCourseId", "pointCount", "clusterCount",
        "brokenCycleEdges", "refinedPrerequisiteEdges"
      ],
      "properties": {
        "generatedAt": { "type": "string", "format": "date" },
        "sourceCourseId": { "$ref": "#/$defs/kebabId" },
        "pointCount": { "type": "integer", "minimum": 0 },
        "clusterCount": { "type": "integer", "minimum": 0 },
        "brokenCycleEdges": {
          "type": "array",
          "items": { "$ref": "#/$defs/brokenEdge" }
        },
        "refinedPrerequisiteEdges": {
          "description": "对 canonical point prerequisites 的实际增删审计；from 是 dependent，to 是 prerequisite，不重复列出全部最终边。",
          "type": "array",
          "items": { "$ref": "#/$defs/refinedEdge" }
        }
      }
    },
    "brokenEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason"],
      "properties": {
        "from": { "$ref": "#/$defs/kebabId" },
        "to": { "$ref": "#/$defs/kebabId" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "refinedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from", "to", "reason"],
      "properties": {
        "op": { "enum": ["add", "remove"] },
        "from": { "$ref": "#/$defs/kebabId" },
        "to": { "$ref": "#/$defs/kebabId" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "description", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "accent": { "$ref": "#/$defs/hexColor" },
        "soft": { "$ref": "#/$defs/hexColor" },
        "dark": { "$ref": "#/$defs/hexColor" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "origin", "clusterIds", "role",
        "prerequisites", "related"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "title": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["textbook", "llm-extension", "user"] },
        "clusterIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabId" }
        },
        "role": { "enum": ["trunk", "branch", "leaf"] },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabId" }
        },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabId" }
        }
      }
    },
    "sequenceEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromId", "toId"],
      "properties": {
        "fromId": { "$ref": "#/$defs/kebabId" },
        "toId": { "$ref": "#/$defs/kebabId" }
      }
    },
    "sequences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "point"],
      "properties": {
        "cluster": {
          "type": "array",
          "items": { "$ref": "#/$defs/sequenceEdge" }
        },
        "point": {
          "type": "array",
          "items": { "$ref": "#/$defs/sequenceEdge" }
        }
      }
    }
  }
}
