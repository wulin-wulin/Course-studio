{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-knowledge-forest:schema:course-content-point:2.0",
  "title": "Course Content Knowledge Point",
  "description": "知识点详情的兼容联合契约：普通课程使用旧栏目式 v1，教材课程使用来源可追溯的内容块 v2。",
  "oneOf": [
    {
      "$ref": "#/$defs/legacyPoint"
    },
    {
      "$ref": "#/$defs/textbookPoint"
    }
  ],
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialId",
        "blockIds",
        "headingPath",
        "lineStart",
        "lineEnd",
        "assetRefs",
        "excerptSha256"
      ],
      "properties": {
        "materialId": {
          "type": "string",
          "minLength": 1
        },
        "blockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "headingPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "assetRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excerptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "legacyPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "shortSummary",
        "coreIdea",
        "principles",
        "keyTerms",
        "applications",
        "aliases",
        "intuition",
        "misconceptions",
        "qa",
        "animationType",
        "difficulty",
        "importance",
        "prerequisites"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "textbook",
            "llm-extension",
            "user"
          ]
        },
        "sourceSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        },
        "modelEnriched": {
          "type": "boolean",
          "description": "教材依据模式下必填且恒为 true，并与 generation manifest 中的同名字段一致。"
        },
        "shortSummary": {
          "type": "string",
          "minLength": 30,
          "maxLength": 100
        },
        "coreIdea": {
          "type": "string",
          "minLength": 1
        },
        "principles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "keyTerms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "intuition": {
          "type": "string",
          "minLength": 1
        },
        "misconceptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "history": {
          "type": "string",
          "minLength": 1
        },
        "yearIntroduced": {
          "type": "integer"
        },
        "prosCons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pros",
            "cons"
          ],
          "properties": {
            "pros": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "qa": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "q",
              "a"
            ],
            "properties": {
              "q": {
                "type": "string",
                "minLength": 1
              },
              "a": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "visualType": {
          "enum": [
            "foundation",
            "timeline",
            "search",
            "logic",
            "knowledgeGraph",
            "learning",
            "decisionTree",
            "bayes",
            "neuralNetwork",
            "gradient",
            "attention",
            "transformer",
            "vision",
            "agentLoop",
            "diffusion",
            "ethics"
          ]
        },
        "visualSuggestion": {
          "type": "string",
          "minLength": 1
        },
        "animationType": {
          "type": "string",
          "pattern": "^(?:none|[a-z][A-Za-z0-9]*)$"
        },
        "animationSuggestion": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "基础",
            "中等",
            "进阶"
          ]
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        }
      },
      "dependentRequired": {
        "visualType": [
          "visualSuggestion"
        ],
        "visualSuggestion": [
          "visualType"
        ],
        "animationSuggestion": [
          "animationType"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "animationType": {
                "const": "none"
              }
            },
            "required": [
              "animationType"
            ]
          },
          "then": {
            "not": {
              "required": [
                "animationSuggestion"
              ]
            }
          },
          "else": {
            "required": [
              "animationSuggestion"
            ]
          }
        }
      ]
    },
    "textbookPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "shortSummary",
        "keyTerms",
        "animationType",
        "difficulty",
        "importance",
        "prerequisites",
        "origin",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "shortSummary": {
          "type": "string",
          "minLength": 30,
          "maxLength": 100
        },
        "keyTerms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "animationType": {
          "type": "string",
          "pattern": "^(?:none|[a-z][A-Za-z0-9]*)$"
        },
        "animationSuggestion": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "基础",
            "中等",
            "进阶"
          ]
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "origin": {
          "enum": [
            "textbook",
            "llm-extension",
            "user"
          ]
        },
        "content": {
          "$ref": "#/$defs/textbookContent"
        }
      },
      "dependentRequired": {
        "animationSuggestion": [
          "animationType"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "animationType": {
                "const": "none"
              }
            },
            "required": [
              "animationType"
            ]
          },
          "then": {
            "not": {
              "required": [
                "animationSuggestion"
              ]
            }
          },
          "else": {
            "required": [
              "animationSuggestion"
            ]
          }
        }
      ]
    },
    "textbookContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "blocks"
      ],
      "properties": {
        "schema_version": {
          "const": "textbook-content/2.0"
        },
        "blocks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/block"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "provenance": {
                    "properties": {
                      "origin": {
                        "const": "textbook"
                      }
                    },
                    "required": [
                      "origin"
                    ]
                  }
                },
                "required": [
                  "provenance"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "provenance": {
                    "properties": {
                      "origin": {
                        "const": "model"
                      }
                    },
                    "required": [
                      "origin"
                    ]
                  }
                },
                "required": [
                  "provenance"
                ]
              },
              "minContains": 1
            }
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "markdown",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "kind": {
          "enum": [
            "definition",
            "explanation",
            "mechanism",
            "procedure",
            "formula",
            "example",
            "worked-example",
            "comparison",
            "application",
            "code",
            "table",
            "figure",
            "warning",
            "misconception",
            "exercise",
            "summary",
            "note",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/textbookProvenance"
            },
            {
              "$ref": "#/$defs/modelProvenance"
            }
          ]
        }
      }
    },
    "textbookProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "representation",
        "sourceSpans"
      ],
      "properties": {
        "origin": {
          "const": "textbook"
        },
        "representation": {
          "enum": [
            "quote",
            "paraphrase"
          ]
        },
        "sourceSpans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        }
      }
    },
    "modelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "basedOnBlockIds"
      ],
      "properties": {
        "origin": {
          "const": "model"
        },
        "basedOnBlockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "sourceSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        }
      }
    }
  }
}
