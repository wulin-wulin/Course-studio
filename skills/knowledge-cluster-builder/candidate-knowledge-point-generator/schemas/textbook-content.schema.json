{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-knowledge-forest:schema:textbook-content:2.0",
  "title": "Textbook Content Blocks",
  "description": "基于教材证据组织的知识点正文、教学设计与学习资产。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "textbook-content/2.0"
    },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/block"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin": {
                    "const": "textbook"
                  }
                },
                "required": [
                  "origin"
                ]
              }
            },
            "required": [
              "provenance"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "provenance": {
                "properties": {
                  "origin": {
                    "const": "model"
                  }
                },
                "required": [
                  "origin"
                ]
              }
            },
            "required": [
              "provenance"
            ]
          },
          "minContains": 1
        }
      ]
    },
    "learningDesign": {
      "$ref": "#/$defs/learningDesign"
    },
    "learningAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/learningAsset"
      }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialId",
        "blockIds",
        "headingPath",
        "lineStart",
        "lineEnd",
        "assetRefs",
        "excerptSha256"
      ],
      "properties": {
        "materialId": {
          "type": "string",
          "minLength": 1
        },
        "blockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "headingPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "assetRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excerptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "markdown",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "kind": {
          "enum": [
            "definition",
            "explanation",
            "mechanism",
            "procedure",
            "formula",
            "example",
            "worked-example",
            "comparison",
            "application",
            "code",
            "table",
            "figure",
            "warning",
            "misconception",
            "exercise",
            "summary",
            "note",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/textbookProvenance"
            },
            {
              "$ref": "#/$defs/modelProvenance"
            }
          ]
        },
        "moduleId": {
          "$ref": "#/$defs/kebabId"
        },
        "depth": {
          "enum": [
            "core",
            "support",
            "advanced"
          ]
        }
      }
    },
    "textbookProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "representation",
        "sourceSpans"
      ],
      "properties": {
        "origin": {
          "const": "textbook"
        },
        "representation": {
          "enum": [
            "quote",
            "paraphrase"
          ]
        },
        "sourceSpans": {
          "description": "本 Schema 描述展开后的规范形式（完整 span 对象）。worker 草稿中只写任务包 evidence.spans[].ref 字符串，由 finalize-point-drafts 机械展开为可信 span；未展开的 ref 不能通过 validate-points。",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        }
      }
    },
    "modelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "basedOnBlockIds"
      ],
      "properties": {
        "origin": {
          "const": "model"
        },
        "basedOnBlockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "sourceSpans": {
          "description": "本 Schema 描述展开后的规范形式（完整 span 对象）。worker 草稿中只写任务包 evidence.spans[].ref 字符串，由 finalize-point-drafts 机械展开为可信 span；未展开的 ref 不能通过 validate-points。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        }
      }
    },
    "learningOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "learningModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcomeRefs",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "outcomeRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "learningCompletion": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "outcomeRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exerciseBlockId": {
          "$ref": "#/$defs/kebabId"
        },
        "summaryBlockId": {
          "$ref": "#/$defs/kebabId"
        },
        "nextPointId": {
          "$ref": "#/$defs/kebabId"
        }
      }
    },
    "learningDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryPattern",
        "estimatedMinutes",
        "outcomes",
        "misconceptions",
        "modules",
        "completion"
      ],
      "properties": {
        "primaryPattern": {
          "type": "string",
          "minLength": 1
        },
        "adaptationLevel": {
          "enum": [
            "faithful",
            "balanced",
            "teaching-first"
          ],
          "default": "balanced",
          "description": "教学重编强度；省略时按 balanced（平衡重编）解释。"
        },
        "editorialPolicy": {
          "type": "string",
          "minLength": 1
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/learningOutcome"
          }
        },
        "misconceptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/learningModule"
          }
        },
        "completion": {
          "$ref": "#/$defs/learningCompletion"
        }
      }
    },
    "learningAssetGrounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basedOnBlockIds"
      ],
      "properties": {
        "basedOnBlockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        }
      }
    },
    "learningAssetFallback": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "$ref": "#/$defs/kebabId"
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "type"
              ]
            },
            {
              "required": [
                "mode"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "blockId"
              ]
            },
            {
              "required": [
                "markdown"
              ]
            },
            {
              "required": [
                "caption"
              ]
            },
            {
              "required": [
                "content"
              ]
            }
          ]
        }
      ]
    },
    "learningAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "anchorBlockId",
        "outcomeRefs",
        "learningPurpose",
        "grounding",
        "fallback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "type": {
          "$ref": "#/$defs/kebabId"
        },
        "anchorBlockId": {
          "$ref": "#/$defs/kebabId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "moduleId": {
          "$ref": "#/$defs/kebabId"
        },
        "depth": {
          "enum": [
            "core",
            "support",
            "advanced"
          ]
        },
        "animationType": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "outcomeRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebabId"
          }
        },
        "learningPurpose": {
          "type": "string",
          "minLength": 1
        },
        "grounding": {
          "$ref": "#/$defs/learningAssetGrounding"
        },
        "config": {
          "type": "object",
          "description": "学习资产类型自有的 JSON 配置，由对应前端组件解释。",
          "additionalProperties": true
        },
        "fallback": {
          "$ref": "#/$defs/learningAssetFallback"
        }
      }
    }
  }
}
