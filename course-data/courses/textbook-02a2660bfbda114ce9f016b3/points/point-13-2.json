              "assetRefs": [],
              "excerptSha256": "0e014baab71e1b33da958b1bf21f36efdaaf33ecba24aaed228dc9d7b00386be"
            }
          ]
        }
      },
      {
        "id": "model-mutable-summary",
        "moduleId": "in-place-mutation",
        "depth": "support",
        "kind": "comparison",
        "title": "补充对照：可变性的后果",
        "markdown": "`append`、`sort` 和 `del` 都在修改同一个列表对象：列表的**身份**没有变，**内容**在变。这正是“可变”的含义。\n\n| 操作 | 是否改变原对象 | 典型返回 |\n|---|---|---|\n| `shoplist.append(x)` | 是 | `None` |\n| `shoplist.sort()` | 是 | `None` |\n| `del shoplist[0]` | 是 | 无返回值 |\n| `'abc'.upper()`（字符串） | 否 | 新字符串 |\n\n最后一行说明为什么教材把字符串称为不可变：想让字符串改变，只能得到一个新对象，原来的对象保持不变。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-sort",
            "tb-del"
          ]
        }
      },
      {
        "id": "tb-tuple",
        "moduleId": "bridge-to-tuple",
        "depth": "core",
        "kind": "definition",
        "title": "教材对元组的介绍",
        "markdown": "教材随即用元组（Tuple）作对照：元组把多个对象保存在一起，可以近似看作列表，但不提供列表那样广泛的功能。元组与字符串一样是不可变的，不能编辑或更改。\n\n定义元组时可以用括号包住项目，并在括号内用逗号分隔；元组常用来保证某一语句或某个函数安全地接受一组不会改变的数值。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-02a2660bfbda114ce9f016b3",
              "blockIds": [
                "block-000099"
              ],
              "headingPath": [
                "数据结构",
                "它是如何工作的"
              ],
              "lineStart": 838,
              "lineEnd": 850,
              "assetRefs": [],
              "excerptSha256": "0e014baab71e1b33da958b1bf21f36efdaaf33ecba24aaed228dc9d7b00386be"
            }
          ]
        }
      },
      {
        "id": "model-tuple-bridge",
        "moduleId": "bridge-to-tuple",
        "depth": "support",
        "kind": "note",
        "title": "补充桥接：列表与元组怎么选",
        "markdown": "把两者放在一起看：列表和元组都能按顺序保存多个对象，区别在于列表可变而元组不可变。选择时可以先问一句：这组数据在创建后需要修改吗？需要就用列表，不需要且希望防止误改就用元组。\n\n元组的定义还有一些容易忽略的细节，例如只有一个项目的元组如何书写。下一点会专门讨论空元组和单元素元组。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-tuple",
            "tb-list-overview"
          ]
        }
      },
      {
        "id": "check-your-understanding",
        "moduleId": "practice-check",
        "depth": "core",
        "kind": "exercise",
        "title": "检查你的理解",
        "markdown": "1. 执行 `nums = [3, 1, 2]` 后调用 `nums.sort()`，再打印 `nums`，输出是什么？如果把结果赋给 `x`，`x` 的值又是什么？\n2. 已知 `shoplist = ['apple', 'mango']`，写出删除第一个元素的语句，并说明为什么下标是 0。\n3. 为什么 `shoplist.append('rice')` 之后看不到返回值，也能确认添加成功？\n4. 列表和元组在这节课的例子里最关键的差别是什么？\n\n参考思路：第 1 题区分原地排序与返回值；第 2 题回到 0 基索引；第 3 题关注修改对象本身；第 4 题从可变性作答。",
        "provenance": {
          "origin": "model",
