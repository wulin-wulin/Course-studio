                "block-000013"
              ],
              "headingPath": [
                "前言",
                "值得思考的一些事情"
              ],
              "lineStart": 114,
              "lineEnd": 123,
              "assetRefs": [],
              "excerptSha256": "b5f8d252f7de71fd3f914475e524737288ca86b1ae62f0711d92907715d122f0"
            }
          ]
        }
      },
      {
        "id": "model-self-position",
        "moduleId": "who-it-is-for",
        "depth": "support",
        "kind": "note",
        "title": "模型补充：三个起点自检问题",
        "markdown": "动笔之前先回答三个问题：\n\n1. 我是否能在命令行或编辑器里成功运行一个只有一行输出的程序？\n2. 我是否理解变量、条件和循环这些基本概念？\n3. 我每周能稳定拿出多少时间练习？\n\n前两题都答“否”时，按新手路径顺序阅读；答“是”时，可以把重点放在语言差异与练习题上。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "audience-entry"
          ]
        }
      },
      {
        "id": "experienced-reader-focus",
        "moduleId": "who-it-is-for",
        "depth": "support",
        "kind": "note",
        "title": "教材对有经验读者的提示",
        "markdown": "教材还提到，有经验的读者可能关心 Python 与自己熟悉的编程语言有什么区别，作者会在书中展示这些区别。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
