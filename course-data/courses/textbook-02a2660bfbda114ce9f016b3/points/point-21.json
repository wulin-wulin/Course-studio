    "blocks": [
      {
        "id": "tb-what-is-floss",
        "moduleId": "floss-definition",
        "depth": "core",
        "kind": "definition",
        "title": "教材定义：自由/开放源代码软件",
        "markdown": "**FLOSS** 是自由/开放源代码软件的简称。教材把它描述为一个基于社区概念而建立的组织，而这个社区建立在分享、尤其是知识分享的观念之上。FLOSS 的成员软件都可以免费使用、修改与分发。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-02a2660bfbda114ce9f016b3",
              "blockIds": [
                "block-000159"
              ],
              "headingPath": [
                "附录：FLOSS"
              ],
              "lineStart": 1341,
              "lineEnd": 1366,
              "assetRefs": [],
              "excerptSha256": "06407de89fba45149197d95ab757a91f82a8fb680e8235f79876824a78eca17d"
            }
          ]
        }
      },
      {
        "id": "model-floss-analogy",
        "moduleId": "floss-definition",
        "depth": "support",
        "kind": "explanation",
        "title": "补充直觉：共同维护的公共工具箱",
        "markdown": "可以把 FLOSS 想成一个由许多人共同维护的公共工具箱：任何人都能取用工具、改造工具，并把改好的版本再分享出去。这个类比的关键不是零成本，而是使用、修改、分发这三项自由由社区共同保障。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-what-is-floss"
          ]
        }
      },
      {
        "id": "tb-python-is-floss",
        "moduleId": "community-sharing",
        "depth": "core",
        "kind": "note",
        "title": "教材提示：你正在使用 FLOSS",
        "markdown": "教材指出，读完本书的读者其实已经对 FLOSS 概念很熟悉，因为书中使用的 Python 本身就是一名 FLOSS 成员，而且是一款开源软件。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-02a2660bfbda114ce9f016b3",
              "blockIds": [
                "block-000159"
              ],
              "headingPath": [
                "附录：FLOSS"
              ],
