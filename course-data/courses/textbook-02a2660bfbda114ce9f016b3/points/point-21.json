              "excerptSha256": "06407de89fba45149197d95ab757a91f82a8fb680e8235f79876824a78eca17d"
            }
          ]
        }
      },
      {
        "id": "model-examples-map",
        "moduleId": "floss-landscape",
        "depth": "support",
        "kind": "explanation",
        "title": "补充：按软件栈层级记忆案例",
        "markdown": "把案例按软件栈层级串起来会更好记：内核（Linux）→ 发行版（Ubuntu）→ 桌面应用（LibreOffice、Firefox、VLC）→ 运行时与平台实现（Mono）→ 服务器（Apache）。这样就能看出，同一种开放协作模式可以出现在栈的每一层，而不只出现在操作系统。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-floss-examples"
          ]
        }
      },
      {
        "id": "tb-ubuntu-caveat",
        "moduleId": "boundary-and-misconception",
        "depth": "core",
        "kind": "warning",
        "title": "教材边界：Ubuntu 并非完全免费软件",
        "markdown": "教材在介绍 Ubuntu 时特别说明：Ubuntu 并不是完全的免费软件，它包含了一些专有的驱动程序、固件和应用程序。同一段还强调，用户可以在安装新操作系统之前，通过 CD 先行运行并充分试用 GNU/Linux。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-02a2660bfbda114ce9f016b3",
              "blockIds": [
                "block-000159"
              ],
              "headingPath": [
                "附录：FLOSS"
              ],
