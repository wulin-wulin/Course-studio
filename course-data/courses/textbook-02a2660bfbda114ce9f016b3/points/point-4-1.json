  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "revision-chronicle-analysis",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材中的版本号、日期、贡献者与授权事实，按重译动机、版本约束、译名处理、修订记录和反馈渠道重排阅读顺序，并补充怎样阅读版本记录的说明。",
      "estimatedMinutes": 12,
      "outcomes": [
        {
          "id": "explain-why-retranslate",
          "text": "说明为什么需要在 2017 年重译《A Byte of Python》，以及旧译本随时间失效的原因。"
        },
        {
          "id": "interpret-version-license",
          "text": "解释 4.0c 版本号的含义，以及 CC BY-NC-ND 授权对重译方式的约束。"
        },
        {
          "id": "trace-content-decisions",
          "text": "说明译名差异注释、保留英文源码等翻译处理原则及其对读者的意义。"
        },
        {
          "id": "read-revision-log",
          "text": "读懂修订追记的条目结构，能从时间、贡献者、章节与版本号定位一次修订。"
        }
      ],
      "misconceptions": [
        "把 4.0c 当成 Python 的版本号或简单的第 4 次修订编号。",
        "认为新译本是在沈洁元 1.20 译本上直接修改而来。",
        "把修订追记中的 4.08c 等版本号当成与本书无关的另一本书。"
