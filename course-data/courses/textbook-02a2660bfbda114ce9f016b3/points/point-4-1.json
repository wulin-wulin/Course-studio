  "id": "point-4-1",
  "title": "修订追记",
  "shortSummary": "记录译者对中文版所做的修订与说明，交代翻译版本相对于原书的变化与调整。",
  "keyTerms": [
    "译者",
    "修订记录",
    "中文版"
  ],
  "animationType": "none",
  "difficulty": "基础",
