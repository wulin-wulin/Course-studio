    "blocks": [
      {
        "id": "textbook-practice-gap",
        "moduleId": "why-practice",
        "depth": "core",
        "kind": "explanation",
        "title": "从读完教材到动手实践",
        "markdown": "读完本书并写过不少程序之后，读者往往会问：**下一步该做什么？** 教材给出的答案不是继续读更多语法，而是去解决一个具体问题——编写一款属于自己的命令行地址簿程序。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-02a2660bfbda114ce9f016b3",
