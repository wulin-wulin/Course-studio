{
  "id": "point-26",
  "title": "反馈",
  "shortSummary": "说明向作者与译者提交反馈、报告问题的渠道与方式，以及期望的反馈内容。",
  "keyTerms": [
    "反馈渠道",
    "问题报告",
    "沟通"
  ],
  "animationType": "none",
