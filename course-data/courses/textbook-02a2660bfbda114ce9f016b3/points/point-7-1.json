    "blocks": [
      {
        "id": "textbook-chapter-two-ways",
        "moduleId": "why-interactive",
        "depth": "core",
        "kind": "explanation",
        "title": "第 7 章：两种运行方式",
        "markdown": "教材第 7 章“第一步”开篇指出，运行 Python 程序有两种方法：一是使用交互式解释器提示符，二是直接运行一个源代码文件。本章先演示第一种方式，再说明如何编写、保存并运行一个程序文件。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
