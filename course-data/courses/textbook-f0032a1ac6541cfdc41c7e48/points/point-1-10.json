              "assetRefs": [
                "parts/part-0001/images/1ceb45dbf4a2945778b649107f9610f3a2b66f4f0a1abc0357265435dfa58379.jpg"
              ],
              "excerptSha256": "776c32c5244de9c2d2a7598e547f342dc4ab21ce7fb55baf460531a025e69791"
            }
          ]
        }
      },
      {
        "id": "textbook-data-mining",
        "moduleId": "analysis-chain",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：数据挖掘",
        "markdown": "数据挖掘包括分类、估计、预测、相关性分组或关联规则、聚类，以及描述和可视化；其处理对象还可扩展到文本、Web、图形图像、视频、音频等复杂数据类型。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-f0032a1ac6541cfdc41c7e48",
