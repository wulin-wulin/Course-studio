                "大数据技术"
              ],
              "lineStart": 600,
              "lineEnd": 624,
              "assetRefs": [
                "parts/part-0001/images/1ceb45dbf4a2945778b649107f9610f3a2b66f4f0a1abc0357265435dfa58379.jpg"
