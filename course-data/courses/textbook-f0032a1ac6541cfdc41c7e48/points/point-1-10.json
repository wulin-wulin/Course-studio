    "blocks": [
      {
        "id": "textbook-what-is-bigdata-tech",
        "moduleId": "intro-and-definition",
        "depth": "core",
        "kind": "definition",
        "title": "教材定义：大数据技术的含义",
        "markdown": "教材指出，大数据本身是一个**现象**，而不是一种技术。伴随着大数据的采集、传输、处理和应用而产生的相关技术，统称为大数据处理技术，简称大数据技术。\n\n它的定义是：使用非传统的工具，对大量的结构化、半结构化和非结构化数据进行处理，从而获得分析和预测结果的一系列数据处理技术。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-f0032a1ac6541cfdc41c7e48",
              "blockIds": [
                "block-000029"
              ],
              "headingPath": [
                "（版本号：2013年 12 月 13日第一版）",
                "大数据技术"
              ],
              "lineStart": 600,
              "lineEnd": 624,
              "assetRefs": [
                "parts/part-0001/images/1ceb45dbf4a2945778b649107f9610f3a2b66f4f0a1abc0357265435dfa58379.jpg"
              ],
              "excerptSha256": "776c32c5244de9c2d2a7598e547f342dc4ab21ce7fb55baf460531a025e69791"
            }
          ]
        }
      },
      {
        "id": "model-phenomenon-vs-technology",
        "moduleId": "intro-and-definition",
        "depth": "support",
        "kind": "explanation",
        "title": "补充：为什么先区分现象和技术",
        "markdown": "现象描述“发生了什么”：数据规模变大、类型变多、产生变快。技术描述“怎么办”：为了应对这些表现而采用的方法和工具。\n\n先接受大数据是现象，才能把大数据技术理解为围绕数据全流程的一组手段，而不是某个单一产品；也才能解释教材为什么用“采集、传输、处理和应用”来限定这类技术的范围。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-what-is-bigdata-tech"
          ]
        }
      },
      {
        "id": "textbook-data-acquisition",
        "moduleId": "ingest-and-store",
        "depth": "core",
        "kind": "procedure",
        "title": "教材：数据采集",
        "markdown": "数据采集由 ETL 工具承担。它先从分布的、异构的数据源（如关系数据、平面数据文件）中把数据抽取到临时中间层，再经过清洗、转换、集成，最后加载到数据仓库或数据集市中。\n\n经过这一过程的数据，成为联机分析处理和数据挖掘的基础。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-f0032a1ac6541cfdc41c7e48",
              "blockIds": [
                "block-000029"
              ],
              "headingPath": [
                "（版本号：2013年 12 月 13日第一版）",
                "大数据技术"
              ],
              "lineStart": 600,
              "lineEnd": 624,
              "assetRefs": [
                "parts/part-0001/images/1ceb45dbf4a2945778b649107f9610f3a2b66f4f0a1abc0357265435dfa58379.jpg"
              ],
              "excerptSha256": "776c32c5244de9c2d2a7598e547f342dc4ab21ce7fb55baf460531a025e69791"
            }
          ]
        }
      },
      {
        "id": "textbook-data-access",
        "moduleId": "ingest-and-store",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：数据存取",
        "markdown": "数据存取一类包括关系数据库、NoSQL 和 SQL 等，负责把数据组织起来并提供访问。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-f0032a1ac6541cfdc41c7e48",
              "blockIds": [
                "block-000029"
              ],
              "headingPath": [
                "（版本号：2013年 12 月 13日第一版）",
                "大数据技术"
              ],
              "lineStart": 600,
              "lineEnd": 624,
              "assetRefs": [
                "parts/part-0001/images/1ceb45dbf4a2945778b649107f9610f3a2b66f4f0a1abc0357265435dfa58379.jpg"
              ],
              "excerptSha256": "776c32c5244de9c2d2a7598e547f342dc4ab21ce7fb55baf460531a025e69791"
            }
          ]
        }
      },
      {
        "id": "model-ingest-then-store",
        "moduleId": "ingest-and-store",
        "depth": "support",
        "kind": "note",
        "title": "补充：采集与存取的分工",
        "markdown": "采集解决“数据从哪来、是否干净可用”，存取解决“数据放在哪里、怎样被访问”。二者相邻但目标不同：ETL 的清洗、转换、集成改变的是数据的形态和质量，存取技术决定的是数据的组织方式与访问方式。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-data-acquisition",
            "textbook-data-access"
          ]
        }
      },
      {
        "id": "textbook-infrastructure",
        "moduleId": "infrastructure-and-processing",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：基础架构",
        "markdown": "基础架构一类包括云存储、分布式文件存储等，为大规模数据的存放和计算提供底层支撑。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-f0032a1ac6541cfdc41c7e48",
