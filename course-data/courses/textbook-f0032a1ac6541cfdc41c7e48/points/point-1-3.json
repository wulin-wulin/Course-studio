{
  "id": "point-1-3",
  "title": "大数据作用",
  "shortSummary": "概括大数据在决策支持、精准服务、流程优化和新业务发现中的作用与价值实现方式。",
  "keyTerms": [
    "决策支持",
    "数据价值",
    "业务优化"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.8,
  "prerequisites": [],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-analysis-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材“价值—经济—组织”三重力框架和“追随意义而获得智慧”的结论，补充具体例子、作用边界与判断练习，使抽象论述可理解、可迁移。",
      "estimatedMinutes": 16,
      "outcomes": [
        {
          "id": "explain-human-context",
          "text": "说明大数据为什么必须放在人的背景中理解，而不能只当作技术问题。"
        },
        {
          "id": "explain-three-forces",
          "text": "概括大数据在变革价值、变革经济和变革组织三方面的作用及各自逻辑。"
        },
        {
          "id": "apply-three-forces",
          "text": "面对具体场景时判断大数据的作用属于哪一类，并说明它依靠什么“意义”实现。"
        }
      ],
      "misconceptions": [
        "把大数据的作用等同于存储和计算能力的提升，忽视价值必须由人认定并据此行动。",
        "认为数据量越大价值就越大；教材强调有意义的、被消费者认同的才实现得了价值。",
        "把“无组织的组织力量”理解为完全无序或不需要任何规则与基础设施。"
      ],
      "modules": [
        {
          "id": "beyond-technology",
          "title": "为什么不能只从技术角度看",
          "role": "introduction",
