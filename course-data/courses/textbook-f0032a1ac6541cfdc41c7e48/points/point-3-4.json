{
  "id": "point-3-4",
  "title": "为什么不用关系型数据库管理系统",
  "shortSummary": "从扩展性、数据模型和成本等角度解释关系数据库难以直接承载超大规模数据的原因。",
  "keyTerms": [
    "关系型数据库",
    "扩展瓶颈",
    "数据模型"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.8,
  "prerequisites": [],
