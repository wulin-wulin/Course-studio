  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "comparison-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "在保留教材关于磁盘寻址、B 树更新、结构化数据与线性伸缩的原意和示例的前提下，围绕选型判断重排为“问题—机理—比较—决策”，补充直觉类比与检查清单，不改变教材的数值、定义和结论。",
