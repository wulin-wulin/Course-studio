        },
        {
          "id": "namenode-metadata",
          "title": "目录节点维护的元数据",
          "role": "mechanism-explanation",
          "description": "说明目录节点存储和管理命名空间、记录修改并保存冗余因子，区分元数据与文件内容。",
          "outcomeRefs": [
            "describe-namenode-metadata"
          ],
          "order": 1
        },
        {
          "id": "operations-and-limits",
          "title": "支持的操作与教材边界",
          "role": "boundary-clarification",
          "description": "把常见文件操作归位到命名空间条目，并说明教材写作时期的功能边界。",
          "outcomeRefs": [
            "explain-namespace-tree",
            "apply-namespace-boundary"
          ],
          "order": 2
        },
        {
          "id": "check-and-bridge",
          "title": "情境检查与下一点桥接",
          "role": "formative-check",
          "description": "用情境判断题检查命名空间与元数据职责的区分，并桥接到存储原理。",
          "outcomeRefs": [
            "describe-namenode-metadata",
            "apply-namespace-boundary"
          ],
          "order": 3
        }
      ],
      "completion": {
        "outcomeRefs": [
          "explain-namespace-tree",
          "describe-namenode-metadata",
          "apply-namespace-boundary"
