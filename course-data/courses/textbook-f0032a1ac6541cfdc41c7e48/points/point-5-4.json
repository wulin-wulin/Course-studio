{
  "id": "point-5-4",
  "title": "HDFS 命名空间",
  "shortSummary": "说明 HDFS 命名空间的目录树组织方式以及名字节点对元数据的维护职责。",
  "keyTerms": [
    "命名空间",
    "元数据",
    "目录树"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.75,
  "prerequisites": [
    "point-5-2"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-boundary-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对分级文件体系、目录节点职责和当时功能边界的原意，围绕“名字在哪里记、内容在哪里放”补充直觉、情境判断和版本背景提示。",
      "estimatedMinutes": 10,
      "outcomes": [
        {
          "id": "explain-namespace-tree",
          "text": "解释 HDFS 命名空间是分级目录树，文件与目录靠路径区分。"
        },
        {
          "id": "describe-namenode-metadata",
          "text": "说明目录节点存储和管理命名空间、记录命名空间与属性的修改，并保存冗余因子。"
        },
        {
          "id": "apply-namespace-boundary",
          "text": "把新建、移动、重命名、删除等操作归位到命名空间层面，并说明教材所述的功能边界及其时间背景。"
        }
      ],
      "misconceptions": [
        "把命名空间当成文件内容或数据块的实际存放位置；命名空间记录的是名字、目录结构和属性。",
        "以为能重命名或移动文件就等于能改写文件内容；教材说明写操作只能在文件末尾追加。",
        "把教材写作时期的功能边界当成所有 Hadoop 版本的永久结论。"
      ],
      "modules": [
