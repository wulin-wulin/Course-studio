                "parts/part-0002/images/864d223c97bd9f5043b14ee63be2a1a564e8a4c0e809f4520a8aee69051de912.jpg",
                "parts/part-0002/images/b85e963c498bb29ed29fbde43dc09b182cc1d856b83a9bc78aace39474823aef.jpg"
