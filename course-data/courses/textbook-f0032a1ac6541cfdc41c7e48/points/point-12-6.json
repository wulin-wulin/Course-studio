{
  "id": "point-12-6",
  "title": "Directory",
  "shortSummary": "解释 Spanner 中目录（Directory）的概念，以及它在数据放置、迁移与均衡中的作用。",
  "keyTerms": [
    "目录",
    "数据放置",
    "迁移"
  ],
  "animationType": "directoryMigration",
