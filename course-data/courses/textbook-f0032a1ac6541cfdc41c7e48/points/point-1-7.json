      {
        "id": "textbook-relation-question",
        "moduleId": "relation-overview",
        "depth": "core",
        "kind": "explanation",
        "title": "教材引入：两者是什么关系",
        "markdown": "教材先交代背景：近几年云计算受到学术界和工业界的热捧，随后大数据出现，更是炙手可热。由此提出的问题是——大数据和云计算之间究竟是什么关系？教材没有停留在一句口号，而是分五点展开：整体关系、技术根源、异同、结合后的结果，以及商业模式与架构。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-f0032a1ac6541cfdc41c7e48",
              "blockIds": [
                "block-000021"
              ],
              "headingPath": [
                "（版本号：2013年 12 月 13日第一版）",
                "大数据与云计算"
              ],
              "lineStart": 535,
              "lineEnd": 538,
              "assetRefs": [],
              "excerptSha256": "1fe19cf7994525695ddbcb042282d08779c489c55f71c7194c9a36776d7e89a1"
