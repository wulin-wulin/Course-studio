    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "comparison-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对四类数据库的代表产品与四维评价，围绕选型任务补充数据组织方式和取舍说明，并补充情景判断练习。",
      "estimatedMinutes": 16,
      "outcomes": [
        {
          "id": "identify-nosql-categories",
          "text": "说出教材划分的四类典型 NoSQL 数据库，并各举至少一个代表产品。"
        },
        {
          "id": "compare-category-tradeoffs",
          "text": "按性能、扩展性、灵活性、复杂性和优缺点比较四类数据库的取舍。"
        },
        {
          "id": "choose-category",
          "text": "根据数据形态与访问方式，为给定场景选择较合适的 NoSQL 类型并说明依据。"
        }
      ],
      "misconceptions": [
        "把 NoSQL 等同于键值数据库，或把 MongoDB 当成键值数据库。",
        "把教材所说的“列式数据库”直接理解为用于分析型查询的列式存储。",
        "认为教材评价高的类型在所有场景都更好，忽略灵活性与复杂性上的差异。"
      ],
      "modules": [
        {
