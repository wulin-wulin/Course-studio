{
  "id": "point-10-9",
  "title": "典型的 NoSQL 数据库分类",
  "shortSummary": "按键值、列族、文档和图等类型划分 NoSQL 数据库，并说明各类的典型用途。",
  "keyTerms": [
    "键值数据库",
    "列族数据库",
    "文档数据库",
    "图数据库"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.8,
