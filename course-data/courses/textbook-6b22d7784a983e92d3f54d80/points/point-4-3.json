        }
      },
      {
        "id": "consent-as-control-point",
        "moduleId": "privacy-and-consent",
        "depth": "support",
        "kind": "note",
        "title": "补充：把同意设计进流程",
        "markdown": "模型补充：当同意服务位于数据入口处时，机构可以在采集前确认权限，而不是在分析完成后再补救。这使得隐私要求成为架构的一部分，而不是附加条款。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "consent-service"
          ]
        }
      },
      {
        "id": "open-cloud-deployment",
        "moduleId": "deployment-and-procurement",
        "depth": "core",
        "kind": "explanation",
        "title": "开放、多租户、云端的部署方式",
        "markdown": "该软件在最初两年免费提供给机构，以商业系统与开源系统相结合的形式，作为开放、多租户、基于云的方案托管。这样机构可以共享同一套高度可扩展的架构，同时保留对自己数据的完全控制；如果不想部署整套方案，也可以选择单个组件。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
