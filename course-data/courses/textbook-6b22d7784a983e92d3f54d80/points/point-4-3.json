{
  "id": "point-4-3",
  "title": "Technical infrastructure",
  "shortSummary": "介绍支撑 analytics 的数据集成、存储、分析与可视化技术基础设施及其关键要求。",
  "keyTerms": [
    "technical infrastructure",
    "data integration",
    "data warehouse",
    "visualisation"
  ],
  "animationType": "none",
  "difficulty": "中等",
