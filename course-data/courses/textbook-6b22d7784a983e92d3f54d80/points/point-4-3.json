    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "system-architecture-walkthrough",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材给出的架构组件与数据流向事实，围绕数据如何从来源走到行动重排讲解，并补充组件职责、部署取舍与检查活动。",
      "estimatedMinutes": 12,
      "outcomes": [
        {
          "id": "explain-data-flow",
          "text": "按数据流向解释学习分析技术基础设施：数据源汇入 warehouse，经 processor 分析后触发 alert 与 intervention，并通过 dashboard 和 student app 呈现。"
        },
        {
          "id": "identify-component-roles",
          "text": "识别 warehouse、processor、alert and intervention system、dashboard、student app 与 consent service 各自承担的职责。"
        },
        {
          "id": "evaluate-deployment-choices",
          "text": "结合市场分散、隐私同意与云托管条件，评价机构在选型和部署学习分析基础设施时应考虑的要求。"
        }
      ],
      "misconceptions": [
        "把学习分析基础设施等同于一组可视化仪表盘，忽略数据集成、warehouse、processor 与干预系统等前置环节。",
        "认为采用多租户云托管就必然失去对自有数据的控制；教材强调共享可扩展架构的同时机构仍可控制自己的数据。",
        "以为机构必须整体采购整套方案；教材方案允许按需选择单个组件。"
      ],
      "modules": [
