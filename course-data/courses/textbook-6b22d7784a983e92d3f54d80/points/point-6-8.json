              "assetRefs": [],
              "excerptSha256": "ba02f962c25cf9877ae93e676a364955471c03ed5e588332fc2c95da2b25d5ff"
            }
          ]
        }
      },
      {
        "id": "model-evidence-limits",
        "moduleId": "evidence-and-limits",
        "depth": "advanced",
        "kind": "warning",
        "title": "补充提醒：如何看待这组效果证据",
        "markdown": "18% 到 12% 的变化来自初期试验，教材并没有把它报告为严格控制变量的因果实验。阅读时应保留三点谨慎：其一，同期可能还有课程改革、支持人员投入等其他变化；其二，主动填报情绪的学生与不填报的学生本就可能不同；其三，质性正面评价不能替代对学习结果的独立测量。因此这组结果更适合理解为“该方案在其机构情境中值得继续投入”的证据，而不是可直接复制的预期收益。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-initial-results"
          ]
        }
      },
      {
        "id": "model-summary",
        "moduleId": "transfer-reflection",
        "depth": "support",
        "kind": "summary",
        "title": "小结：AWE 说明了什么",
        "markdown": "AWE 把分散的行为数据在夜间汇总为可排序的风险分数，再通过每日仪表盘、自动邮件、电话与个案管理转成人工支持。初期试验中 attrition 从 18% 降到 12%，学生对主动支持给出正面反馈；但这组证据来自初期试验，应理解为该机构情境中的改善信号，而不是可直接复制的预期收益。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "model-support-loop",
            "model-evidence-limits"
          ]
        }
      },
      {
        "id": "tb-community-trust",
        "moduleId": "transfer-reflection",
        "depth": "support",
        "kind": "note",
        "title": "教材案例：社区感与日常可见的支持人员",
        "markdown": "教材还指出，把 learning analytics 放进更广泛的社会媒体策略中是 Early Alert 的重要特点：通过多渠道建立社区感，并让支持人员成为日常存在而不只在危机时出现。支持人员每天使用 Facebook、Instagram 和博客与学生沟通，同时在必要时通过 AWE 进行干预。学生似乎更愿意接受干预，因为他们能叫出支持人员的名字。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
