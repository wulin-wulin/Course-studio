{
  "id": "point-4-12",
  "title": "(四)金融 AI 技术应用为关键，相关体系支撑为核心",
  "shortSummary": "强调技术应用与数据、平台、治理等支撑体系需要协同建设，单点技术难以形成持续价值。",
  "keyTerms": [
    "技术应用",
    "支撑体系",
    "协同建设",
    "持续价值"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.64,
