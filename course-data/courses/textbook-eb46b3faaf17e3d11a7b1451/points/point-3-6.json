                "parts/part-0002/images/2e078b2f781a916729a00e0f65aad3139f8bfb334069ea5e4c3ad060cad07fc5.jpg"
              ],
              "excerptSha256": "ceed7798af83e1f77282cf21c8930a9adad3d505d3e9fbb9427fccf569edceb1"
            }
          ]
        }
