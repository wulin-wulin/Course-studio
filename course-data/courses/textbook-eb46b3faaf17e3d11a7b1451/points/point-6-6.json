          ]
        },
        "config": {
          "attempts": 2,
          "scenario": "某图片缓存条目的响应头为 Cache-Control: max-age=60，当前年龄 90 秒，浏览器再次请求同一 URL。",
          "expected": "先发条件请求；返回 304 Not Modified 则复用并刷新新鲜期，返回 200 OK 则用新副本替换。"
