    "learningAssets": [
      {
        "id": "sonet-protection-check",
        "type": "formative-check",
        "anchorBlockId": "model-boundary",
        "moduleId": "protection-and-boundary",
        "depth": "core",
        "outcomeRefs": [
          "compute-transmission-rate",
          "judge-protection-and-position"
        ],
        "learningPurpose": "检查学习者能否把速率等级与保护方式选择联系起来，针对业务需求判断 UPSR 或 BLSR 的取舍。",
        "grounding": {
          "basedOnBlockIds": [
            "model-protection",
            "model-boundary",
            "tb-sdh-rate"
          ]
        },
        "config": {
          "prompt": "某运营商要在核心环上承载大量双向 TDM 专线，并希望在单处光纤断裂时快速恢复，同时尽量节省保护带宽。应优先考虑哪种方式？",
          "options": [
            "UPSR（单向通道倒换环）",
            "BLSR（双向线路倒换环）",
            "不设保护，完全依赖上层重路由",
            "仅把速率提升到 STM-64"
          ],
          "answerIndex": 1,
          "explanation": "BLSR 让双向业务共享保护通道，在核心环上兼顾恢复速度与带宽效率；UPSR 更简单但需要额外路径带宽。"
        },
        "fallback": {
          "type": "markdown",
          "markdown": "请判断：核心环承载大量双向 TDM 专线，要求单处断纤快速恢复且尽量节省保护带宽，应选 UPSR 还是 BLSR？写出你对带宽占用与配置复杂度的比较依据。"
        }
      }
    ]
  },
