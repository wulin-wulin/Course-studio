    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-and-operation",
      "adaptationLevel": "balanced",
      "editorialPolicy": "以教材对网络管理五部分、SMI 命名树和 SNMP 操作的界定为事实边界，围绕角色分工与读写/告警操作重排讲解，补充类比、对比表和判定练习。",
      "estimatedMinutes": 18,
      "outcomes": [
        {
          "id": "explain-mgmt-system",
          "text": "解释网络管理的目标以及管理进程、被管对象、代理进程、管理协议和 MIB 的分工。"
        },
        {
          "id": "map-mib-objects",
          "text": "说明 SMI 对象命名树与 mib-2、enterprise 子树如何定位 MIB 对象，并列举常见对象组。"
        },
        {
          "id": "apply-get-set-trap",
          "text": "区分 Get、Set 轮询与 Trap 通知，判断给定管理任务应使用哪类操作并说明理由。"
        }
      ],
      "misconceptions": [
        "把网络管理等同于 SNMP 协议本身：SNMP 只是管理进程与代理进程交换管理信息的协议之一，管理进程、被管对象、代理和 MIB 缺一不可。",
        "认为 Trap 可以替代轮询：Trap 只报告重要事件，常规状态采集仍依靠 Get 轮询。",
        "把本地 MIB 当作整网中心数据库：每个代理只维护本地设备相关的变量，全网 MIB 由多个本地 MIB 共同构成。"
      ],
