{
  "id": "point-1-1",
  "title": "数的表示",
  "shortSummary": "介绍计算机如何用有限位宽表示整数，以及位、字节和进制之间的对应关系。",
  "keyTerms": [
    "位",
    "字节",
    "进制",
    "位宽"
  ],
  "animationType": "none",
  "difficulty": "基础",
