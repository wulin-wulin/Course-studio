  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于逢 n 进 1、十六进制数码、进制前缀与按位分组的原始结论和数值，按“为什么需要进制—如何数—如何写—如何换算—位宽折算”的学习顺序重排，并补充少量验算示例与自检清单。",
      "estimatedMinutes": 12,
      "outcomes": [
        {
          "id": "explain-radix",
          "text": "解释 n 进制“逢 n 进 1”的规则，并说明十六进制用 a–f 表示 10–15 的原因。"
        },
        {
          "id": "convert-radix",
          "text": "识别汇编中的 0x、前导 0 与无前缀写法，并用按位分组在二进制、八进制、十六进制之间换算。"
        },
        {
          "id": "apply-radix-width",
          "text": "把二进制位宽折算为所需的十六进制位数，解释 64 位地址为何写成 16 位十六进制数。"
        }
      ],
      "misconceptions": [
        "把 0x1a 中的 0x 当成无关装饰，或把 1a 读成数字 1 后跟字母 a。",
        "认为十六进制或八进制比二进制“更精确”，忽视进制只改变书写时的分组粒度。",
        "把进制前缀与数值本身混为一谈，以为 0x1a、026 与 26 表示不同的数。"
      ],
