                "存储单元"
              ],
              "lineStart": 346,
              "lineEnd": 371,
              "assetRefs": [
                "./assets/3-endianness.png"
              ],
              "excerptSha256": "1b787e01afa788e4e39628714da0a6c23423660ecd5e908aefdf2646dafe4d18"
            }
          ]
        }
      },
      {
        "id": "model-unit-worked-example",
        "moduleId": "capacity-units",
        "depth": "support",
        "kind": "worked-example",
        "title": "16GB 与 16GiB 相差多少",
        "markdown": "以一个 16GB 的内存为例：按教材采用的十进制记法，16GB = 16 × 10⁹ B = 16,000,000,000 B；如果同一容量按二进制记法写作 16GiB，则为 16 × 2³⁰ B = 17,179,869,184 B，两者相差约 7.4%。所以看到“16GB”和“16GiB”时，不能把它们当成同一个数值。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-capacity-units"
          ]
        }
      },
      {
        "id": "textbook-addressing",
        "moduleId": "addressing-and-access",
        "depth": "core",
        "kind": "explanation",
        "title": "顺序编址与随机访问",
        "markdown": "内存和硬盘都采用顺序编址：每个存储单元（一个字节）都有一个地址，相邻存储单元的地址也相邻。内存支持**随机访问（random access）**，可以直接跳到任意地址读写，不必从 0 号地址开始查找；早期硬盘主要顺序访问，后来的闪存技术弥补了这一不足。内存可随机访问的特点，也正是 C 语言数组能以 O(1) 时间按下标取元素的基础。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
