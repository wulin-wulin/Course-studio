                "parts/part-0004/images/861de9c777076da1bb176b7ef9e41f3ab87341a7bd4b2468e2a99d8fe1484044.jpg",
                "parts/part-0004/images/af369a9e6f96df80d1f462ab2d892c23721e0d5fa4820d49b6d6b177db300ce7.jpg"
              ],
