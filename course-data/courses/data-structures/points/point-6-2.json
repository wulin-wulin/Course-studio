                "parts/part-0002/images/1667605c74394a0b3af491bf76ab3c48fed11147f52c27f18b62eb8002e1f0a7.jpg",
                "parts/part-0002/images/fe434b8e0b76dc34020930f848f470e152fe428d0be8d8ff91086b0945247542.jpg",
                "parts/part-0002/images/5a16d6a684d9752020f5bff54242e71ce621de823cec01d937baf1bf8499b72e.jpg"
              ],
              "excerptSha256": "d200634f4c8774e548412dab04f81adc2dc6e28d698e1decd4dc12f9fca65226"
