      {
        "id": "tb-encoding-algorithm",
        "moduleId": "encode-decode",
        "depth": "core",
        "kind": "procedure",
        "title": "构造赫夫曼树并求编码",
        "markdown": "求赫夫曼编码的算法先把前 $n$ 个分量初始化为叶子，其余分量初始化为空；随后从 $i=n+1$ 到 $2n-1$，每次选出 `parent` 为 0 且权值最小的两个结点，令它们成为新结点 $i$ 的左右孩子，并把新结点权值设为两者之和。构造完成后，从每个叶子出发沿 `parent` 上溯到根：若当前结点是父结点的左孩子就记 `0`，否则记 `1`，得到的比特串逆序后就是该字符的编码。教材还给出从根出发、无栈非递归遍历整棵树求编码的另一种写法。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-6ea5f19a3c614ba8cee7df46",
