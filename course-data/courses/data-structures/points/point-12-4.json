      {
        "id": "tb-vsam-overview",
        "moduleId": "m-vsam",
        "depth": "core",
        "kind": "definition",
        "title": "VSAM 的虚拟存储视角",
        "markdown": "虚拟存储存取方法 VSAM 是 Virtual Storage Access Method 的缩写。这种存取方法利用操作系统的虚拟存储器功能，给用户提供方便。对用户来说，文件只有控制区间和控制区域等逻辑存储单位，与外存储器中柱面、磁道等具体存储单位没有必然的联系；用户在存取记录时，不需要考虑该记录的当前位置是否在内存，也不需要关心何时执行对外存的读/写指令。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-6ea5f19a3c614ba8cee7df46",
              "blockIds": [
                "block-000336"
              ],
              "headingPath": [
                "计算机精品学习资料大放送",
                "VSAM 文件"
              ],
              "lineStart": 11036,
              "lineEnd": 11062,
              "assetRefs": [
                "parts/part-0004/images/694bd62a399051ed11456244281c10d9077d2bccb063c1dfeec73414dd57aaf8.jpg"
              ],
              "excerptSha256": "092185855e5d92b1176a0da465ef9dceb4fa6bf716a09738d19f3e6e9c2b8377"
