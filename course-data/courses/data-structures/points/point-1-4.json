      {
        "id": "algorithm-definition-textbook",
        "moduleId": "algorithm-definition",
        "depth": "core",
        "kind": "definition",
        "title": "教材定义：什么是算法",
        "markdown": "算法（algorithm）是对特定问题求解步骤的一种描述，它是指令的有限序列，其中每一条指令表示一个或多个操作。",
        "provenance": {
          "origin": "textbook",
          "representation": "quote",
          "sourceSpans": [
            {
              "materialId": "doc-6ea5f19a3c614ba8cee7df46",
