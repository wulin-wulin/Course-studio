                "Mathematical Induction"
              ],
              "lineStart": 239,
              "lineEnd": 294,
              "assetRefs": [],
              "excerptSha256": "81684586e40aed2064248f3318f4b7188c78a73db59d30b17b3ea31492e0981f"
            }
          ]
        }
      },
      {
        "id": "model-why-k-ge-5",
        "moduleId": "extended-strong",
        "depth": "support",
        "kind": "explanation",
        "title": "为什么起点取 5 而不是 3",
        "markdown": "这里有一个容易被忽略的细节：$k(k-2)>1$ 在 $k=3$ 时已经成立，为什么起点要取 $5$？因为归纳步骤只保证“若 $P(k)$ 成立则 $P(k+1)$ 成立”，它不保证 $P(k)$ 本身成立。$P(3)$、$P(4)$ 都是假的，链条从 $k=3$ 传不出去；只有确认 $P(5)$ 成立后，传播才有真实起点。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-extended",
            "tb-extended-example"
          ]
        }
      },
      {
        "id": "tb-strong",
        "moduleId": "extended-strong",
        "depth": "core",
        "kind": "definition",
        "title": "教材：强数学归纳法",
        "markdown": "**推论（强数学归纳法）**：设 $m$ 为整数。假设\n\n- SI1：$P(m)$ 成立；\n- SI2：若 $k \\ge m$ 为整数且 $P(m),P(m+1),\\dots,P(k)$ 全都成立，则 $P(k+1)$ 成立；\n\n那么对任意大于等于 $m$ 的整数 $n$，$P(n)$ 都成立。\n\n等价地，SI2 可表述为：若对所有满足 $m \\le i \\le k$ 的整数 $i$ 都有 $P(i)$ 成立，则 $P(k+1)$ 成立。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d79ad0eadaa0dc69704ecc53",
              "blockIds": [
                "block-000009"
              ],
              "headingPath": [
                "Methods of Proof",
                "Mathematical Induction"
              ],
              "lineStart": 239,
              "lineEnd": 294,
              "assetRefs": [],
              "excerptSha256": "81684586e40aed2064248f3318f4b7188c78a73db59d30b17b3ea31492e0981f"
            }
          ]
        }
      },
      {
        "id": "model-strong-intuition",
        "moduleId": "extended-strong",
        "depth": "core",
        "kind": "explanation",
        "title": "强归纳法为何更方便",
        "markdown": "强归纳法允许在证第 $k+1$ 项时使用**前面所有**项，而不只是第 $k$ 项，因此处理“下一项依赖多个前项”的递推结构时更自然。教材通过令 $Q(n)=P(m)\\land P(m+1)\\land\\cdots\\land P(n)$ 把它化归为扩展归纳法。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-strong"
          ]
        }
      },
      {
        "id": "tb-equivalence",
        "moduleId": "extended-strong",
        "depth": "support",
        "kind": "explanation",
        "title": "教材：三种归纳法等价",
        "markdown": "三种归纳法在逻辑上**等价**，并无真正的强弱之分。教材的论证路线是：用第一归纳法证扩展形式，再用扩展形式证强归纳形式，而强归纳形式又能直接推出扩展形式。因此这里说的“强”只是归纳假设更多、使用时更方便，并不是能证明更多命题。",
        "provenance": {
          "origin": "textbook",
