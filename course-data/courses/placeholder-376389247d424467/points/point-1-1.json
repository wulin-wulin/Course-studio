    "blocks": [
      {
        "id": "tb-logic-as-grammar",
        "moduleId": "logic-as-language",
        "depth": "core",
        "kind": "note",
        "title": "教材引入：逻辑是数学的语法",
        "markdown": "教材把学习数学比作学习新语言：名词定义像“单词”，逻辑则是把单词组成句子的“文法”。逻辑规则不该靠背诵，而应内化为直觉；逻辑也与信息科学、哲学相关，这里只讨论与数学论证有关的基本逻辑。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d79ad0eadaa0dc69704ecc53",
              "blockIds": [
                "block-000001"
              ],
              "headingPath": [
                "Basic Logic"
              ],
              "lineStart": 3,
              "lineEnd": 6,
              "assetRefs": [],
