              ],
              "lineStart": 10192,
              "lineEnd": 10305,
              "assetRefs": [
                "parts/part-0003/images/ac61391d4e08fbcbe60f91dce855903aef6071109e535bffdde93da07fe115db.jpg",
                "parts/part-0003/images/d96095f4af8501bccb782c4ff4c6a0ade9e06faf9b00633c8037458e245835df.jpg"
