                "Introduction to the loT",
                "Cognitive IoT Systems"
              ],
              "lineStart": 400,
              "lineEnd": 413,
              "assetRefs": [],
              "excerptSha256": "b0a438a229ead6c369fe02907aefeeb6927d14390ffe0b17e698187802b89430"
            }
          ]
        }
      },
      {
        "id": "model-cognitive-summary",
        "moduleId": "cognitive-and-resilience",
        "depth": "support",
        "kind": "summary",
        "title": "认知层与三层架构的关系（模型归纳）",
        "markdown": "把四个概念放在一起看：云、雾、边缘回答“处理放在哪里”，认知计算回答“处理之后能做什么”——建立数据与现实的模型（理解）、据此决策（推理）、并从数据中生成新知识（学习）。它不是第四个部署层级，而是叠加在既有架构之上的能力。\n\n弹性是认知系统相对静态架构的增量：故障发生时不是直接失效，而是检测、自愈、渐进降级；面对安全威胁时还能更换密钥与算法。这也解释了为什么雾与边缘的发展会提升认知物联网的水平：更靠近源头的数据与算力，让理解、推理与学习能在更短的回路上完成。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-cognitive"
          ]
        }
      },
      {
        "id": "model-bridge",
        "moduleId": "cognitive-and-resilience",
        "depth": "support",
        "kind": "note",
        "title": "桥接下一点：这些数据还要被管理（模型）",
        "markdown": "无论处理放在云端、雾节点还是端设备，数据都要经过产生、采集、过滤、聚合、处理、存储与安全隐私保护这一整条链路。下一点把视角从“在哪算”转到“怎么管”，系统梳理物联网数据管理的主要环节与各自目标。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-cognitive",
            "model-compare-dimensions"
          ]
        }
      }
    ],
