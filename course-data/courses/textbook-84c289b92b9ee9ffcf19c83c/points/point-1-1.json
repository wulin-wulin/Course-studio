{
  "id": "point-1-1",
  "title": "Definition of IoT",
  "shortSummary": "综合IEEE、ITU-T与CERP-IoT等定义说明物联网是嵌入感知与联网能力的物品网络，并区分被动、主动、自主的thing以及传感网与嵌入式系统。",
  "keyTerms": [
    "物联网",
    "thing",
    "RFID",
    "传感网",
    "嵌入式系统"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.95,
  "prerequisites": [],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材的定义原文、来源归属与三类 thing 的边界，围绕可判定性与迁移判断重排讲解顺序，补充定义对照、能力梯度和边界反例。",
      "estimatedMinutes": 18,
      "outcomes": [
        {
          "id": "explain-iot-definitions",
          "text": "能概括 IEEE、ITU-T 与欧盟委员会对 IoT 的核心表述，并说明它们各自的侧重点。"
        },
        {
          "id": "classify-things",
          "text": "能依据供电、感知、决策与数据流向，区分被动、主动与自主三类 thing。"
        },
        {
          "id": "distinguish-boundaries",
          "text": "能借助传感网和嵌入式系统两个对照物，判断一个系统是否落在 IoT 范围内。"
        }
      ],
      "misconceptions": [
        "把 IoT 简单等同于“能上网的设备”，忽略唯一身份、感知与对外部世界的交互。",
        "把传感网当作 IoT 的同义词，忽略传感网没有执行器、数据流单向这一边界。",
        "认为嵌入式系统天然属于 IoT，忽略嵌入式系统不必联网、也不必拥有唯一身份。"
      ],
      "modules": [
