    "blocks": [
      {
        "id": "intro-stakes",
        "moduleId": "motivation-scope",
        "depth": "core",
        "kind": "note",
        "title": "从热度到定义",
        "markdown": "教材以“物联网”一词的高关注度开场：它同时是产业界、研究者、开发者和学生热议的对象，也被非技术人群视为近乎魔法甚至对隐私的威胁。教材提到欧盟将其列为新兴技术，并给出世界市场规模与联网设备数量的长期预期。\n\n但作者随即点出一个关键事实：**“什么是 IoT”并没有一个直接、唯一的答案**。这正是本知识点要比较多个权威定义、而不是背下一句口号的原因。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-84c289b92b9ee9ffcf19c83c",
