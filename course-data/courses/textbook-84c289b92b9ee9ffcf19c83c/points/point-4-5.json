                "parts/part-0002/images/c0228492dca83e843edcbf1f785780c240b257aacfddd1829804e123b61a6f12.jpg",
                "parts/part-0002/images/998b48df45e99fa11f6c3d9b3f5a9af001f866ececa85b9f63d7428e66368d35.jpg"
