                "parts/part-0002/images/e1f959fa3e377f0885041d87de29aff4b82693b85a579a22da2be2833bafe420.jpg",
                "parts/part-0002/images/16fa9c048e1f4ff8c16ace8659620a40807153d7338fb53a9a4af380edcc6761.jpg",
                "parts/part-0002/images/3c2b2ec0c322618380c30996381c7e92c8d39a7096f324f12e96ef4b712c5232.jpg",
                "parts/part-0002/images/578b129fbb856ae31d2d2297ac35835921386dfa7c032529708cf3e76af38c1f.jpg"
