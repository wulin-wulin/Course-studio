                "parts/part-0002/images/32cef0da5c83bbd12718182afdeea9220c0c183a55d0909e129ef791d7746dbb.jpg",
                "parts/part-0002/images/61640388581f835c406c9f61039b1275ab75b44f141a6be6fce35e3cde887d7b.jpg"
              ],
