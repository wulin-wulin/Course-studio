                "parts/part-0002/images/63bf470e2a7e58aaa40ba88594b8692587ce2c09aff9d19c6e7547f795fd98fd.jpg",
                "parts/part-0003/images/7c95f5ee7f2a70d8167e7afc2eca6b46f74961c84e12991f1e600c75cd42384b.jpg"
