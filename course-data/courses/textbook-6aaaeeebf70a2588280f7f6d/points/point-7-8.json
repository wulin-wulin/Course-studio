                "parts/part-0003/images/cbe9ba2f55f9b896f244b75f0f725e66202e797e6dfccef95c77d2dc51fe8bb1.jpg",
                "parts/part-0003/images/0078e50b6d8619b134b511af56c73865fa7aadaffb60b7f1456f2e768171bb88.jpg"
