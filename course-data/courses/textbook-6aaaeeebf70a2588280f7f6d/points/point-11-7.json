              "assetRefs": [],
              "excerptSha256": "9e3659b6642d83c5fed8a3b412de356d4148958d34cda567170afb65cf971f44"
            }
          ]
        }
      },
      {
        "id": "model-platform-boundary",
        "moduleId": "research-platform",
        "depth": "advanced",
        "kind": "comparison",
        "title": "研究平台优势的边界",
        "markdown": "虚拟环境把感知与控制问题简化了，研究者可以更专注于决策、学习和交互；但这也意味着在游戏中有效的结论不一定能直接迁移到真实机器人。游戏里的障碍识别可以简化为查询现成数据，真实系统却要处理传感器噪声、执行误差和安全约束。\n\n因此，游戏适合做快速原型、算法对比与假设检验，却不能替代真实环境中的验证。判断一个游戏研究成果的价值时，要同时看它简化了什么、保留了什么。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-research-platform"
          ]
        }
      },
      {
        "id": "model-era-context",
        "moduleId": "historical-outlook",
        "depth": "support",
        "kind": "note",
        "title": "带着时代背景阅读教材判断",
        "markdown": "教材关于“现有 AI 技术水平无法与之匹配”的判断，反映的是成书阶段的技术条件。随着学习型方法和计算能力的进展，游戏中的角色控制、内容生成与测试等环节出现了新的做法，但教材指出的实时性、真实感与工程可控性之间的张力并没有消失。\n\n阅读时应把具体结论放回它的技术年代：既要看到其中仍然成立的结构性约束，也要为后来的技术变化留出空间。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-status",
            "tb-roles-purpose",
            "tb-research-platform"
          ]
        }
      },
      {
        "id": "tb-outlook",
        "moduleId": "historical-outlook",
        "depth": "core",
        "kind": "summary",
        "title": "教材的展望",
        "markdown": "教材的结论是：游戏开发中的人工智能正处于一场革命之中，必将迅速得到发展，并推动整个游戏产业的飞速发展。",
        "provenance": {
          "origin": "textbook",
