      "primaryPattern": "concept-and-scale-analysis",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材的状态空间四元组、八数码与旅行商示例以及策略分类，按“形式化—图描述—规模分析—策略与流程”的学习顺序重排，并补充规模估算、OPEN/CLOSED 记账方式和迁移练习。",
      "estimatedMinutes": 16,
      "outcomes": [
        {
          "id": "formalize-problem",
          "text": "用状态、操作和四元组 $(S,O,S_0,G)$ 把具体问题形式化为状态空间，并说明什么是一条解。"
        },
        {
          "id": "distinguish-strategies",
          "text": "区分正向与逆向搜索、盲目与启发式搜索，并说明每种策略依据什么信息。"
        },
        {
          "id": "explain-scale",
          "text": "估算状态空间规模，解释为什么完整枚举状态图常常不可行。"
        },
        {
          "id": "trace-path",
          "text": "在有向图描述的状态空间中追踪一条求解路径，并说明回溯与 OPEN/CLOSED 记账的作用。"
        }
      ],
      "misconceptions": [
        "把状态空间理解为必须显式画出整张图的静态结构，忽略实际求解往往依赖增量式搜索。",
        "把盲目搜索等同于随机乱试，忽略它按固定步骤依次或随机调用操作算子的定义。",
        "认为状态空间问题的解一定唯一，或把状态本身当成解题步骤。"
      ],
