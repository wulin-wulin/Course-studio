      {
        "id": "textbook-search-overview",
        "moduleId": "recap-framework",
        "depth": "core",
        "kind": "summary",
        "title": "教材要点一：搜索的概念",
        "markdown": "本章把搜索统一理解为在状态空间中寻找一条从初始状态到目标状态的路径。教材用四个基本问题界定搜索任务：是否一定能找到解、搜索过程是否终止、找到的解是否最优、搜索过程的时间与空间复杂度如何。\n\n按扩展方向，搜索分为正向搜索与逆向搜索；按是否利用问题信息，分为盲目搜索与启发式搜索：盲目搜索在缺少特定问题信息的条件下按固定步骤依次或随机调用操作算子，启发式搜索则利用领域知识动态确定操作算子的调用步骤，优先选择较适合的算子。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-6aaaeeebf70a2588280f7f6d",
              "blockIds": [
                "block-000033"
              ],
              "headingPath": [
                "搜索求解策略",
                "小结"
              ],
              "lineStart": 6225,
              "lineEnd": 6330,
              "assetRefs": [
                "parts/part-0002/images/14384919730b129155e461b5360de9f3ccb7e6961a4ce3eef7e6b77634c65c4a.jpg"
