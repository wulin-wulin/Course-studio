{
  "id": "point-10-3",
  "title": "故障的种类",
  "shortSummary": "分类介绍事务内部故障、系统故障、介质故障和计算机病毒四类故障的特点。",
  "keyTerms": [
    "事务故障",
    "系统故障",
    "介质故障",
    "病毒"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.82,
  "prerequisites": [
    "point-10-1"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "comparison-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材四类故障的定义与特征，补充区分维度和情境化判断练习。",
      "estimatedMinutes": 12,
      "outcomes": [
        {
          "id": "classify-faults",
          "text": "区分事务内部故障、系统故障、介质故障和计算机病毒四类故障。"
