                "确定系统配置"
              ],
              "lineStart": 8517,
              "lineEnd": 8524,
              "assetRefs": [],
              "excerptSha256": "37ec987a609c1db738b8be647c6ebc6c8c909059e5a830f6f116a8659517c135"
            }
          ]
        }
      },
      {
        "id": "tb-evaluation",
        "moduleId": "storage-design",
        "depth": "core",
        "kind": "explanation",
        "title": "评价物理结构",
        "markdown": "教材指出，物理结构评价的重点是时间和空间效率。时间效率主要指查询和更新操作的响应时间；空间效率主要指数据库占用的存储空间。如果评价结果不满足设计要求，则需要重新调整物理结构。",
        "provenance": {
          "origin": "textbook",
