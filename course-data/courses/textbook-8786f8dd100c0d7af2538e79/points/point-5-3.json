      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "围绕教材属性约束与元组约束的语法和检查机制，补充CHECK约束在现实 schema 设计中的典型用例，帮助学习者掌握用户自定义业务规则的表达能力。",
      "estimatedMinutes": 16,
      "outcomes": [
        {
          "id": "explain-user-integrity",
          "text": "解释用户定义完整性的概念与分类。"
        },
        {
          "id": "apply-check-attribute",
          "text": "使用CHECK短语定义属性上的约束条件。"
        },
        {
          "id": "apply-check-tuple",
          "text": "使用CHECK短语定义元组上的约束条件。"
        },
        {
          "id": "handle-user-violation",
          "text": "说明用户定义完整性违约时的系统处理方式。"
        }
      ],
      "misconceptions": [
        "认为CHECK约束只能用于数值范围检查，不能用于字符串模式匹配。",
        "认为元组级CHECK约束只能在表级定义，不能在列级定义。"
      ],
