              "lineEnd": 6156,
              "assetRefs": [],
              "excerptSha256": "3644214e314906f269d847295d45be961e4bb48162e3e7c2d112961142a2ca8d"
            }
          ]
        }
      },
      {
        "id": "tb-attribute-check-example",
        "moduleId": "attribute-constraint",
        "depth": "core",
        "kind": "code",
        "title": "属性约束示例",
        "markdown": "```sql\nCREATE TABLE Student\n(  Sno CHAR(9) PRIMARY KEY,\n   Sname CHAR(20) NOT NULL,\n   Ssex CHAR(2) CHECK (Ssex IN ('男', '女')),\n   Sage SMALLINT CHECK (Sage >= 15 AND Sage <= 45),\n   Sdept CHAR(20)\n);\n```\n\n上述定义中：\n- Sname不允许为空。\n- Ssex只能是'男'或'女'。\n- Sage必须在15到45之间。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-attribute-constraint"
          ]
        }
      },
      {
        "id": "tb-attribute-check-handle",
        "moduleId": "attribute-constraint",
        "depth": "core",
        "kind": "mechanism",
        "title": "属性约束的检查与违约处理",
        "markdown": "当执行INSERT或UPDATE操作时，数据库管理系统会自动检查属性上的约束条件。如果不满足约束条件，则拒绝执行该操作。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000329"
              ],
              "headingPath": [
                "数据库完整性",
                "属性上约束条件的检查和违约处理"
              ],
              "lineStart": 6157,
              "lineEnd": 6160,
              "assetRefs": [],
              "excerptSha256": "15ac6de910aa3a6396c328e6be0a13f40c2d6720c7c2028eef876f896cb5991c"
            }
          ]
        }
      },
      {
        "id": "tb-tuple-constraint",
        "moduleId": "tuple-constraint",
        "depth": "core",
        "kind": "explanation",
        "title": "元组上的约束条件",
        "markdown": "元组上的约束条件是指元组中多个属性之间的约束关系。与属性约束不同，元组约束涉及同一行中多个列的组合条件。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000330"
              ],
              "headingPath": [
                "数据库完整性",
                "元组上的约束条件"
              ],
              "lineStart": 6161,
