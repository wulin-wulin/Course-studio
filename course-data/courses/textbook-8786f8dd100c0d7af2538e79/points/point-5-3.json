    "blocks": [
      {
        "id": "tb-user-integrity-intro",
        "moduleId": "user-integrity-concept",
        "depth": "core",
        "kind": "definition",
        "title": "用户定义完整性",
        "markdown": "用户定义的完整性是针对某一具体应用的数据必须满足的语义要求。它反映了某一具体应用所涉及的数据必须满足的特定业务规则。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000325"
              ],
              "headingPath": [
                "数据库完整性",
                "用户定义的完整性"
              ],
              "lineStart": 6090,
              "lineEnd": 6093,
              "assetRefs": [],
              "excerptSha256": "95654f038f05393ceb285af7c7d06b35a99d7b11498055e2a33330896a86a0b6"
            }
          ]
        }
      },
      {
        "id": "tb-attribute-constraint",
        "moduleId": "attribute-constraint",
        "depth": "core",
        "kind": "explanation",
        "title": "属性上的约束条件",
        "markdown": "属性上的约束条件包括列值非空（NOT NULL）、列值唯一（UNIQUE）和检查列值是否满足某个条件表达式（CHECK）。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000326"
              ],
              "headingPath": [
                "数据库完整性",
                "属性上的约束条件"
              ],
              "lineStart": 6094,
              "lineEnd": 6095,
              "assetRefs": [],
              "excerptSha256": "29058aed0accba5d2363ddab74bc8514f4b6a2cbee40bff8aae75749c4531cd9"
            },
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000327"
              ],
              "headingPath": [
                "数据库完整性",
                "属性上约束条件的定义"
              ],
              "lineStart": 6096,
              "lineEnd": 6131,
              "assetRefs": [],
              "excerptSha256": "e4a0e3f300159e18139a1ec946f080efb4e73b1ae6f2253a08863d35dfc0b433"
            },
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
