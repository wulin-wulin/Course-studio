              "excerptSha256": "88bbf3d3cb96a9c1cd28374f561a2f0958773c7280220c9572aa43a35484c5de"
            }
          ]
        }
      },
      {
        "id": "model-block-anatomy",
        "moduleId": "block-structure",
        "depth": "support",
        "kind": "example",
        "title": "块结构组成示意",
        "markdown": "一个典型的PL/SQL块包含三部分：声明部分（DECLARE）用于定义变量、常量和游标；执行部分（BEGIN ... END）包含过程化SQL语句和SQL语句，是块的必需部分；异常处理部分（EXCEPTION）用于捕获并处理运行时错误。只有执行部分不可省略。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-overview"
          ]
        }
      },
      {
        "id": "tb-variables",
        "moduleId": "variables",
        "depth": "core",
        "kind": "procedure",
        "title": "变量与常量的定义",
        "markdown": "变量定义的语法为：`变量名 数据类型 [[NOT NULL] := 初值表达式]`。\n\n常量定义的语法为：`常量名 数据类型 CONSTANT := 常量表达式`。常量必须给一个值，且该值在存在期间或常量的作用域内不能改变。若试图修改，过程化SQL将返回异常。\n\n赋值语句的语法为：`变量名 := 表达式`。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
