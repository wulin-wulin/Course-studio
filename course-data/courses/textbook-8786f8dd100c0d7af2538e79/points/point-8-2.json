    "blocks": [
      {
        "id": "tb-overview",
        "moduleId": "block-structure",
        "depth": "core",
        "kind": "definition",
        "title": "过程化SQL的定义与块结构",
        "markdown": "SQL 99标准支持过程和函数的概念。Oracle的PL/SQL、Microsoft SQL Server的Transact-SQL、IBM DB2的SQL PL等都是过程化的SQL编程语言。\n\n过程化SQL是对SQL的扩展，使其增加了过程化语句功能。过程化SQL程序的基本结构是块，所有的过程化SQL程序都是由块组成的，这些块之间可以互相嵌套，每个块完成一个逻辑操作。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000499"
              ],
              "headingPath": [
                "概念结构设计",
                "过程化 SQL"
              ],
              "lineStart": 9017,
              "lineEnd": 9020,
              "assetRefs": [],
              "excerptSha256": "9c4af6b0cf4030f9f1099893cd4e9c472848e6c9708b8874cadc1a9bc13d78dd"
            },
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000500"
              ],
              "headingPath": [
                "概念结构设计",
                "过程化 SQL 的块结构"
              ],
