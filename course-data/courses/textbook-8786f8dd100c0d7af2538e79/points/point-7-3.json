      {
        "id": "tb-design-method",
        "moduleId": "er-integration",
        "depth": "core",
        "kind": "procedure",
        "title": "概念结构设计",
        "markdown": "教材介绍概念结构设计的两种策略：自顶向下（先定义全局概念结构框架，再逐步细化）和自底向上（先定义各局部应用的概念结构，再集成起来得到全局概念结构）。最常用的策略是自底向上，即先设计分E-R图，再集成为总E-R图。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
