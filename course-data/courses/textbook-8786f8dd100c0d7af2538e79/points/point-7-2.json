{
  "id": "point-7-2",
  "title": "需求分析",
  "shortSummary": "讲解需求分析的任务、方法以及数据字典的组成与作用，说明需求分析在设计中的重要性。",
  "difficulty": "中等",
  "importance": 0.82,
  "keyTerms": [
    "需求分析",
    "数据流图",
    "数据字典",
    "数据项",
    "数据结构"
  ],
  "animationType": "none",
  "prerequisites": [
    "point-7-1"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "procedure",
      "adaptationLevel": "balanced",
      "editorialPolicy": "围绕需求分析的任务—方法—产物组织教学，保留教材数据字典结构，补充数据流图与需求规约的对应关系。",
      "estimatedMinutes": 16,
      "outcomes": [
        {
          "id": "describe-tasks",
          "text": "能描述需求分析阶段的主要任务和工作内容。"
        },
        {
          "id": "use-dd",
          "text": "能解释数据字典的组成，并说明数据项、数据结构、数据流和数据存储的含义。"
        }
      ],
      "misconceptions": [
        "把需求分析简单理解为‘问用户要什么’，而忽视对业务流程和数据流程的深入理解。",
        "认为数据字典只是字段清单，忽视其对数据约束和关系的描述作用。"
      ],
      "modules": [
        {
