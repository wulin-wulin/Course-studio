    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "procedure",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对INSERT、UPDATE、DELETE语法和例句的完整覆盖，围绕操作安全补充常见错误和恢复建议，帮助学习者理解数据更新对参照完整性的潜在影响。",
      "estimatedMinutes": 20,
      "outcomes": [
        {
          "id": "use-insert",
          "text": "使用 INSERT 语句插入单个元组和子查询结果，并理解空值处理。"
        },
        {
          "id": "use-update",
          "text": "使用 UPDATE 语句修改单个或多个元组的数据，包括带子查询的条件更新。"
        },
        {
          "id": "use-delete",
          "text": "使用 DELETE 语句删除单个或多个元组，理解 DELETE 与 DROP TABLE 的区别。"
        },
        {
          "id": "explain-update-integrity",
          "text": "解释数据更新操作可能对参照完整性造成的影响。"
        }
      ],
      "misconceptions": [
        "认为 DELETE 语句会删除表的结构定义。",
        "认为 INSERT 时省略属性列会自动使用默认值而非空值。"
      ],
