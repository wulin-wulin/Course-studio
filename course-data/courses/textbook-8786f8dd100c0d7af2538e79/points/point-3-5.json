              "assetRefs": [],
              "excerptSha256": "debb7bf55444f8ae8aae1a310a6faf0c98b1b9fe0a043a246976adc4868e8300"
            }
          ]
        }
      },
      {
        "id": "tb-delete-single",
        "moduleId": "delete-data",
        "depth": "core",
        "kind": "code",
        "title": "删除单个元组",
        "markdown": "[例 3.76] 删除学号为 201215128 的学生记录：\n\n```sql\nDELETE FROM Student\nWHERE Sno='201215128';\n```",
        "provenance": {
          "origin": "textbook",
