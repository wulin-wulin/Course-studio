    "blocks": [
      {
        "id": "tb-update-intro",
        "moduleId": "insert-data",
        "depth": "core",
        "kind": "explanation",
        "title": "数据更新概述",
        "markdown": "数据更新操作有三种：向表中添加若干行数据、修改表中的数据和删除表中的若干行数据。在 SQL 中有相应的三类语句：INSERT、UPDATE 和 DELETE。对某个基本表中数据的增、删、改操作有可能会破坏参照完整性。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
