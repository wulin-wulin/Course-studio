    "blocks": [
      {
        "id": "tb-olap-intro",
        "moduleId": "mod-model",
        "depth": "core",
        "kind": "definition",
        "title": "联机分析处理技术",
        "markdown": "联机分析处理（OLAP）是一种支持复杂分析操作的技术，它使分析人员能够从多个角度、多层次地观察数据，快速发现趋势、异常和关联关系。OLAP的核心是多维数据模型。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000819"
              ],
              "headingPath": [
                "数据仓库与联机分析处理技术",
                "联机分析处理技术"
              ],
              "lineStart": 13010,
              "lineEnd": 13013,
              "assetRefs": [],
              "excerptSha256": "331a9dcc5a90273522c33f911ae17c1f77d679b2976c052bc5abccee676f6f27"
            }
          ]
        }
      },
      {
        "id": "tb-multidimensional",
        "moduleId": "mod-model",
        "depth": "core",
        "kind": "explanation",
        "title": "多维数据模型",
        "markdown": "多维数据模型以数据立方体的形式组织数据，包含维度（如时间、地区、产品）和度量（如销售额、数量）。用户可以通过选择不同维度组合，灵活地观察和分析业务指标。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000820"
              ],
              "headingPath": [
                "数据仓库与联机分析处理技术",
                "多维数据模型"
              ],
              "lineStart": 13014,
              "lineEnd": 13022,
              "assetRefs": [
                "parts/part-0005/images/2d0ac6718242c0fb5885dbda72d54ce2f6c24c0b04ff8310247de15a96508651.jpg"
              ],
              "excerptSha256": "2453f67431a6e2389d6c8912a83d8d504da6b7cca9f6848c4f13987264631b2e"
            }
          ]
        }
      },
      {
        "id": "model-cube-intuition",
        "moduleId": "mod-model",
        "depth": "support",
        "kind": "example",
        "title": "数据立方体的直觉理解",
        "markdown": "想象一个魔方，每个轴代表一个维度（时间、地区、产品类别），每个小方块的颜色深浅代表销售额高低。OLAP就是让你可以旋转这个魔方、剥开某一层、或者放大某个区域来观察细节。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-multidimensional"
          ]
        }
      },
      {
        "id": "tb-operations",
        "moduleId": "mod-operations",
        "depth": "core",
        "kind": "procedure",
        "title": "多维分析操作",
        "markdown": "OLAP提供四种基本分析操作：切片（固定某一维度的值，观察子集）、切块（固定多个维度的值，提取数据子立方体）、钻取（沿维度层次向上汇总或向下展开细节）、旋转（改变报表的维度布局，转换分析视角）。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000821"
              ],
              "headingPath": [
                "数据仓库与联机分析处理技术",
                "多维分析操作"
              ],
              "lineStart": 13023,
              "lineEnd": 13026,
              "assetRefs": [],
              "excerptSha256": "0a827d1645cab9bbd984f3813ecd48bb6a6435eaf9715bb250c9de0b551e2f37"
            }
          ]
        }
      },
      {
        "id": "model-operation-examples",
        "moduleId": "mod-operations",
        "depth": "support",
        "kind": "worked-example",
        "title": "OLAP操作示例",
        "markdown": "以销售分析为例：切片——查看2024年全年的数据；切块——查看2024年华北地区电子产品的销售；钻取——从年度汇总下钻到季度、月度细节；旋转——将行上的产品类别与列上的时间维度互换，观察不同产品在各时段的表现。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-operations"
          ]
        }
      },
      {
        "id": "tb-implementation",
        "moduleId": "mod-implementation",
        "depth": "core",
        "kind": "mechanism",
        "title": "联机分析处理的实现方式",
        "markdown": "OLAP的实现方式主要有三种：ROLAP（基于关系数据库，通过星型/雪花模型和SQL实现）、MOLAP（基于多维数组存储，预计算聚合结果）和HOLAP（混合方式，结合前两者的优势）。不同方式在存储效率、查询性能和灵活性之间存在权衡。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
