    "blocks": [
      {
        "id": "tb-struct-intro",
        "moduleId": "schema-structure",
        "depth": "core",
        "kind": "explanation",
        "title": "数据库系统的结构概述",
        "markdown": "数据库系统采用三级模式结构，目的是为了实现数据的物理独立性和逻辑独立性。在这种结构中，数据库被分为外模式、模式和内模式三个层次，并通过两级映像将它们联系起来。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
