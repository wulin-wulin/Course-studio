    "blocks": [
      {
        "id": "tb-basic-ops",
        "moduleId": "basic-operations",
        "depth": "core",
        "kind": "explanation",
        "title": "基本关系操作",
        "markdown": "关系模型中常用的关系操作包括查询（query）、插入（insert）、删除（delete）和修改（update）四种。其中查询是核心操作，因为插入、删除和修改都可以看作是先查询再变更的复合操作。查询操作又可以细分为选择、投影、连接、除、并、差、交、笛卡儿积等。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
