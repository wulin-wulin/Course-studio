{
  "id": "point-12-4",
  "title": "数据存取层",
  "shortSummary": "讲解数据存取层的功能，包括记录存取、索引管理、缓冲区管理和文件管理。",
  "keyTerms": [
    "数据存取",
    "索引",
    "缓冲区",
    "文件管理"
  ],
  "animationType": "none",
  "difficulty": "中等",
