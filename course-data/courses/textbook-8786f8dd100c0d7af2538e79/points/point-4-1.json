{
  "id": "point-4-1",
  "title": "数据库安全性概述",
  "shortSummary": "介绍数据库安全性的基本概念、不安全因素及主要安全标准，建立安全威胁认知框架。",
  "keyTerms": [
    "安全性",
    "不安全因素",
    "安全标准",
    "TCSEC"
  ],
  "animationType": "none",
  "difficulty": "基础",
