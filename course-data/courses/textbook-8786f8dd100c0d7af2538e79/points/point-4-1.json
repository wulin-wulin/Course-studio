    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对安全威胁的分类与安全标准介绍，补充现实案例帮助建立直觉，用检查题确认学习者能区分不同威胁类型。",
      "estimatedMinutes": 15,
      "outcomes": [
        {
          "id": "explain-security-concept",
          "text": "解释数据库安全性的定义与保护对象。"
        },
        {
          "id": "classify-threats",
          "text": "区分非授权存取、数据泄露和环境脆弱性三类不安全因素。"
        },
        {
          "id": "identify-standards",
          "text": "识别TCSEC/TDI安全标准的基本分级思路。"
        }
      ],
      "misconceptions": [
        "将数据库安全性等同于网络安全，忽视内部人员威胁。",
        "认为安全标准等级越高就一定越好，忽略应用成本与场景匹配。"
      ],
