      {
        "id": "tb-security-intro",
        "moduleId": "intro-and-threats",
        "depth": "core",
        "kind": "definition",
        "title": "数据库安全性定义",
        "markdown": "数据库的安全性是指保护数据库以防止不合法使用所造成的数据泄露、更改或破坏。",
        "provenance": {
          "origin": "textbook",
