    "blocks": [
      {
        "id": "tb-referential-definition",
        "moduleId": "referential-concept",
        "depth": "core",
        "kind": "definition",
        "title": "参照完整性的定义",
        "markdown": "参照完整性规则规定：若属性（或属性组）F是基本关系R的外码，它与基本关系S的主码相对应（基本关系R和S不一定是不同的关系），则对于R中每个元组在F上的值必须为：\n\n1. 或者取空值（F的每个属性值均为空值）\n2. 或者等于S中某个元组的主码值",
        "provenance": {
          "origin": "textbook",
          "representation": "quote",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
