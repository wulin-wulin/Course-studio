    "blocks": [
      {
        "id": "tb-2pl",
        "moduleId": "2pl-concept",
        "depth": "core",
        "kind": "definition",
        "title": "两段锁协议",
        "markdown": "所谓两段锁协议是指所有事务必须分两个阶段对数据项加锁和解锁：\n\n1. **扩展阶段**：在对任何数据进行读、写操作之前，首先要申请并获得对该数据的封锁；\n\n2. **收缩阶段**：在释放一个封锁之后，事务不再申请和获得任何其他封锁。\n\n事务遵守两段锁协议是可串行化调度的充分条件。即若并发事务都遵守两段锁协议，则对这些事务的任何并发调度策略都是可串行化的。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
