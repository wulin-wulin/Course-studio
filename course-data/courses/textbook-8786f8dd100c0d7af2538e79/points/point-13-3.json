    "blocks": [
      {
        "id": "textbook-features-intro",
        "moduleId": "model-evolution",
        "depth": "core",
        "kind": "definition",
        "title": "发展特点概述",
        "markdown": "教材从数据模型的发展、数据库技术与相关技术的结合、以及面向应用领域的数据库新技术三个方面，系统分析了数据库系统的发展特点。这些特点共同表明：数据库技术始终围绕'更高效地管理数据、更灵活地表达数据、更广泛地应用数据'三条主线演进。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000730"
              ],
              "headingPath": [
                "新技术篇",
                "数据库系统发展的特点"
              ],
              "lineStart": 11870,
              "lineEnd": 11873,
              "assetRefs": [],
              "excerptSha256": "5149d27c0854ac43e3c53529513b2c926bf56f6d5d456a783f9f06ef9d2d0799"
            }
          ]
        }
      },
      {
        "id": "textbook-model-dev",
        "moduleId": "model-evolution",
        "depth": "core",
        "kind": "explanation",
        "title": "数据模型的发展",
        "markdown": "教材指出，数据模型的发展经历了从格式化模型（层次、网状）到关系模型，再到面向对象模型、对象关系模型，以及XML数据模型和RDF数据模型的演变。每一次演变都是为了更好地表达现实世界的复杂性和多样性：关系模型简化了数据结构，提高了独立性；面向对象模型增强了表达复杂语义的能力；XML和RDF则支持半结构化和语义网数据。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
