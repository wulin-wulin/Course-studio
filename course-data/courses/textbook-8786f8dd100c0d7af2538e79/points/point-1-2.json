              "excerptSha256": "345fa3605c1c613cd651754f09b220b669409195b1fce6364297c1e71d7f83c3"
            }
          ]
        }
      },
      {
        "id": "tb-concept-model",
        "moduleId": "concept-model-and-er",
        "depth": "core",
        "kind": "definition",
        "title": "概念模型",
        "markdown": "概念模型是现实世界到机器世界的一个中间层次，用于信息世界的建模。它是现实世界到信息世界的第一层抽象，既是数据库设计人员进行设计的工具，也是设计人员与用户之间交流的语言。一个好的概念模型应具有较强的语义表达能力，能够方便、直接地表达应用中的各种语义知识，同时又应简单、清晰、易于用户理解。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
