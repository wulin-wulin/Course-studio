{
  "id": "point-6-1",
  "title": "问题的提出",
  "shortSummary": "通过具体关系模式实例分析数据冗余、更新异常、插入异常和删除异常的产生原因。",
  "difficulty": "中等",
  "importance": 0.88,
  "keyTerms": [
    "数据冗余",
    "更新异常",
    "插入异常",
    "删除异常"
  ],
  "animationType": "none",
  "prerequisites": [
    "point-2-1",
    "point-3-3"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "以教材关系实例为锚点，围绕四种异常的现象—原因—后果组织教学，补充可迁移的判断方法。",
      "estimatedMinutes": 15,
      "outcomes": [
        {
          "id": "identify-anomalies",
          "text": "能从关系模式实例中识别数据冗余、更新异常、插入异常和删除异常。"
        },
        {
          "id": "explain-causes",
          "text": "能解释这四种异常与属性间依赖关系不当之间的因果联系。"
        }
      ],
      "misconceptions": [
        "认为只要数据量大就会产生冗余，而忽视属性间函数依赖不当才是根源。",
        "把插入异常简单理解为‘插不进去’，而未意识到缺失关键信息时无法保持元组完整性。"
      ],
      "modules": [
        {
