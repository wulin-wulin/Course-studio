          "order": 0
        },
        {
          "id": "organization-detail",
          "title": "三种组织方式",
          "role": "worked-example",
          "outcomeRefs": [
            "explain-physical-organization",
            "compare-logical-physical"
          ],
          "order": 1
        },
        {
          "id": "check",
          "title": "映射关系判断",
          "role": "application",
          "outcomeRefs": [
