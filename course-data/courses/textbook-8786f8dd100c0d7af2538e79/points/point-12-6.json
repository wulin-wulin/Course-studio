{
  "id": "point-12-6",
  "title": "数据库的物理组织",
  "shortSummary": "讲解数据库在存储设备上的物理组织方式，包括文件结构、记录组织和索引组织。",
  "keyTerms": [
    "物理组织",
    "文件结构",
    "记录组织",
    "索引组织"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.75,
  "prerequisites": [
    "point-7-5",
    "point-12-4"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "围绕教材物理组织方式，补充逻辑-物理映射直觉，帮助学习者建立存储层面的认知。",
      "estimatedMinutes": 12,
      "outcomes": [
        {
          "id": "explain-physical-organization",
          "text": "描述数据库物理组织的三个层面：数据字典、数据联系和存取路径。"
        },
        {
          "id": "compare-logical-physical",
          "text": "区分逻辑数据模型与物理存储组织之间的映射关系。"
        }
      ],
      "misconceptions": [
        "认为逻辑表在磁盘上也是按行顺序连续存储的，忽视物理存储的复杂性。"
      ],
