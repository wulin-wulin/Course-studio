                "parts/part-0004/images/92282c08b9d5e576f2c03e3c8e222b054f924b30f6cd80ca2a2669bf6b0f06ee.jpg"
              ],
              "excerptSha256": "e2ea5f64378af31c679ca2fdf7195e3baa0bfd18232f3eeb05440a1580b744be"
