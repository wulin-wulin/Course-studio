                "parts/part-0005/images/f5be204bdef6485c6f2bfd28b3d66de64cc4f974a321a8c72de2359e316b7b53.jpg",
                "parts/part-0005/images/d7aac604aadddb182b6f2db223fa67fb1a4af69ce260f30daa051a5067c4dace.jpg"
              ],
              "excerptSha256": "e4229b5e1c509fcf22ee00e029e4075d1eef60d31c04ed102326ed0432a9dbde"
            }
          ]
