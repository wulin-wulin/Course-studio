                "parts/part-0005/images/61d43224a3ce9925683ac41d6c1c2b865d59ad7256e5f32aae382b2ab9bda4f9.jpg"
              ],
              "excerptSha256": "2751f2b4814094367043c4b5b8bdc168d16cfa92dc061039a132fa2aa09f5e2f"
            }
