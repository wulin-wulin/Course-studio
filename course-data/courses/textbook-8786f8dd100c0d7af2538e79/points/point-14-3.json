      "adaptationLevel": "balanced",
      "editorialPolicy": "围绕教材对NoSQL、NewSQL和MapReduce的介绍，补充技术选型维度与适用情境对比。",
      "estimatedMinutes": 18,
      "outcomes": [
        {
          "id": "compare-big-data-systems",
          "text": "比较NoSQL、NewSQL和MapReduce三类大数据管理系统的架构特点与适用场景。"
        },
        {
          "id": "select-system",
          "text": "根据应用类型（操作型/分析型）选择合适的大数据技术方案。"
        }
      ],
      "misconceptions": [
        "认为NoSQL可以完全替代关系数据库。",
        "将Hadoop视为万能的大数据解决方案，忽视其实时性不足的问题。"
      ],
