{
  "id": "point-14-3",
  "title": "大数据管理系统",
  "shortSummary": "讲解NoSQL数据库、Hadoop生态系统和NewSQL数据库的基本架构与特点。",
  "keyTerms": [
    "NoSQL",
    "Hadoop",
    "HDFS",
    "MapReduce",
    "NewSQL"
  ],
  "animationType": "none",
  "difficulty": "中等",
