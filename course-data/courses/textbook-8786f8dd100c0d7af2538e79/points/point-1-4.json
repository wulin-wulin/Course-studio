    "blocks": [
      {
        "id": "tb-overview",
        "moduleId": "hardware-software",
        "depth": "core",
        "kind": "explanation",
        "title": "数据库系统的组成概述",
        "markdown": "数据库系统一般由硬件平台及数据库、软件、人员和数据四个部分组成。硬件平台需要有足够大的内存、足够大的磁盘或磁盘阵列等外部设备，以及较高的通道能力。软件包括数据库管理系统、操作系统、应用开发工具和应用系统。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
