        }
      },
      {
        "id": "model-software-detail",
        "moduleId": "hardware-software",
        "depth": "support",
        "kind": "note",
        "title": "软件层次补充",
        "markdown": "在软件层次中，操作系统是DBMS的基础，提供底层资源管理；应用开发工具（如PowerBuilder、Eclipse）帮助开发者快速构建数据库应用；最终的应用系统则面向终端用户提供具体业务功能。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-overview"
          ]
        }
      },
      {
        "id": "tb-personnel",
        "moduleId": "personnel",
        "depth": "core",
        "kind": "definition",
        "title": "人员组成与DBA职责",
        "markdown": "数据库系统的人员包括数据库管理员（DBA）、系统分析员和数据库设计人员、应用程序员和最终用户。其中，数据库管理员负责全面管理和控制数据库系统，主要职责包括：决定数据库中的信息内容和结构、决定数据库的存储结构和存取策略、定义数据的安全性要求和完整性约束条件、监控数据库的使用和运行、数据库的改进和重组重构。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000092"
              ],
              "headingPath": [
                "基础篇",
                "人员"
              ],
              "lineStart": 1195,
