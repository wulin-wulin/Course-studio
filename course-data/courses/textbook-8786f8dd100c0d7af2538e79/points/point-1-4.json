        }
      },
      {
        "id": "model-roles-compare",
        "moduleId": "personnel",
        "depth": "support",
        "kind": "comparison",
        "title": "人员角色对比",
        "markdown": "系统分析员负责需求分析和系统设计，数据库设计人员负责具体的数据库结构设计，应用程序员负责编写应用代码，最终用户通过应用系统使用数据库。DBA则贯穿数据库全生命周期，是数据库系统的核心管理者。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-personnel"
          ]
        }
      },
      {
        "id": "tb-other-roles",
        "moduleId": "personnel",
        "depth": "core",
        "kind": "explanation",
        "title": "其他人员角色",
        "markdown": "系统分析员和数据库设计人员负责数据库系统的需求分析和结构设计工作。应用程序员负责设计和编写应用系统的程序模块，并进行调试和安装。用户分为偶然用户、简单用户和复杂用户，他们通过应用系统或查询工具与数据库交互。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
