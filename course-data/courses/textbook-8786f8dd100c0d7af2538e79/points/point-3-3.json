              "lineEnd": 3047,
              "assetRefs": [],
              "excerptSha256": "1eaf950bbd412e7a2d12c888dce5d96ff7b2b37e669f21b4fddcaef6cefa2643"
            }
          ]
        }
      },
      {
        "id": "model-datatype-note",
        "moduleId": "table-definition",
        "depth": "support",
        "kind": "note",
        "title": "数据类型选择建议",
        "markdown": "例如，对于年龄（Sage）属性，虽然可以用 CHAR(3)，但考虑到要做算术运算（如求平均年龄），应采用整数类型。又因为在百岁左右，选用 SMALLINT 即可满足需求。选择数据类型时应在满足业务需求和节省存储空间之间取得平衡。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-data-types"
          ]
        }
