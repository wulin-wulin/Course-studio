                "block-000623"
              ],
              "headingPath": [
                "数据库恢复技术",
                "数据库恢复概述"
              ],
              "lineStart": 10308,
              "lineEnd": 10311,
              "assetRefs": [],
              "excerptSha256": "30eed47ff0f9f73307a465c911864ecd7a4aea1bab29ac702dbbdaf46352a914"
            }
          ]
        }
      },
      {
        "id": "md-redundancy-intuition",
        "moduleId": "redundancy-principle",
        "depth": "support",
        "kind": "example",
        "title": "冗余原理的直觉解释",
        "markdown": "可以把数据库恢复理解为给数据库做“保险”：\n\n- 数据转储相当于定期拍一张数据库的“快照”（照片），记录某一时刻的完整状态；\n\n- 日志文件则像一本“流水账”，记录了快照之后发生的每一笔变更。\n\n当数据库损坏时，先用最近的快照恢复到某一基准点，再根据流水账把之后的变更重新执行一遍，就能恢复到故障前的状态。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-recovery-overview"
          ]
        }
      },
      {
        "id": "md-recovery-framework",
        "moduleId": "framework-check",
        "depth": "core",
        "kind": "summary",
        "title": "恢复技术整体框架",
        "markdown": "数据库恢复技术围绕以下逻辑展开：\n\n1. **预防与准备**：通过数据转储和登记日志文件建立冗余；\n\n2. **故障识别**：区分事务故障、系统故障和介质故障；\n\n3. **恢复执行**：针对不同故障类型采用不同的恢复策略（UNDO/REDO）；\n\n4. **优化手段**：引入检查点技术减少恢复工作量。\n\n后续各知识点将沿着这一框架逐步展开。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-recovery-overview"
          ]
        }
      }
    ],
