          ],
          "order": 2
        }
      ],
      "completion": {
        "outcomeRefs": [
          "explain-entity-integrity",
          "explain-referential-integrity",
          "apply-integrity-design"
        ],
        "method": "为给定业务场景设计表结构并标注三类完整性约束。",
        "successCriteria": [
          "主码选择合理",
          "外码关系正确",
          "用户定义完整性不少于两项"
        ]
      }
    },
    "blocks": [
      {
        "id": "tb-integrity-intro",
        "moduleId": "entity-integrity",
        "depth": "core",
        "kind": "explanation",
        "title": "关系完整性概述",
        "markdown": "关系模型的完整性规则是对关系的某种约束条件，主要包括实体完整性、参照完整性和用户定义的完整性三类。这些完整性约束由关系数据库管理系统自动支持，确保数据库中的数据始终保持有效和一致。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000112"
              ],
              "headingPath": [
                "基础篇",
                "关系的完整性"
              ],
              "lineStart": 1595,
              "lineEnd": 1600,
              "assetRefs": [],
              "excerptSha256": "da264b8bbed77eae8b53fcc8c58cdfc2780ed8def998041ac6f4f7acdbf9ddd7"
            }
          ]
        }
      },
      {
        "id": "tb-entity",
        "moduleId": "entity-integrity",
        "depth": "core",
        "kind": "definition",
        "title": "实体完整性规则",
        "markdown": "实体完整性规则规定：若属性A是基本关系R的主属性，则A不能取空值。主码作为元组的唯一标识，如果主属性为空，则无法区分和识别该元组，违背了实体的可区分性。实体完整性保证了每个实体都有唯一的标识。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000113"
              ],
              "headingPath": [
                "基础篇",
                "实体完整性"
              ],
              "lineStart": 1601,
              "lineEnd": 1620,
              "assetRefs": [],
              "excerptSha256": "d4fcd4f945cd3a459963d54ffef60a9f59566d65404735de4c1041e5a7637709"
            }
          ]
        }
      },
      {
        "id": "model-entity-example",
        "moduleId": "entity-integrity",
        "depth": "support",
        "kind": "example",
        "title": "实体完整性实例",
        "markdown": "在学生表中，若学号为主码，则插入一条学号为NULL的记录是非法的，因为无法确定这条记录对应哪位学生。即使其他属性（如姓名、年龄）都填写完整，缺少学号也会导致该元组无法被唯一标识和引用。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-entity"
          ]
        }
      },
      {
        "id": "tb-referential",
        "moduleId": "referential-integrity",
        "depth": "core",
        "kind": "definition",
        "title": "参照完整性规则",
        "markdown": "参照完整性规则规定：若属性（或属性组）F是基本关系R的外码，它与基本关系S的主码K相对应（R和S可以是同一关系），则对于R中每个元组在F上的值必须为：或者取空值（F的每个属性值均为空值），或者等于S中某个元组的主码值。参照完整性维护了关系之间的联系，确保引用总是指向存在的实体。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000114"
              ],
              "headingPath": [
                "基础篇",
                "参照完整性"
              ],
              "lineStart": 1621,
              "lineEnd": 1689,
              "assetRefs": [
                "parts/part-0001/images/939c98e98c9de76012cf9be4f94996d4567170d176d8f172b4eed599ca53a8bf.jpg"
              ],
              "excerptSha256": "bbfdb2441d36c36dc971a5075c03c01908ffa57c587cd58aded9349f6b95a6d0"
            }
          ]
        }
      },
      {
        "id": "model-referential-example",
        "moduleId": "referential-integrity",
        "depth": "support",
        "kind": "example",
        "title": "参照完整性实例",
        "markdown": "在选课表中，学号是学生表的外码。如果插入一条学号为2023001的选课记录，而学生表中不存在该学号，则违反了参照完整性。同样，如果删除学生表中学号为2023001的元组，而选课表中仍存在相关记录，也会违反参照完整性，除非配置了级联删除策略。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-referential"
          ]
        }
      },
      {
        "id": "tb-user-defined",
        "moduleId": "user-integrity",
        "depth": "core",
        "kind": "explanation",
        "title": "用户定义的完整性",
        "markdown": "用户定义的完整性是针对某一具体关系数据库的约束条件，由用户根据应用环境的要求定义。例如，可以规定学生成绩必须在0到100之间，职工的工龄不能超过实际年龄，部门的预算不能为负数等。这些约束反映了具体业务的语义要求，是实体完整性和参照完整性之外的重要补充。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000115"
              ],
              "headingPath": [
                "基础篇",
                "用户定义的完整性"
              ],
              "lineStart": 1690,
              "lineEnd": 1697,
              "assetRefs": [],
              "excerptSha256": "f7e319e4819b3543d50ae30fddb7d0b709440766e9f7b3be92be75c617872586"
            }
          ]
        }
      },
      {
        "id": "model-design-exercise",
        "moduleId": "user-integrity",
        "depth": "core",
        "kind": "exercise",
        "title": "完整性设计练习",
        "markdown": "为图书馆管理系统设计图书借阅表，要求：\n\n1. 标识主码并说明实体完整性如何保证。\n2. 标识外码并说明参照完整性涉及哪些表。\n3. 列出至少两条用户定义的完整性约束。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-entity",
            "tb-referential",
            "tb-user-defined"
          ]
        }
      }
    ],
    "learningAssets": [
      {
        "id": "integrity-design-check",
        "type": "formative-check",
        "anchorBlockId": "model-design-exercise",
        "moduleId": "user-integrity",
        "depth": "core",
        "outcomeRefs": [
          "apply-integrity-design"
        ],
        "learningPurpose": "检查学习者能否在表设计中综合运用三类完整性约束。",
        "grounding": {
          "basedOnBlockIds": [
            "tb-entity",
            "tb-referential",
            "tb-user-defined"
          ]
        },
        "config": {
          "attempts": 2
        },
        "fallback": {
          "type": "markdown",
          "markdown": "1. 主码可选借阅编号，实体完整性要求借阅编号非空且不重复。\n2. 外码包括读者证号（引用读者表）和图书编号（引用图书表）。\n3. 用户定义完整性：借阅日期不得晚于应还日期；续借次数不超过2次。"
        }
      }
    ]
  },
