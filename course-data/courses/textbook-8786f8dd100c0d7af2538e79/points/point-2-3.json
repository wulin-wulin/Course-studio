{
  "id": "point-2-3",
  "title": "关系的完整性",
  "shortSummary": "阐述实体完整性、参照完整性和用户定义完整性三类约束的定义与作用。",
  "keyTerms": [
    "实体完整性",
    "参照完整性",
    "用户定义完整性",
    "主码",
    "外码"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.88,
  "prerequisites": [
    "point-2-1"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "围绕教材三类完整性定义，补充违约实例和SQL映射，帮助学习者将理论约束与实际表设计联系起来。",
      "estimatedMinutes": 16,
      "outcomes": [
        {
          "id": "explain-entity-integrity",
          "text": "解释实体完整性的定义、作用及与主码的关系。"
        },
        {
          "id": "explain-referential-integrity",
          "text": "解释参照完整性的定义、作用及与外码的关系。"
        },
        {
          "id": "apply-integrity-design",
          "text": "在表设计中正确标识主码、外码并判断需要的用户定义完整性约束。"
        }
      ],
      "misconceptions": [
        "认为实体完整性仅要求主码不重复，忽视非空约束。",
        "认为参照完整性只在插入数据时检查，忽视删除和修改时的级联影响。"
      ],
      "modules": [
        {
