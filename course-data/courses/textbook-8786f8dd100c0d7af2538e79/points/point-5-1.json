      {
        "id": "tb-entity-definition",
        "moduleId": "entity-integrity-concept",
        "depth": "core",
        "kind": "definition",
        "title": "实体完整性的定义",
        "markdown": "实体完整性规则规定：若属性（指一个或一组属性）A是基本关系R的主属性，则A不能取空值。所谓空值就是不知道或无意义的值。",
        "provenance": {
          "origin": "textbook",
          "representation": "quote",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000317"
              ],
              "headingPath": [
                "数据库完整性",
                "实体完整性"
              ],
              "lineStart": 5936,
              "lineEnd": 5937,
              "assetRefs": [],
              "excerptSha256": "b3a909e846b3d30e18f5169c2d45408badb381f3e4f0126b4843ef469b651290"
            },
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000318"
              ],
              "headingPath": [
                "数据库完整性",
                "定义实体完整性"
              ],
              "lineStart": 5938,
              "lineEnd": 5972,
