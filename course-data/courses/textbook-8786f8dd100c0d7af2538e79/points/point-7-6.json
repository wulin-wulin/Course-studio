{
  "id": "point-7-6",
  "title": "数据库的实施和维护",
  "shortSummary": "介绍数据库实施阶段的数据载入、试运行以及运行维护阶段的转储恢复和安全完整性控制。",
  "difficulty": "中等",
  "importance": 0.75,
  "keyTerms": [
    "数据载入",
    "试运行",
    "转储",
    "恢复",
    "维护"
  ],
