    "blocks": [
      {
        "id": "tb-naming-intro",
        "moduleId": "naming-constraint",
        "depth": "core",
        "kind": "definition",
        "title": "完整性约束命名子句",
        "markdown": "SQL允许使用CONSTRAINT短语为完整性约束指定一个名字。命名约束的好处在于：当需要删除或修改约束时，可以通过名字精确定位，而不必依赖数据库自动生成的内部标识。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
