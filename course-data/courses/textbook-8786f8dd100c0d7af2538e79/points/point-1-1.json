              "lineEnd": 640,
              "assetRefs": [],
              "excerptSha256": "71d3fd80cb95cc2916c22aa52222c3a980673f08f839aa877037e15335984ecb"
            },
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
