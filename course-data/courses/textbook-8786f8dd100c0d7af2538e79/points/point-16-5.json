              "assetRefs": [],
              "excerptSha256": "38b505d793fb3f65163b8b81b5229d2152ae1643ab17f337f38e0376192f6bb8"
            }
          ]
        }
      },
      {
        "id": "model-framework",
        "moduleId": "mod-summary",
        "depth": "support",
        "kind": "note",
        "title": "章节知识框架",
        "markdown": "本章知识结构：基础层（数据仓库概念、特征、ETL、体系结构）→分析层（OLAP多维模型与操作）→发现层（数据挖掘概念与任务）→演进层（大数据时代的新型数据仓库）。学习时应理解各层之间的关系：数据仓库提供数据基础，OLAP提供多维分析能力，数据挖掘提供自动发现能力。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-summary"
          ]
        }
      },
