              "assetRefs": [],
              "excerptSha256": "ea3f3079309b83dc0dd6f0113232cf7312207493b68d96925669a05bac09d88f"
            }
          ]
        }
      },
      {
        "id": "model-optimization-framework",
        "moduleId": "chapter-summary",
        "depth": "support",
        "kind": "figure",
        "title": "查询优化整体框架",
        "markdown": "可以把查询优化理解为一个双层决策过程：上层是代数优化，负责改写关系代数表达式（如选择下推、投影下推、连接重排）；下层是物理优化，负责为每个操作节点选择具体算法和存取路径（如全表扫描vs索引扫描、嵌套循环vs排序-合并）。两层优化相互协作，共同生成高效的查询执行计划。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-summary"
          ]
        }
