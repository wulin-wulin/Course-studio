{
  "id": "point-14-1",
  "title": "大数据概述",
  "shortSummary": "介绍大数据的基本概念、5V特征以及大数据与传统数据管理的区别。",
  "keyTerms": [
    "大数据",
    "5V",
    "Volume",
    "Velocity",
    "Variety",
    "Value",
    "Veracity"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.82,
  "prerequisites": [
    "point-1-1",
    "point-12-1"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对大数据概念与5V特征的界定，围绕区分能力补充对比案例和情境判断练习。",
      "estimatedMinutes": 15,
      "outcomes": [
        {
          "id": "explain-big-data-concept",
          "text": "解释大数据的基本概念与5V特征的含义。"
        },
        {
          "id": "distinguish-big-data",
          "text": "区分大数据与传统数据管理在规模、类型和处理方式上的主要差异。"
        }
      ],
      "misconceptions": [
        "将大数据简单等同于数据量大，忽视多样性、速度、价值和真实性等维度。",
        "认为传统关系数据库可以完全胜任大数据场景的所有需求。"
      ],
      "modules": [
        {
          "id": "mod-intro",
          "title": "章节导入与概念引入",
          "role": "conceptual-anchor",
          "outcomeRefs": [
            "explain-big-data-concept"
          ],
          "order": 0
        },
        {
          "id": "mod-characteristics",
          "title": "5V特征详解",
          "role": "worked-example",
          "outcomeRefs": [
            "explain-big-data-concept",
            "distinguish-big-data"
          ],
          "order": 1
        },
        {
          "id": "mod-check",
          "title": "达成检查与迁移",
