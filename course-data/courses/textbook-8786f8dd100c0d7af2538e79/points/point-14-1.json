                "block-000758"
              ],
              "headingPath": [
                "大数据管理",
                "价值"
              ],
              "lineStart": 12233,
              "lineEnd": 12250,
              "assetRefs": [],
              "excerptSha256": "fb30e9e43328d68f805ad6660cfd7bcc7b34474cf1fe0f1b8e0a372d592de596"
            }
          ]
        }
      },
      {
        "id": "model-comparison",
        "moduleId": "mod-characteristics",
        "depth": "support",
        "kind": "comparison",
        "title": "大数据与传统数据管理的对比",
        "markdown": "传统关系数据库擅长处理结构化、规模可控、事务性强的数据；而大数据场景则要求面对海量、多源、高速的数据流。前者强调ACID一致性和复杂查询，后者更侧重可扩展性、容错性和高吞吐处理。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-features-overview",
            "tb-volume",
            "tb-variety",
            "tb-velocity",
            "tb-value"
          ]
        }
      }
