    "blocks": [
      {
        "id": "tb-new-dw-intro",
        "moduleId": "mod-challenges",
        "depth": "core",
        "kind": "explanation",
        "title": "大数据时代的新型数据仓库",
        "markdown": "随着数据量急剧增长、数据类型日益多样、决策分析复杂度提升以及底层硬件环境变化，传统数据仓库在扩展性、灵活性和成本方面面临严峻挑战，催生了多种新型数据仓库架构。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-8786f8dd100c0d7af2538e79",
              "blockIds": [
                "block-000828"
              ],
              "headingPath": [
                "数据仓库与联机分析处理技术",
                "大数据时代的新型数据仓库"
              ],
              "lineStart": 13107,
              "lineEnd": 13110,
              "assetRefs": [],
              "excerptSha256": "353056422ff5eb464d9e72d115c2b0e9bf0bafaa56703b3b40e74d6ed3d98d51"
            }
          ]
        }
      },
      {
        "id": "tb-requirements",
        "moduleId": "mod-challenges",
        "depth": "core",
        "kind": "explanation",
        "title": "系统需求的变化",
        "markdown": "大数据时代对数据仓库系统提出了四项新需求：数据量急剧增长要求存储和计算能力弹性扩展；数据类型多样要求支持结构化、半结构化和非结构化数据的统一分析；决策分析复杂要求支持机器学习、图计算等高级分析；底层硬件环境变化要求充分利用分布式和云基础设施。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
