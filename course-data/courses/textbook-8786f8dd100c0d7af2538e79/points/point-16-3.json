                "parts/part-0005/images/80a9b07c94e27632a8ef15e304d308f4bc7406ae79a8021d4b52c57efa787dc3.jpg"
              ],
              "excerptSha256": "99030bdce6330d815316e1e2c125e1a1c3b1b56edf1015030850f52d93e4c9e8"
            }
          ]
        }
      },
      {
        "id": "model-task-scenarios",
        "moduleId": "mod-tasks",
        "depth": "support",
        "kind": "worked-example",
        "title": "挖掘任务与场景对应",
        "markdown": "分类——根据历史交易记录预测信用卡申请是否欺诈；聚类——将客户按消费行为划分为不同群体；关联规则——发现超市购物篮中商品之间的搭配关系；时序分析——预测股票走势或设备故障时间。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-functions"
          ]
        }
      }
    ]
