            "audit-tool-claims"
          ],
          "order": 0
        },
        {
          "id": "case-tools",
          "title": "CASE 工具的能力与副作用",
          "role": "worked-example",
          "description": "分析绘图与代码细化工具能做什么、不能做什么，以及何时反而阻碍沟通。",
          "outcomeRefs": [
            "explain-tool-limit",
            "audit-tool-claims"
          ],
          "order": 1
        },
        {
          "id": "formal-precision",
          "title": "形式化的精确性与可读性张力",
          "role": "analysis",
          "description": "解释精确记号为何可能让预期读者无法理解，以及缓解方式。",
