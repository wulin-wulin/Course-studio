{
  "id": "point-6-6",
  "title": "Implications for Methods and Tools",
  "shortSummary": "讨论大型系统研究对方法与工具提出的要求，以及工具无法替代的工程判断。",
  "keyTerms": [
    "methods",
    "tools",
    "工具边界",
    "工程判断"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.82,
  "prerequisites": [],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "comparison-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于方法与工具边界的判断，围绕三类关键限制补充统一比较维度、决策清单与迁移练习。",
      "estimatedMinutes": 15,
      "outcomes": [
        {
          "id": "explain-tool-limit",
          "text": "解释方法与工具为何必须先针对领域知识、需求变更与沟通三类限制，才可能对大型项目产生实质作用。"
        },
        {
          "id": "audit-tool-claims",
          "text": "用统一维度审计 CASE 工具或 formal methods 的主张，指出其能力范围与可能的副作用。"
        },
        {
          "id": "apply-selective-formal-methods",
          "text": "在安全关键系统中划定 formal methods 的选择性应用范围并说明依据。"
        }
      ],
      "misconceptions": [
        "认为引入更先进的工具本身就能解决大型项目中的知识、需求与沟通问题。",
        "认为规格越形式化，沟通效果必然越好。",
        "认为面向个人的方法在大型项目中毫无价值，因此完全不应使用。"
      ],
