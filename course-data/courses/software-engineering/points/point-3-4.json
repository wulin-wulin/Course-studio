    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对分解过程、四个设计要素与信息隐藏的界定，按“分解—抽象—接口—构件—内聚”重排讲解顺序，并补充示例与自检问题。",
      "estimatedMinutes": 13,
      "outcomes": [
        {
          "id": "explain-decomposition",
          "text": "说明 top-down design 如何把问题反复分解，直到每个构件的实现显而易见。"
        },
        {
          "id": "identify-elements",
          "text": "识别体系结构设计、抽象规格、接口设计与构件设计四个要素及其产物。"
        },
        {
          "id": "judge-interface",
          "text": "判断一组接口定义是否足以让构件独立开发、独立替换。"
        },
        {
          "id": "apply-partition",
          "text": "用停止条件、接口独立性与内聚性检查一次实际分解结果。"
        }
      ],
      "misconceptions": [
        "把 top-down design 当成一次画完的层次图，忽略它是对每个构件递归进行的分解过程。",
        "认为接口只要写清功能名称就够了，不必精确定义交互约定。",
        "认为只要替换后的构件功能相同就不会影响系统，忽略其他构件可能依赖其内部变量或数据表示。"
      ],
