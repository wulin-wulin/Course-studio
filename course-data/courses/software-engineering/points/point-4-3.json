  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于精确语法与语义、可执行规格与数学建模的核心论断，围绕精确不等于唯一重排讲解，并补充直觉、反例与迁移练习。",
      "estimatedMinutes": 14,
      "outcomes": [
        {
          "id": "explain-precision",
          "text": "解释规格语言为何要求精确的语法与语义，以及合法且有精确含义为何不等于唯一决定实现。"
        },
        {
          "id": "weigh-executable",
          "text": "权衡可执行规格的收益与实现偏向，说明为何不应把规格等同于为每个输入指定唯一输出。"
        },
        {
          "id": "model-behavior",
          "text": "说明规格如何用数学抽象描述顺序程序与并发程序。"
        },
        {
          "id": "apply-spec-lang",
          "text": "在排序、编译器这类具体情境中判断规格应当约束什么、又不应当过度约束什么。"
        }
      ],
      "misconceptions": [
        "把精确语义理解为规格可以唯一确定实现。",
        "认为可执行规格总是优于非可执行规格，忽略其实现偏向与效率代价。",
        "认为规格应当为每个输入指定唯一输出，从而排除合法的实现选择。"
      ],
      "modules": [
