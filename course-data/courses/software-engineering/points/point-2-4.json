{
  "id": "point-2-4",
  "title": "Other Approaches?",
  "shortSummary": "评估除传统工程手段外，提高关键软件可靠性的其他途径及其适用边界。",
  "keyTerms": [
    "可靠性方法",
    "替代途径",
    "适用边界",
    "critical software"
  ],
  "animationType": "none",
