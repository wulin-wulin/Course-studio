  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "comparison-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "以教材提出的三种替代途径为事实边界，按统一的证据维度重排比较顺序，补充假设检查、集成示例与情境练习。",
      "estimatedMinutes": 14,
      "outcomes": [
        {
          "id": "explain-three-approaches",
          "text": "说明沿用相似产品经验、用可靠组件组装、软件冗余这三种途径各自的主张与证据来源。"
        },
        {
          "id": "diagnose-evidence-gaps",
          "text": "指出每种途径所依赖却常被忽略的假设，并解释教材为何认为它们不足以支撑可靠性结论。"
        },
        {
          "id": "choose-approach",
          "text": "在给定的关键软件情境中判断某途径能否作为可靠性证据，并给出基于假设检查的理由。"
        }
      ],
      "misconceptions": [
        "认为新系统只要基于过去成功的设计，就自动继承了原有的可靠性。",
        "认为把已知可靠的组件拼装起来，产品就必然可靠，忽略连接方式本身可能引入设计错误。",
        "认为多个团队重写同一功能就能获得与“失效相互独立”假设相当的可靠性提升。"
      ],
