    "blocks": [
      {
        "id": "textbook-references-section",
        "moduleId": "chapter-position",
        "depth": "core",
        "kind": "note",
        "title": "教材中的 References 小节",
        "markdown": "教材《Large Software Systems: A Study》在正文末尾设有 References 小节。它不继续展开论证，而是集中登记该研究引用过的文献与资料来源，是本章末尾的出处清单。\n\n阅读时可以把这一节当作正文的配套索引：正文负责给出论断，References 负责给出该论断背后资料的入口。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-2af98d1121e7e235ed121771",
