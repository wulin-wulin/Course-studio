{
  "id": "point-1-4",
  "title": "Software vs Other forms of Engineering",
  "shortSummary": "比较软件与其他工程学科在产物形态、可复制性、验证方式和变更成本上的根本差异。",
  "keyTerms": [
    "engineering comparison",
    "可复制性",
    "验证",
    "变更成本"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.84,
  "prerequisites": [],
