  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "comparison-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材给出的五组差异与 Space Shuttle、桥梁两个例子，围绕统一比较维度重排讲解，并补充可用于判断验证策略的迁移练习。",
      "estimatedMinutes": 10,
      "outcomes": [
        {
          "id": "explain-material-form",
          "text": "说明软件作为纯设计产物在形态、复杂度容量与老化方式上的特点。"
        },
        {
          "id": "explain-replication",
          "text": "解释为什么复制软件副本不能提升可靠性，并说明独立实现的作用与局限。"
        },
        {
          "id": "explain-discrete-verification",
          "text": "区分离散行为与连续行为，说明为何软件测试结果不能像物理结构那样外推。"
        },
        {
          "id": "apply-comparison",
          "text": "在给定情境中依据这些差异判断应采用何种验证与复用策略。"
        }
      ],
      "misconceptions": [
        "认为多部署几份相同的软件副本就能提高可靠性，忽略教材指出的复制不带来可靠性。",
        "认为软件会像物理产品一样腐蚀或老化；教材指出最接近老化的是因硬件与库变化导致的过时。",
        "认为可以像测试桥梁那样，用极端负载的结果保证软件在较小负载下也不出错。"
      ],
      "modules": [
        {
          "id": "framing-the-comparison",
          "title": "问题导入：为什么软件不像传统工程产物",
          "role": "orientation",
          "description": "先列出教材给出的五组差异，建立后续逐项展开的比较框架。",
          "outcomeRefs": [
            "explain-material-form"
          ],
          "order": 0
        },
        {
          "id": "form-and-complexity",
          "title": "产物形态与复杂度容量",
          "role": "concept",
          "description": "解释纯设计、无重量、不可触摸的产物形态，以及由此带来的复杂度容纳能力。",
          "outcomeRefs": [
            "explain-material-form"
          ],
          "order": 1
        },
        {
          "id": "defects-ageing-replication",
          "title": "缺陷、老化与复制",
          "role": "concept",
          "description": "澄清软件没有制造缺陷、腐蚀或老化，并讨论复制副本与独立实现各自能解决什么。",
          "outcomeRefs": [
            "explain-material-form",
            "explain-replication"
          ],
          "order": 2
        },
        {
          "id": "discrete-behaviour",
          "title": "离散行为与验证边界",
          "role": "concept",
          "description": "用桥梁测试的对照说明离散行为为何使测试结果无法插值。",
          "outcomeRefs": [
            "explain-discrete-verification"
          ],
          "order": 3
        },
        {
          "id": "situated-judgement",
          "title": "情境判断与迁移",
          "role": "transfer",
          "description": "把五组差异用于判断具体项目的验证、冗余与复用策略，并桥接到下一知识点。",
          "outcomeRefs": [
            "apply-comparison",
            "explain-replication",
            "explain-discrete-verification"
          ],
          "order": 4
        }
      ],
      "completion": {
