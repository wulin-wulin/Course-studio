      "primaryPattern": "quantitative-feasibility-analysis",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材给出的目标量级、机队概率换算以及调试与测试的极限论证，围绕可行性判断补充换算过程、误区澄清和检查题。",
      "estimatedMinutes": 16,
      "outcomes": [
        {
          "id": "interpret-target",
          "text": "解释失效率 $10^{-9}$ 次/小时（即每 $10^9$ 小时一次）这一目标在时间尺度上的含义，并换算为可感知的失效间隔。"
        },
        {
          "id": "translate-probability",
          "text": "说明该目标在机队与寿命情境下对应的失效概率，理解量级与场景假设的关系。"
        },
        {
          "id": "explain-limits",
          "text": "解释调试收益递减与测试验证极限为什么使超高可靠性难以靠单一手段达成。"
        },
        {
          "id": "evaluate-cost",
          "text": "评价达到超高可靠性所需的工程代价与验证条件，并判断其现实可行性。"
        }
      ],
      "misconceptions": [
        "把失效率 $10^{-9}$ 次/小时当作普通质量指标，忽略它对应约十万年一次的失效间隔。",
        "认为只要投入更多测试就能证明达到超高可靠性，忽略验证时间与真实条件的约束。",
        "认为修复缺陷总会提升可靠性，忽略调试收益递减以及修复可能引入新缺陷。"
      ],
