{
  "id": "point-6-5",
  "title": "Face-To-Face: the Only Way",
  "shortSummary": "论证面对面沟通在澄清复杂需求与建立共同理解中的不可替代作用及其条件。",
  "keyTerms": [
    "face-to-face",
    "沟通",
    "共同理解",
    "需求澄清"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.8,
  "prerequisites": [],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-example-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于长沟通链、背景差异、文档劣势与 boundary spanner 的论述，围绕“何时必须面对面”补充机制解释、代价权衡和情境判断。",
      "estimatedMinutes": 10,
      "outcomes": [
        {
          "id": "explain-distortion",
          "text": "解释长沟通链为何会造成信息失真与延迟，并说明面对面沟通针对的具体问题。"
        },
        {
          "id": "decide-face-to-face",
          "text": "在给定项目情境中判断是否应优先采用面对面沟通，并给出理由。"
        },
        {
          "id": "weigh-costs",
          "text": "权衡面对面沟通的收益、代价与边界，说明它为何不能取代文档。"
        }
      ],
      "misconceptions": [
        "认为面对面沟通只是增进关系，对澄清技术需求没有实质帮助。",
        "认为有了文档和协作工具就不再需要面对面讨论。"
      ],
      "modules": [
        {
          "id": "chain-and-distortion",
          "title": "长沟通链中的失真与延迟",
          "role": "problem-introduction",
          "description": "先用教材案例呈现跨层级沟通的信息损耗，再解释其机制。",
          "outcomeRefs": [
            "explain-distortion"
          ],
          "order": 0
        },
        {
          "id": "shared-context",
          "title": "背景差异与共同理解",
          "role": "explanation",
          "description": "说明误解的来源，以及面对面如何即时对齐假设。",
          "outcomeRefs": [
            "explain-distortion",
            "decide-face-to-face"
          ],
          "order": 1
        },
        {
          "id": "documentation-limits",
          "title": "文档的劣势与适用边界",
          "role": "comparison",
          "description": "比较面对面与文档在时效、可追溯性和人员流动下的不同作用。",
          "outcomeRefs": [
            "weigh-costs"
          ],
          "order": 2
        },
        {
          "id": "boundary-spanners",
          "title": "boundary spanners 与沟通代价",
          "role": "mechanism",
          "description": "分析承担跨组翻译的人需要什么能力，以及过度沟通的代价。",
          "outcomeRefs": [
            "decide-face-to-face",
            "weigh-costs"
          ],
          "order": 3
        },
        {
          "id": "check-and-transfer",
          "title": "情境判断与桥接",
          "role": "assessment",
          "description": "用情境题检查能否把论证迁移到新项目，并衔接到方法与工具。",
          "outcomeRefs": [
            "explain-distortion",
            "decide-face-to-face",
            "weigh-costs"
          ],
          "order": 4
        }
      ],
      "completion": {
        "outcomeRefs": [
          "explain-distortion",
