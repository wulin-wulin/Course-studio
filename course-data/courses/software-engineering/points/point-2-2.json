{
  "id": "point-2-2",
  "title": "Achieving Dependability",
  "shortSummary": "梳理获得 dependability 的工程手段，包括避免故障、容错、移除故障与预测故障。",
  "keyTerms": [
    "fault avoidance",
    "fault tolerance",
    "fault removal",
    "fault forecasting"
  ],
  "animationType": "none",
  "difficulty": "中等",
