{
  "id": "point-1-1",
  "title": "Software Development Catastrophes",
  "shortSummary": "通过真实失败项目说明软件危机并非偶发事故，而是开发方式与系统复杂度长期失配的结果。",
  "keyTerms": [
    "software crisis",
    "项目失败",
    "开发复杂度",
    "软件工程起源"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.9,
