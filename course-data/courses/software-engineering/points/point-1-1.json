  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "case-analysis",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材的案例清单、金额量级、统计比例与航空类比，按“情境—案例证据—后果成本—证据强度—成因—迁移自查”重排，并补充单位说明、假设算例与自查练习。",
      "estimatedMinutes": 14,
      "outcomes": [
        {
          "id": "case-magnitude",
          "text": "说出教材列出的失败软件项目，并说明其损失所处的量级。"
        },
        {
          "id": "cost-beyond-contract",
          "text": "解释为什么软件项目失败的成本远大于合同金额本身。"
        },
        {
          "id": "evidence-strength",
          "text": "区分轶事、量级与统计证据，判断关于软件失败的结论是否有依据。"
        },
        {
          "id": "crisis-drivers",
          "text": "解释 software crisis 的含义，以及项目规模增长如何加剧它。"
        }
      ],
      "misconceptions": [
        "把几个著名失败案例当成“大多数软件项目都会失败”的证明，用轶事替代失败率。",
        "认为软件危机只是 1968 年的历史问题，随处理器能力提升已经自动解决。",
        "把项目失败的成本等同于合同金额或预算超支的部分。"
      ],
