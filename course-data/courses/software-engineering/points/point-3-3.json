    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "document-structure-and-quality-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对规格文档内容、边界与简洁性的论断，围绕“一份规格草稿是否合格”补充判据、反例和检查清单。",
