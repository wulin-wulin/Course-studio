              "assetRefs": [],
              "excerptSha256": "eb35fd2382b4f3543268ac442fa19619237477d67144c5eb44e61b0e64b192df"
            }
          ]
        }
      },
      {
        "id": "validation-chain-model",
        "moduleId": "validation-process",
        "depth": "support",
        "kind": "table",
        "title": "模型补充：把四阶段读成证据链",
        "markdown": "| 阶段 | 回答的问题 | 主要证据 |\n|---|---|---|\n| 需求验证 | 规格是否说清了真实需要 | 需求文档与审查记录 |\n| 验证与测试 | 代码是否符合规格、是否满足真实需求 | 证明、测试与缺陷记录 |\n| 运行与维护 | 上线后的行为是否仍然受控 | 运行反馈与变更记录 |\n| 认证 | 是否达到可投入运营的安全标准 | 各阶段证据与危险性研究 |\n\n这条链条说明，形式化证明只是其中一个环节，它的结论需要其他环节来补足和检验。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "validation-stages-textbook",
            "proof-testing-textbook"
          ]
        }
      },
      {
