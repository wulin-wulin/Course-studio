              "assetRefs": [
                "https://raw.githubusercontent.com/d2l-ai/d2l-zh/e6b18ccea71451a55fcd861d7b96fddf2587b09a/img/vgg.svg"
              ],
              "excerptSha256": "ac677d570459816962eb44a427844e6bfc14122721461717ed6ea0eebb83add3"
