              "headingPath": [
                "现代卷积神经网络",
                "深度卷积神经网络（AlexNet）",
                "AlexNet",
                "激活函数"
              ],
              "lineStart": 4375,
              "lineEnd": 4383,
              "assetRefs": [],
              "excerptSha256": "fc044d5e4e1c1c6e769b7d47ec1503de49da3a9866c3325f3f5b902a58d7b65a"
            }
