      {
        "id": "tb-intro",
        "moduleId": "cross-correlation-mechanism",
        "depth": "core",
        "kind": "explanation",
        "title": "从原理到图像实例",
        "markdown": "上一节从平移不变性推导出卷积层的结构，这一节把同样的运算放到图像上看。教材以二维图像为例，说明卷积层实际执行的是互相关运算，并依次讨论卷积核、输出尺寸、边缘检测、核的学习以及特征映射与感受野。\n\n阅读时可以始终抓住同一个问题：卷积核在图像上滑动时，每一个输出值由哪些输入值和哪些核元素共同决定。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d3ee7029633f5d1e838fcfae",
              "blockIds": [
                "block-000136"
              ],
              "headingPath": [
                "卷积神经网络",
                "图像卷积"
              ],
              "lineStart": 2627,
              "lineEnd": 2634,
              "assetRefs": [],
              "excerptSha256": "cd443e9c5488d5df0739bd7b579cc8617b4abc025fa20a2daf557e31cafc5ae8"
            }
          ]
        }
