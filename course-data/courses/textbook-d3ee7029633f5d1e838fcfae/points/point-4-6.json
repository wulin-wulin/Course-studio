    "blocks": [
      {
        "id": "textbook-motivation",
        "moduleId": "depth-problem",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：为什么要关注“新加的层”",
        "markdown": "设计更深的网络时，一个关键问题不是“能否堆更多层”，而是“新添加的层能否真正提升性能”。添加层会让网络更具表现力，但这并不自动保证训练结果更好；要回答这个问题，需要先看清架构所代表的函数类。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d3ee7029633f5d1e838fcfae",
              "blockIds": [
                "block-000210"
              ],
