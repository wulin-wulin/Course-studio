      },
      {
        "id": "model-layer-intuition",
        "moduleId": "receptive-field",
        "depth": "support",
        "kind": "explanation",
        "title": "一个便于记忆的分工图景",
        "markdown": "换个说法：浅层特征图分辨率高、感受野小，适合看清细节与小目标；深层特征图经过多次下采样，分辨率低但单个单元“看到”的原图范围大，适合判断大目标。多尺度检测因此不是在同一张特征图上把锚框调大调小，而是让不同深度的特征图各自负责与自己感受野匹配的目标尺度。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-receptive-field"
          ]
        }
      },
      {
        "id": "tb-summary",
        "moduleId": "wrap-up",
