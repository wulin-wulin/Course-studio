      {
        "id": "model-reading-question",
        "moduleId": "opening-and-context",
        "depth": "core",
        "kind": "explanation",
        "title": "带着一个矛盾读下去",
        "markdown": "阅读时可以先抓住一个矛盾：编译器翻译过程体时既不知道开放数组有多长，也不知道要为它预留多少存储，那它靠什么生成正确的下标检查和元素地址？下文引入的数组描述符正是对这个问题的回答。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-chapter-context"
          ]
        }
