              "excerptSha256": "32df42c0ee8b214b74809b8a3ad327bf7a5b01823a87ea0c2a8433ba193c20e0"
            }
          ]
        }
      },
      {
        "id": "model-contrast-table",
        "moduleId": "contrast-with-top-down",
        "depth": "support",
        "kind": "table",
        "title": "补充整理：两种方向的比较维度",
        "markdown": "| 比较维度 | 自底向上（LR） | 自顶向下（LL） |\n|---|---|---|\n| 起始点 | 从输入串出发，不预设目标 | 从开始符号出发，目标驱动 |\n| 关键动作 | 移进输入、归约栈上右部 | 展开最左非终结符、匹配终结符 |\n| 语法树生长 | 自叶向根 | 自根向叶 |\n| 决策依据 | 栈内容、当前输入符号与分析表 | 当前非终结符、当前输入符号与分析表 |\n| 归约或展开位置 | 已读序列右端 | 最左非终结符 |",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-lr-ll"
          ]
        }
      },
      {
        "id": "textbook-decision-tables",
        "moduleId": "decision-and-tables",
        "depth": "core",
        "kind": "explanation",
        "title": "教材指出的难点：下一步做什么",
        "markdown": "教材指出，自底向上分析的具体难点有两个：第一，下一步该移进还是归约；第二，若归约，栈上有多少个符号参与这次归约。为了保证分析足够高效，用于决策的信息必须以适当“编译”过的形式保存。自底向上分析器总是使用分析表：除了语法结构本身，还需要额外的表来快速确定下一步。教材因此认为，自底向上分析一般比自顶向下分析更复杂。",
        "provenance": {
          "origin": "textbook",
