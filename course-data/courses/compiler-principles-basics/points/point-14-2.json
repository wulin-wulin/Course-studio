{
  "id": "point-14-2",
  "title": "Compatibility between numeric data types",
  "shortSummary": "讨论整数、实数与 BYTE 的类型兼容取舍，说明表示转换指令、显式转换函数及 BYTE 溢出边界。",
  "keyTerms": [
    "类型兼容",
    "type compatibility",
    "显式转换",
    "INTEGER",
    "REAL",
    "BYTE",
    "转换指令"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.82,
  "prerequisites": [
    "point-14-1"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-boundary-comparison",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于位表示差异与显式转换的论证顺序，补充位表示直觉、FLOOR 取整示例和 BYTE 溢出边界检查。",
      "estimatedMinutes": 14,
      "outcomes": [
        {
          "id": "explain-numeric-representation",
          "text": "解释不同数值类型为什么需要表示转换，而不能只凭“值都是数”就认为赋值兼容。"
        },
        {
          "id": "choose-conversion-policy",
          "text": "说明教材为什么把数值类型声明为不兼容，并选择显式转换函数而不是隐藏转换。"
        },
        {
          "id": "apply-conversion-boundaries",
          "text": "在 INTEGER、REAL、BYTE 的场景中判断该用转换还是该做范围检查，并识别溢出边界。"
        }
      ],
      "misconceptions": [
        "认为只要两种类型的值都是数，就可以随意赋值，忽略它们在机器中的位表示差异。",
        "把 FLOOR(x) 当作简单截断小数部分，忽略它对负数向负无穷取整。",
        "把 BYTE 与 INTEGER 的兼容当作赋值一定安全，忽略超出 0 .. 255 时的溢出风险。"
      ],
      "modules": [
