                "Exercises."
              ],
              "lineStart": 590,
              "lineEnd": 606,
              "assetRefs": [],
              "excerptSha256": "c6f66f26cf85d2d4cb27ad39db885759f41252ac92eb245616baacdaf4338599"
            }
          ]
        }
      },
      {
        "id": "model-procedure-context",
        "moduleId": "procedure-type-extension",
        "depth": "core",
        "kind": "mechanism",
        "title": "过程值为什么需要上下文",
        "markdown": "限制的根源是过程值不能只记录入口地址：全局过程没有外部上下文，入口地址足以完成调用；局部过程却依赖声明它的环境，例如 Cnt 需要访问 CountElements 的局部变量 n。解除限制意味着过程值要携带“代码地址 + 环境”两部分信息，通常表现为一条静态链或一个闭包指针。间接调用时先把环境恢复出来，再进入过程体；类型检查还要比较参数个数、参数类型、参数种类和结果类型。代价包括过程值变大、调用序列变复杂、环境必须延长存活时间（可能需要在堆上分配），以及编译器要处理环境捕获和生命周期，这些都会增加实现难度和运行时开销。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "procedure-type-exercise"
          ]
        }
      },
      {
        "id": "model-implementation-checklist",
        "moduleId": "tradeoff-and-check",
        "depth": "support",
        "kind": "summary",
        "title": "实现主线与逐题自检",
        "markdown": "三题共享一条实现主线：语言规则决定符号表要记录什么，符号表决定代码生成能拿到什么，代码生成再决定运行时需要哪些辅助信息。逐题自检：14.1 是否把各维长度随地址一起传递，并在多维访问时用运行时长度计算偏移；14.2 是否为标量与结构化结果分别设计返回方式，并在调用点完成结果类型检查；14.3 是否让过程值同时携带代码与环境，并说明环境存活期带来的开销。最后比较三题的代价来源：14.1 的额外成本主要来自描述信息和边界检查，14.2 来自结果传递与类型分派，14.3 来自闭包表示和上下文管理。",
        "provenance": {
