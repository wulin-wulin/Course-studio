                "block-000646"
              ],
              "headingPath": [
                "廉价冗余磁盘阵列（RAID）",
                "存根生成器"
              ],
              "lineStart": 12560,
              "lineEnd": 12602,
              "assetRefs": [],
              "excerptSha256": "5936b127bb8815ef063d8c5d981b0bc3b292352be4057405144ac7f3cd432025"
            }
          ]
        }
      },
      {
        "id": "model-write-example",
        "moduleId": "stub-machinery",
        "depth": "core",
        "kind": "worked-example",
        "title": "一次写调用的打包与还原",
        "markdown": "以一次 `write(fd, buf, size)` 风格的远程调用为例：客户端写下的调用只有三个参数，但存根必须把“调用哪个函数”、文件描述符、缓冲区内容和长度一起编码进消息。服务器解包后按约定顺序还原参数，再调用真实的写函数。\n\n这说明序列化不能简单地把内存原样拷贝：指针、长度与实际数据之间的关系必须由协议明确规定，接收方才能重建出同样的参数。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "stub-flow",
            "stub-complex-args"
          ]
        }
      },
      {
        "id": "stub-concurrency",
        "moduleId": "stub-machinery",
        "depth": "support",
        "kind": "mechanism",
        "title": "服务器如何组织并发",
        "markdown": "服务器如何组织并发同样影响 RPC 实现。最简单的服务器在循环中一次处理一个请求；如果某个调用因 I/O 阻塞，服务器资源就被浪费。多数服务器改用线程池：启动时创建固定数量的工作线程，请求到达后分派给空闲线程处理，主线程继续接收新请求，从而提高服务器利用率。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000646"
              ],
              "headingPath": [
                "廉价冗余磁盘阵列（RAID）",
                "存根生成器"
              ],
