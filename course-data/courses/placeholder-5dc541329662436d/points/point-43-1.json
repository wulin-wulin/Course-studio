              "assetRefs": [
                "parts/part-0005/images/8999d5c830b647bd1aa808d22413e61fdc84d2ca1993248e98c2a36bd46f7b85.jpg",
                "parts/part-0005/images/6f3204283db42e5b72ec333c8ed39b218e08cc8d6b0ddd70341d3273db887828.jpg"
              ],
              "excerptSha256": "d681e7a1708c2c2383abc661abd89c5aca2b13c258accd91feaa5a72e5b36409"
            }
