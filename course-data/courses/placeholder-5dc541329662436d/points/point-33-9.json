    "blocks": [
      {
        "id": "textbook-summary",
        "moduleId": "recap-and-problem",
        "depth": "core",
        "kind": "summary",
        "title": "教材小结：事件并发的取舍",
        "markdown": "教材对基于事件的并发给出一个平衡的结论：事件服务器把调度权交给应用程序本身，代价是编程复杂性，以及与现代系统其他部分（例如分页）集成的难度。正因如此，并不存在普遍最优的方法；线程和事件在未来很长时间里仍会是解决同一类并发问题的两种不同路径。教材建议通过阅读研究论文或亲手编写基于事件的代码来加深理解。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000458"
              ],
              "headingPath": [
                "关于内存虚拟化的对话",
                "小结"
              ],
              "lineStart": 9260,
              "lineEnd": 9263,
              "assetRefs": [],
              "excerptSha256": "4e0225b14759a6f77ca103ff7d98ca9afead89341e58d64e46de91fbdb715ad5"
            }
          ]
        }
      },
      {
        "id": "model-core-recap",
        "moduleId": "recap-and-problem",
        "depth": "core",
        "kind": "explanation",
        "title": "模型补充：把小结放回全章主线",
        "markdown": "本章先展示了事件循环如何用一个线程轮流处理多个事件，再依次讨论非阻塞 I/O、状态管理和多核等难题。小结并不是宣布事件模型胜出，而是要求学习者把“控制力”和“代价”放在同一张表上衡量：应用获得的调度自由度越大，越需要自己承担状态保存、阻塞风险和 API 语义变化带来的负担。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-summary"
          ]
        }
      },
      {
        "id": "textbook-reference-path",
        "moduleId": "comparison-dimensions",
        "depth": "support",
        "kind": "note",
        "title": "教材给出的延伸阅读路径",
        "markdown": "教材在参考资料中列出了进一步阅读的方向：Adya 等人讨论事件并发的困难与简化方案；延续（continuation）的经典文献；Node.js 文档；Ousterhout 关于线程适用边界的演讲；以及 Flash、Capriccio、SEDA 等围绕 Web 服务器、线程与事件架构的研究。教材建议读者通过阅读这些论文或编写事件驱动代码继续深入。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
