              "assetRefs": [],
              "excerptSha256": "27634d3c5264f3d7ddeef03abe09a2f01d56b79ff32af72c1082b0099440e8e6"
            }
          ]
        }
      },
      {
        "id": "model-getattr",
        "moduleId": "operations",
        "depth": "support",
        "kind": "note",
        "title": "补充：GETATTR 为什么值得单独注意",
        "markdown": "`GETATTR` 只需要一个文件句柄就能取回属性，包括最后修改时间。对无状态协议来说这一点很重要：服务器不记录客户端缓存了什么，客户端可以在每次需要时重新取属性，用修改时间等信息判断本地缓存是否仍然有效。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-read-write",
            "tb-operation-table"
          ]
        }
      },
      {
        "id": "tb-attributes",
        "moduleId": "walkthrough",
        "depth": "core",
        "kind": "definition",
        "title": "教材：属性是什么",
        "markdown": "属性（attributes）是文件系统为每个文件维护的元信息，包括创建时间、上次修改时间、大小、所有权和权限等，也就是对文件调用 `stat()` 会返回的信息。",
        "provenance": {
