              "assetRefs": [],
              "excerptSha256": "f224228e574b8f79cacbb5ee30bfad393ccc8f8767281b3de5412cb7a74615c0"
            }
          ]
        }
      },
      {
        "id": "model-hardware-primitives",
        "moduleId": "hardware-primitives",
        "depth": "support",
        "kind": "mechanism",
        "title": "模型补充：常见的原子指令",
        "markdown": "常见的硬件原语包括测试并设置（test-and-set）、比较并交换（compare-and-swap）、链接的加载与条件式存储（load-linked/store-conditional）以及获取并增加（fetch-and-add）。它们的共同点是：把“读取旧值”与“写入新值”或“有条件地写入”合并为一条不可被打断的指令，因此可以作为构造互斥的基座。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-hardware-support"
          ]
        }
      },
      {
        "id": "textbook-os-support",
        "moduleId": "os-support",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：操作系统也在演进",
        "markdown": "教材同时指出，操作系统也在不断发展完善，以支持实现成熟而复杂的锁库。仅有硬件原语，还不足以支撑一个真正好用的锁。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
