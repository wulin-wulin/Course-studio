    "blocks": [
      {
        "id": "textbook-implementation-context",
        "moduleId": "from-user-to-implementer",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：从使用转向实现",
        "markdown": "我们已经从程序员的角度理解了锁的基本用法：调用 `lock()` 进入临界区，调用 `unlock()` 离开。现在问题转向另一侧：锁本身怎样被实现？需要哪些硬件支持？又需要哪些操作系统支持？",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000357"
              ],
              "headingPath": [
                "关于内存虚拟化的对话",
                "实现一个锁"
              ],
              "lineStart": 6550,
              "lineEnd": 6559,
              "assetRefs": [],
              "excerptSha256": "f224228e574b8f79cacbb5ee30bfad393ccc8f8767281b3de5412cb7a74615c0"
            }
          ]
        }
      },
      {
        "id": "model-why-plain-flag-fails",
        "moduleId": "from-user-to-implementer",
        "depth": "core",
        "kind": "explanation",
        "title": "模型补充：普通标志变量为何不够",
        "markdown": "从接口看，锁似乎只是一个保存“可用/被占用”状态的布尔变量。但普通变量做不到可靠互斥：两个线程可能同时读到“可用”，再先后写回“被占用”，结果都进入了临界区。要让“检查状态并修改状态”成为一个不可分割的步骤，就必须借助硬件提供的原子原语。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-implementation-context"
          ]
        }
      },
      {
        "id": "textbook-implementation-goal",
        "moduleId": "from-user-to-implementer",
        "depth": "core",
        "kind": "note",
        "title": "教材：关键问题与效率目标",
        "markdown": "教材把目标概括为构建一个高效的锁：它能够以较低成本提供互斥，同时支持后续讨论的一些特性。因此，实现问题不只是“让锁能用”，还要在正确性与开销之间作出权衡。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000357"
              ],
              "headingPath": [
                "关于内存虚拟化的对话",
                "实现一个锁"
              ],
              "lineStart": 6550,
              "lineEnd": 6559,
              "assetRefs": [],
              "excerptSha256": "f224228e574b8f79cacbb5ee30bfad393ccc8f8767281b3de5412cb7a74615c0"
            }
          ]
        }
      },
      {
        "id": "textbook-hardware-support",
        "moduleId": "hardware-primitives",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：硬件原语是前提",
        "markdown": "实现一个可用的锁需要硬件和操作系统的帮助。现代指令集增加了多种硬件原语；本课程不研究这些指令在体系结构层面如何实现，而是关注怎样把它们组合成锁这样的互斥原语。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000357"
              ],
              "headingPath": [
                "关于内存虚拟化的对话",
                "实现一个锁"
              ],
              "lineStart": 6550,
