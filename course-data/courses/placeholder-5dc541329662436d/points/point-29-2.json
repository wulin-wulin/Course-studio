              "excerptSha256": "14ab0898c801ea8f168951d3fe1cc182d6715f4440d9c942d7b1c5c4bd5457ba"
            }
          ]
        }
      },
      {
        "id": "model-completion-summary",
        "kind": "summary",
        "title": "把判断压缩成一条流程",
        "moduleId": "completion-and-bridge",
        "depth": "core",
        "markdown": "把本点的判断压缩成一条流程：先用一把锁保证正确性，并让锁只覆盖共享结构的更新；再测量这条链表是否真的成为瓶颈；只有在基准测试显示竞争显著、且更细粒度带来的额外加锁开销能被摊薄时，才考虑过手锁或混合锁，同时保持一致的锁获取方向并合并错误返回路径。下一步将把同样的思路用于需要同时维护头尾指针的并发队列。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-critical-section",
            "textbook-control-flow-tip"
          ]
        }
      }
