{
  "id": "point-15-5",
  "title": "操作系统的问题",
  "shortSummary": "讨论操作系统在进程切换、内存分配和保护检查中的职责，以及硬件与软件的协作边界。",
  "keyTerms": [
    "操作系统职责",
    "进程切换",
    "内存分配",
    "保护检查"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.7,
