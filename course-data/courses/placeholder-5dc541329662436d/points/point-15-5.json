    "point-15-3",
    "point-15-4"
  ],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "responsibility-procedure-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于空闲列表、基址/界限寄存器与异常处理的原始职责划分，按进程生命周期重组讲解顺序，并补充边界澄清与检查任务。",
      "estimatedMinutes": 15,
      "outcomes": [
        {
          "id": "explain-os-roles",
          "text": "解释操作系统在动态重定位中承担的内存管理、基址/界限管理与异常处理三类职责。"
        },
        {
          "id": "trace-lifecycle",
          "text": "追踪进程创建、上下文切换与终止时，操作系统对空闲列表和基址/界限寄存器执行的具体操作。"
        },
        {
          "id": "apply-limited-direct-execution",
          "text": "用受限直接执行协议说明地址转换的常态由硬件完成、操作系统只在关键时刻介入这一协作边界。"
        }
      ],
      "misconceptions": [
        "认为每次内存访问都要由操作系统参与地址转换；实际上转换由硬件自动完成，操作系统只在创建、切换、终止和异常等关键时刻介入。",
        "认为进程运行期间操作系统可以随时搬移它的地址空间；必须先让进程停止运行，拷贝地址空间后再更新保存的基址寄存器。"
      ],
      "modules": [
        {
          "id": "where-os-steps-in",
          "title": "关键介入时机",
          "role": "concept",
          "description": "从动态重定位的硬件支持出发，定位操作系统必须出手的四个时刻。",
