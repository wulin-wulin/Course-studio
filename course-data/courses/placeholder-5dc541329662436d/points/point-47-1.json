{
  "id": "point-47-1",
  "title": "通信基础",
  "shortSummary": "说明分布式通信为何应被视为根本不可靠，并分析位翻转、组件失效与缓冲区不足等丢包来源。",
  "keyTerms": [
    "通信不可靠",
    "丢包",
    "位翻转",
    "缓冲区不足",
    "分布式系统"
  ],
  "animationType": "none",
  "difficulty": "中等",
  "importance": 0.75,
