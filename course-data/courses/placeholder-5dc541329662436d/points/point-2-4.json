              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000027"
              ],
              "headingPath": [
                "操作系统导论",
                "持久性"
              ],
              "lineStart": 1048,
              "lineEnd": 1079,
              "assetRefs": [],
              "excerptSha256": "5d9c3463995b2940b96fe182c4aa53e7ba5f7a7c071dfb4dadeaea41fabedfbc"
            }
          ]
        }
      },
      {
        "id": "model-device-role",
        "moduleId": "storage-devices",
        "depth": "support",
        "kind": "note",
        "title": "补充：设备与管理的分工",
        "markdown": "设备提供的是可读写的存储介质，而用户关心的是“我的文件在哪里、叫什么名字、内容是否完整”。把这些文件语义映射到设备上的具体位置并可靠地记录下来，正是操作系统中的文件系统要完成的工作。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-storage-hardware"
          ]
        }
      },
      {
        "id": "tb-file-system",
        "moduleId": "storage-devices",
        "depth": "core",
        "kind": "definition",
        "title": "教材：文件系统的职责",
        "markdown": "操作系统中管理磁盘的软件通常称为文件系统（file system）。它负责以可靠且高效的方式，把用户创建的任何文件（file）存储在系统的磁盘上。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000027"
              ],
              "headingPath": [
                "操作系统导论",
                "持久性"
              ],
              "lineStart": 1048,
