    "blocks": [
      {
        "id": "tb-volatile-memory",
        "moduleId": "why-persistence",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：内存数据为何会消失",
        "markdown": "系统内存中的数据容易丢失。像 DRAM 这样的设备以易失（volatile）的方式保存数值：一旦断电或系统崩溃，内存中的所有数据都会消失。因此，要让数据长期存在，需要硬件和软件共同把它持久地（persistently）保存下来。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000027"
              ],
              "headingPath": [
                "操作系统导论",
                "持久性"
              ],
              "lineStart": 1048,
              "lineEnd": 1079,
              "assetRefs": [],
              "excerptSha256": "5d9c3463995b2940b96fe182c4aa53e7ba5f7a7c071dfb4dadeaea41fabedfbc"
            }
          ]
        }
      },
      {
        "id": "model-whiteboard-analogy",
        "moduleId": "why-persistence",
        "depth": "support",
        "kind": "example",
        "title": "补充直觉：白板与笔记本",
        "markdown": "可以把内存想成一块白板：读写很快，但一断电内容就被擦掉。持久存储则像一本笔记本，写入要慢一些，却能在断电、重启以及原来的进程结束之后继续保留信息。持久性要解决的就是如何可靠地把白板上的内容搬进笔记本。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-volatile-memory"
          ]
        }
      },
      {
        "id": "tb-storage-hardware",
        "moduleId": "storage-devices",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：持久存储的物理载体",
        "markdown": "持久存储在硬件上以某种输入/输出（Input/Output，I/O）设备的形式提供。在现代系统中，硬盘驱动器（hard drive）是长期保存信息的通用存储库，固态硬盘（Solid-State Drive，SSD）也正在这一领域取得领先地位。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
