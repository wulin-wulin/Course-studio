          "role": "concept-definition",
          "outcomeRefs": [
            "explain-fail-stop"
          ],
          "order": 1
        },
        {
          "id": "detection-assumption",
          "title": "故障检测假定",
          "role": "mechanism-clarification",
          "outcomeRefs": [
            "explain-fail-stop",
            "assess-raid-assumption"
          ],
          "order": 2
        },
        {
          "id": "boundaries-and-check",
          "title": "模型边界与检查",
          "role": "boundary-and-transfer",
          "outcomeRefs": [
            "identify-assumptions"
          ],
          "order": 3
        }
      ],
      "completion": {
        "outcomeRefs": [
          "explain-fail-stop",
