                "parts/part-0001/images/ae0547fe4d17627bb2fa46c8e3ae9240b55e15360d2339b3a8cf2e9a1b50aad2.jpg"
              ],
              "excerptSha256": "20ecac297c4167f82097644c7791bc74eddc6c1013a8eca59c00396b5ffad4de"
            }
          ]
        }
      },
      {
        "id": "textbook-scan-counter",
        "moduleId": "linear-scan",
        "depth": "core",
        "kind": "mechanism",
        "title": "教材：用计数器遍历链表",
        "markdown": "选定中奖号码后，从链表头开始遍历，并用一个计数器累计已经经过的票据数。每走到一个进程，就把它的票据数加到计数器上；一旦计数器大于中奖号码，就停止遍历，当前节点对应的进程即为中奖者。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000129"
              ],
              "headingPath": [
                "操作系统导论",
                "实现"
              ],
              "lineStart": 2605,
              "lineEnd": 2631,
              "assetRefs": [
                "parts/part-0001/images/ae0547fe4d17627bb2fa46c8e3ae9240b55e15360d2339b3a8cf2e9a1b50aad2.jpg"
              ],
              "excerptSha256": "20ecac297c4167f82097644c7791bc74eddc6c1013a8eca59c00396b5ffad4de"
            }
          ]
        }
      },
      {
        "id": "textbook-worked-example",
        "moduleId": "linear-scan",
        "depth": "core",
        "kind": "worked-example",
        "title": "教材：中奖号码 300 的完整遍历",
        "markdown": "在示例中，遍历先从 A 开始，计数器累加到 100。由于 100 小于 300，继续前进；加上 B 的 50 张票后计数器为 150，仍小于 300；再加上 C 的票据后计数器达到 400，首次超过 300，于是退出遍历，current 指向 C，C 成为中奖者。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
