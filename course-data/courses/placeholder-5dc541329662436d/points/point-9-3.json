    "blocks": [
      {
        "id": "textbook-implementation-parts",
        "moduleId": "implementation-parts",
        "depth": "core",
        "kind": "definition",
        "title": "教材：实现所需的三项要素",
        "markdown": "彩票调度的实现比直觉中简单，核心只有三样东西：一个足够好的随机数生成器、一个记录系统中所有进程的数据结构（通常是一个列表），以及所有彩票的总数。列表保存每个进程及其票据数，总票据数则决定抽签时随机数的取值范围。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-98b367ee24452fe791591fee",
              "blockIds": [
                "block-000129"
              ],
              "headingPath": [
                "操作系统导论",
                "实现"
              ],
              "lineStart": 2605,
              "lineEnd": 2631,
              "assetRefs": [
                "parts/part-0001/images/ae0547fe4d17627bb2fa46c8e3ae9240b55e15360d2339b3a8cf2e9a1b50aad2.jpg"
              ],
              "excerptSha256": "20ecac297c4167f82097644c7791bc74eddc6c1013a8eca59c00396b5ffad4de"
            }
          ]
        }
      },
      {
        "id": "model-random-role",
        "moduleId": "implementation-parts",
        "depth": "support",
        "kind": "explanation",
        "title": "模型补充：三个要素如何配合",
        "markdown": "随机数生成器负责在 0 到总票据数（不含上限）的范围内产生中奖号码，因此每张票被抽中的概率相同。进程列表只负责把票据数映射回具体进程，总票据数则是抽签范围的来源。三者缺一不可，但整个过程不需要复杂的索引结构。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-implementation-parts"
          ]
        }
      },
      {
        "id": "textbook-process-list-example",
        "moduleId": "lottery-draw",
        "depth": "core",
        "kind": "example",
        "title": "教材：A、B、C 三个进程的列表示例",
        "markdown": "教材用列表记录进程，并假定系统中有 A、B、C 三个进程，每个进程持有一定数量的票据。示例中所有票据加起来为 400 张，这个总数就是下一步抽签的上界。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
