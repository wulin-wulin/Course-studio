  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-tradeoff-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对抽象、性能、保护、可靠性与能源等目标的原始表述和边界，按“目标—手段—代价—情境取舍”的顺序重排讲解，补充对比表与情境练习。",
