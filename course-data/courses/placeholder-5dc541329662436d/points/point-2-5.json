{
  "id": "point-2-5",
  "title": "设计目标",
  "shortSummary": "概括操作系统在抽象、性能、保护、可靠性和能量等方面的核心设计目标与权衡。",
  "keyTerms": [
    "设计目标",
    "抽象",
    "性能",
    "保护",
    "可靠性"
  ],
  "animationType": "none",
