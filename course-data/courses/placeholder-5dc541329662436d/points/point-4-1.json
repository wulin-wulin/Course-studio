{
  "id": "point-4-1",
  "title": "抽象：进程",
  "shortSummary": "把进程定义为运行中的程序，并说明其机器状态——内存地址空间、寄存器、程序计数器与打开文件等。",
  "keyTerms": [
    "进程",
    "抽象",
    "机器状态",
    "地址空间"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.9,
  "prerequisites": [],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-definition-boundary-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保持教材对进程、机器状态与时分共享的定义和边界，按定义、机制、状态、边界、检查重排顺序，并补充程序与进程的区分、类比和迁移练习。",
      "estimatedMinutes": 12,
      "outcomes": [
        {
          "id": "explain-process-definition",
          "text": "解释进程是运行中的程序，并说明程序与进程的区别。"
        },
        {
          "id": "identify-machine-state",
          "text": "指出构成进程机器状态的内存、寄存器、程序计数器、栈指针和打开文件等信息。"
        },
        {
          "id": "explain-cpu-virtualization",
          "text": "说明操作系统如何通过时分共享制造多个 CPU 的假象，并指出共享带来的性能代价。"
        },
        {
          "id": "apply-process-boundary",
          "text": "面对新情境判断哪些信息属于进程状态、哪些属于操作系统策略。"
        }
      ],
      "misconceptions": [
        "把进程等同于磁盘上的可执行程序，忽略程序运行后由操作系统维护的状态。",
        "认为进程只由内存构成，忽略寄存器、程序计数器和打开文件等同样属于机器状态的信息。",
        "把机制和策略混为一谈，以为更换调度策略必须重新实现上下文切换。"
      ],
