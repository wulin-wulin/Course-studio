              "excerptSha256": "6d397c2d624dd4826a896e215656bfe778a1a5a4729dadeca2ee7a90afe16730"
            }
          ]
        }
      },
      {
        "id": "model-ticket-ubiquity",
        "moduleId": "share-generalization",
        "depth": "support",
        "kind": "note",
        "title": "迁移：用比例表达资源诉求",
        "markdown": "同一个概念可以迁移到其他资源：把 CPU 时间换成内存页、磁盘带宽或网络带宽，只要能为参与者分配彩票，并按彩票比例抽签决定资源归属，就能表达“谁应获得多少比例”的诉求。这里不变的是比例语义与随机抽取机制，变化的是被分配的资源。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-ticket-generality"
          ]
        }
      },
      {
        "id": "model-summary",
        "moduleId": "check-and-transfer",
        "depth": "core",
        "kind": "summary",
        "title": "本点小结",
        "markdown": "比例份额调度把目标从优化周转或响应时间改成按比例分配 CPU；彩票数用比例表示每个进程应得的份额；每个时间片在总彩票数范围内随机抽取中奖号码，号码所在区间的进程获得运行机会；结果是概率性的，单次可能偏离，长期累计趋近期望；彩票机制还可以推广到内存等其他资源。",
        "provenance": {
