      {
        "id": "model-state-role",
        "moduleId": "state-and-tools",
        "depth": "support",
        "kind": "explanation",
        "title": "两个状态字段为什么必须分开",
        "markdown": "`input_file` 是当前文档的指针，`messages` 保存对话、AI 的工具调用和工具返回结果。把两者分开后，assistant 节点每一轮都能同时看到原始文件位置和完整交互历史。若只保留最后一条消息，第二轮总结就会丢失第一次工具调用返回的提取文本，模型只能凭记忆猜测文档内容。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-agent-state",
            "textbook-env-setup"
          ]
        }
