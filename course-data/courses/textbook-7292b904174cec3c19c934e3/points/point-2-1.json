{
  "id": "point-2-1",
  "title": "智能体框架介绍",
  "shortSummary": "说明智能体框架替代了哪些重复工程工作，以及当构建过程很简单时为何不必引入框架。",
  "keyTerms": [
    "智能体框架",
    "抽象",
    "复用",
    "选型"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.8,
  "prerequisites": [],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-comparison-decision",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于“何时不必用框架”的边界和六项工程需求，围绕选型判断补充对照维度与检查问题，不替教材扩充具体框架事实。",
      "estimatedMinutes": 10,
      "outcomes": [
        {
          "id": "explain-framework-value",
          "text": "解释智能体框架承担了哪些原本需要自己实现的重复工程工作。"
        },
        {
          "id": "decide-framework-use",
          "text": "针对一个具体应用情境，判断是否需要引入智能体框架并说明依据。"
        }
      ],
      "misconceptions": [
        "认为只要在应用里使用了大语言模型，就必须引入智能体框架。",
        "把引入框架当成必然升级，忽略了在简单提示链场景下纯代码更易控制和理解。"
      ],
      "modules": [
        {
          "id": "unit-orientation",
          "title": "进入智能体框架单元",
          "role": "motivation",
          "description": "交代本单元的主题和它与前面智能体基础的衔接。",
          "outcomeRefs": [
            "explain-framework-value"
          ],
          "order": 0
        },
        {
          "id": "framework-landscape",
          "title": "三个框架的全景",
          "role": "overview",
          "description": "先知道本单元要学的三个框架是什么，再逐个深入。",
          "outcomeRefs": [
            "explain-framework-value"
          ],
          "order": 1
        },
        {
          "id": "whether-to-use",
          "title": "先判断是否需要框架",
          "role": "concept-and-boundary",
          "description": "给出“不必用框架”的边界条件和反例。",
          "outcomeRefs": [
            "decide-framework-use"
          ],
          "order": 2
        },
        {
          "id": "recurring-work",
          "title": "框架替你承担的重复工作",
          "role": "mechanism",
          "description": "拆解教材列出的六项工程需求。",
          "outcomeRefs": [
            "explain-framework-value"
          ],
          "order": 3
        },
        {
          "id": "framework-comparison",
          "title": "三个框架的定位对照",
          "role": "comparison",
          "description": "用统一维度对照教材给出的三个框架定位。",
          "outcomeRefs": [
            "explain-framework-value",
            "decide-framework-use"
          ],
          "order": 4
        },
        {
          "id": "decision-guide",
          "title": "选型检查表",
          "role": "decision",
          "description": "把定位转成可操作的选型问题与取舍规则。",
          "outcomeRefs": [
            "decide-framework-use"
          ],
          "order": 5
        },
        {
          "id": "wrap-up",
          "title": "小结与下一步",
          "role": "summary",
          "description": "收束判断流程并桥接到 smolagents 单元。",
          "outcomeRefs": [
            "explain-framework-value",
            "decide-framework-use"
          ],
          "order": 6
        }
      ],
      "completion": {
        "outcomeRefs": [
          "explain-framework-value",
          "decide-framework-use"
        ],
        "method": "给出一个应用情境，先判断是否需要框架，再列出至少两类框架会替你承担的重复工作作为理由。",
        "successCriteria": [
          "判断结论与情境复杂度相符",
          "理由能对应教材列出的具体工程需求"
