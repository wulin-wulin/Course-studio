                "block-000015"
              ],
              "headingPath": [
                "第 1 单元. 智能体简介",
                "什么是大语言模型（LLMs）？",
                "注意力机制就是你的全部所需"
              ],
              "lineStart": 350,
              "lineEnd": 361,
              "assetRefs": [
                "https://huggingface.co/datasets/agents-course/course-images/resolve/main/en/unit1/AttentionSceneFinal.gif"
              ],
