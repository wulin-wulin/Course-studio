                "block-000062"
              ],
              "headingPath": [
                "计算机组成原理",
                "CAM"
              ],
              "lineStart": 1014,
              "lineEnd": 1021,
              "assetRefs": [],
              "excerptSha256": "244a91c76f34a072c59f69b4f74b8daf3834daa1bbeea6c547721cda275e6254"
            }
          ]
        }
      },
      {
        "id": "tb-cims",
        "moduleId": "cax-integration",
        "depth": "core",
        "kind": "application",
        "title": "教材：计算机集成制造系统 CIMS",
        "markdown": "计算机集成制造系统（Computer Integrated Manufacturing Systems，CIMS）是利用信息技术和现代管理技术改造传统制造业、加强新兴制造业、提高企业市场竞争能力的一种生产模式。\n\n具体而言，以企业选定的产品为龙头，在产品设计过程、管理决策过程、加工制造过程、产品质量管理和控制等过程中采用各种计算机辅助技术和先进的科学管理方法，在计算机网络和数据库的支持下实现信息集成，进而优化企业运行，达到产品上市快、质量好、成本低、服务好的目的。要形成 CIMS，企业必须广泛采用 CAD/CAE/CAPP/CAM，并且已经建立管理信息系统（Management Information System，MIS）；只有通过生产、经营各环节的信息集成支持技术集成，并由技术集成进入技术、经营管理和人员组织的集成，最终达到物流、信息流、资金流的集成并优化运行，才能提高市场竞争能力和应变能力。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-846b2541511be5b24c39dd42",
              "blockIds": [
                "block-000063"
              ],
              "headingPath": [
                "计算机组成原理",
                "CIMS"
              ],
              "lineStart": 1022,
              "lineEnd": 1025,
              "assetRefs": [],
              "excerptSha256": "c71f499e1ddf5b63db3fc938f6fb95bf85e48c6ebdaed6a9a159a9ae3e07de10"
