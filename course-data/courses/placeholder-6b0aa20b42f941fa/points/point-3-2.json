              "excerptSha256": "1f720f24b5a5970314277bf32c2f100bfa74c2c0b9f077035949ce7cb733c1ec"
            }
          ]
        }
      },
      {
        "id": "model-system-scope",
        "moduleId": "system-bus",
        "depth": "support",
        "kind": "misconception",
        "title": "补充：系统总线按连接对象判定",
        "markdown": "常见误解是“速度快的总线就是系统总线”。教材的划分依据是连接对象而不是速率：连接芯片内部寄存器与 ALU 的是片内总线；连接 CPU、主存、I/O 接口这些部件或插板的是系统总线。\n\n所以看到一条总线时，先问“两端分别是什么部件”，再问它传输的是数据、地址还是控制信息。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-system-bus"
          ]
        }
      },
      {
        "id": "tb-data-bus",
        "moduleId": "system-bus",
        "depth": "core",
        "kind": "mechanism",
        "title": "教材：数据总线",
        "markdown": "数据总线用来传输各功能部件之间的数据信息，它是双向传输总线，其位数与机器字长、存储字长有关，一般为 8 位、16 位或 32 位。数据总线的位数称为数据总线宽度，它是衡量系统性能的一个重要参数。\n\n教材的例子说明了位宽的影响：如果数据总线的宽度为 8 位，而指令字长为 16 位，那么 CPU 在取指阶段必须两次访问主存。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-846b2541511be5b24c39dd42",
              "blockIds": [
                "block-000074"
              ],
              "headingPath": [
                "计算机组成原理",
                "数据总线"
              ],
              "lineStart": 1153,
              "lineEnd": 1156,
              "assetRefs": [],
              "excerptSha256": "f004c00c1f90de964800ff1214181fd037556d2d79a2f56953bbe70d0fef82ba"
            }
          ]
        }
      },
      {
        "id": "model-data-direction",
        "moduleId": "system-bus",
        "depth": "support",
        "kind": "explanation",
        "title": "补充：数据总线为什么双向，以及两个宽度不要混淆",
        "markdown": "数据总线之所以是双向的，是因为一次访存既可能是读（数据从主存流向 CPU），也可能是写（数据从 CPU 流向主存），同一组数据线要承担两个方向的传输。\n\n还要区分两个宽度：数据总线宽度决定一次能并行搬运多少位数据；能寻址多少存储单元由地址线位数决定。把两者混为一谈，就无法解释“数据总线 8 位、地址线 20 根”的系统为什么能访问 $2^{20}$ 个单元。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-data-bus"
          ]
        }
      },
      {
        "id": "tb-address-bus",
        "moduleId": "direction",
        "depth": "core",
        "kind": "definition",
        "title": "教材：地址总线",
        "markdown": "地址总线主要用来指出数据总线上的源数据或目的数据在主存单元的地址或 I/O 设备的地址。例如，欲从存储器读出一个数据，则 CPU 要将此数据所在存储单元的地址送到地址线上；又如，欲将某数据经 I/O 设备输出，则 CPU 除了需将数据送到数据总线外，还需将该输出设备的地址（通常都经 I/O 接口）送到地址总线上。\n\n可见，地址总线上的代码是用来指明 CPU 欲访问的存储单元或 I/O 端口的地址，由 CPU 输出，单向传输。地址线的位数与存储单元的个数有关，如地址线为 20 根，则对应的存储单元个数为 $2^{20}$。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-846b2541511be5b24c39dd42",
              "blockIds": [
                "block-000075"
              ],
              "headingPath": [
