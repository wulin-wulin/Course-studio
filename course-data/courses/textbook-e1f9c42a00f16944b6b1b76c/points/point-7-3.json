                "parts/part-0004/images/04399e577314d4c518026f77646e2dd545d1e9a3b009db66338dceaef3c6143d.jpg",
                "parts/part-0004/images/1d99108f96eb590a97c5836e04866e2353e853199b22aa70b630fd56e2a66828.jpg"
              ],
              "excerptSha256": "ed71ad66cb9466a086bc2bbd965e7a8eeba283a6886524a54fcbd4162bea5ddd"
            }
          ]
        }
