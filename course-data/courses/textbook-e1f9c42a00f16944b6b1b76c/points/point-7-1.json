                "parts/part-0004/images/428beb6aca239c1ba93cecb2f832464be686006b2eafb87dd5965fedece2af6b.jpg",
                "parts/part-0004/images/01f3e5964a0d4153053b18c1df5b8016c62567f7fbf37d7e09d23a5fc1dd2155.jpg"
