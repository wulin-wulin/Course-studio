                "parts/part-0006/images/82cb23e5edd48d9396bbfdb96de05302837baece1c683494e7382d33e866f356.jpg"
              ],
              "excerptSha256": "e4348b0759583302c3126d7fe4c2303f71d5a93b435ba59135ab35ebd8ae8daf"
            }
