                "parts/part-0004/images/0d22e835147b6be6ccf26007a53b9ea1a9ccaf6ab0954cef3d5ca7fe83f0596b.jpg",
                "parts/part-0004/images/306511027770a72193576887c09bc439c27f37d99dca73142dad86ac1bc86e10.jpg",
                "parts/part-0004/images/28f1999ef7a1c36ba19ab1720b69b9e2d78d6afc0efb9a46a30322f631e01fd4.jpg",
                "parts/part-0004/images/75499ea676c8ac4239933cf190db1bd94237bf51c552a6d76be49d7528a32d41.jpg"
              ],
