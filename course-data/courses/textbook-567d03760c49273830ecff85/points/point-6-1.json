              "assetRefs": [
                "parts/part-0003/images/9b52b51b370b7ea3a76b5a1f190afc454bcd956366c6b2c61cf3bfca97601090.jpg",
                "parts/part-0003/images/a9f625c309bceed0cdabb1267e465a0baa365f7d127c968f7c787045eb97bbde.jpg"
              ],
              "excerptSha256": "d7dd26e35b97670f2916c5c539b581472cfed18b84b64f3e9ad01ed0fb291f2c"
            }
          ]
