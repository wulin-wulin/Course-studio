    "blocks": [
      {
        "id": "tb-task-definition",
        "moduleId": "mt-task",
        "depth": "core",
        "kind": "definition",
        "title": "机器翻译与序列转换",
        "markdown": "机器翻译（machine translation）指的是把序列从一种语言自动翻译成另一种语言。教材把它作为**序列转换模型**（sequence transduction）的核心问题：输入是长度可变的源语言序列，输出是长度可变的目标语言序列。\n\n这一研究领域可以追溯到数字计算机发明后不久的 20 世纪 40 年代，当时的工作与第二次世界大战中的语言编码破译相关。在神经网络端到端学习兴起之前，统计机器翻译长期占主导，它把翻译拆成翻译模型与语言模型等部分分别做统计分析；因此基于神经网络的方法被称为**神经机器翻译**（neural machine translation），以区别于统计方法。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-567d03760c49273830ecff85",
