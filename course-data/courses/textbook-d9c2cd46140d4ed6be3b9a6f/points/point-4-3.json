    "blocks": [
      {
        "id": "textbook-motivation",
        "moduleId": "clock-gating",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：从基本 RS 触发器到钟控触发器",
        "markdown": "基本 RS 触发器电路构造简单，具有清零、置 1 和保持功能，但输入端受电平直接控制：有效的输入信号直接决定输出端状态，不便于控制多个触发器，而且输入信号之间存在约束关系。\n\n为了克服输入信号直接控制输出的缺点，并更好地控制多个触发器的工作，教材引入由时钟脉冲控制的门电路，形成钟控触发器，主要讨论钟控 RS 触发器和钟控 D 触发器。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d9c2cd46140d4ed6be3b9a6f",
              "blockIds": [
                "block-000206"
              ],
              "headingPath": [
                "布尔代数和逻辑化简",
                "钟控触发器"
              ],
              "lineStart": 3532,
              "lineEnd": 3535,
