    "blocks": [
      {
        "id": "tb-ttl-role",
        "moduleId": "m-overview",
        "depth": "core",
        "kind": "definition",
        "title": "TTL 门电路与典型与非门的组成",
        "markdown": "TTL 是晶体管-晶体管逻辑门电路（Transistor-Transistor Logic）的简称，教材把它列为使用最广泛的一类门电路。\n\n典型的 TTL 与非门并不是一个孤立器件，而是把三部分电路级联起来：输入级、中间倒相级和输出级，如图 6-9 所示。三部分分工不同，但共同完成与非逻辑，因此读图时要先分清这三段，再沿着信号从输入走到输出。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d9c2cd46140d4ed6be3b9a6f",
              "blockIds": [
                "block-000307"
              ],
              "headingPath": [
                "布尔代数和逻辑化简",
                "TTL 门电路"
              ],
              "lineStart": 5644,
              "lineEnd": 5647,
              "assetRefs": [],
              "excerptSha256": "7152cd8b121461407bd44823e0536cb89b0f63deb46152377cab2f9fcfcfcb45"
            },
            {
