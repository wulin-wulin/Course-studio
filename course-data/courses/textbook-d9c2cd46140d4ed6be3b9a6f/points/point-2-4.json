              "excerptSha256": "03159ab7ad3ae4681bba409835298a1493cf0c36ed15a8a4fb75910ba3c3273a"
            }
          ]
        }
      },
      {
        "id": "tb-simplest-and-or-not",
        "moduleId": "simplest-forms",
        "depth": "support",
        "kind": "procedure",
        "title": "最简与或非式",
        "markdown": "**最简与或非式**：非号下面相加的乘积项最少，并且每个乘积项中相乘的变量也最少的与或非表达式。把最简或非-或非表达式中大非号下面的非号用摩根定律去掉即可：\n\n$$Y=\\overline{\\overline{A}\\overline{B}+AC}$$",
        "provenance": {
