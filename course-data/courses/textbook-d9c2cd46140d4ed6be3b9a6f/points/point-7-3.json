                "parts/part-0002/images/2bc0109082e1d18dbdf87e8050de91a171d9bbab55307ae34c61d8d63c71da78.jpg"
              ],
              "excerptSha256": "7e6d702178fef39921b9158e4f64d14844594db5e696bff2804f1afb7c1f0d4f"
            }
