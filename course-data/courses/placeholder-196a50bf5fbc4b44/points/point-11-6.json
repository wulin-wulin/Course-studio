              "lineEnd": 778,
              "assetRefs": [],
              "excerptSha256": "9095e477eb90637ae0c0430da31ba806cf3569685a4548db374d9181351c1867"
            }
          ]
        }
      },
      {
        "id": "model-dotenv-purpose",
        "moduleId": "production-env-config",
        "depth": "support",
        "kind": "explanation",
        "title": "模型补充：两项变量为何放在 .env",
        "markdown": "把变量放进 `.env` 而不是硬编码到源码，是为了让同一份代码读取不同环境各自的配置：密钥每套环境独立，数据库名称指向生产库。`SECRET_KEY` 必须现场用 `uuid` 生成随机值，因为基于它签名的会话数据一旦用了示例值或泄露的固定值，别人就能伪造身份。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-dotenv-config"
          ]
        }
      },
      {
        "id": "textbook-install-dependencies",
        "moduleId": "install-and-initialize",
        "depth": "core",
        "kind": "procedure",
        "title": "教材：安装依赖并执行初始化",
        "markdown": "配置写好后，安装依赖并执行初始化操作。教材同时提醒：先不要关闭这个命令行标签页，后面还要在这里执行其他命令。",
        "provenance": {
