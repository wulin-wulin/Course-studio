{
  "id": "point-1-5",
  "title": "设置 SSH 密钥",
  "shortSummary": "生成并配置 SSH 密钥，使本地 Git 能以密钥方式安全连接 GitHub，避免重复输入密码。",
  "keyTerms": [
    "SSH",
    "密钥",
    "GitHub"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.3,
  "prerequisites": [],
