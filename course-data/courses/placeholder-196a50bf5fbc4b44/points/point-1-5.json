    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "procedure",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材的密钥检查、生成与登记顺序，补充密钥对原理、易错点和完成自检，使步骤可独立执行。",
      "estimatedMinutes": 8,
      "outcomes": [
        {
          "id": "explain-ssh-role",
          "text": "解释 SSH 密钥为什么能替代推送远程仓库时重复输入用户名和密码，并区分公钥与私钥的分工。"
        },
        {
          "id": "generate-key-pair",
          "text": "先检查本机是否已有密钥，并在缺失时按默认值生成包含私钥与公钥的密钥对。"
        },
        {
          "id": "register-public-key",
          "text": "把公钥正确登记到 GitHub 的 SSH 设置中，并自检登记是否生效。"
        }
      ],
      "misconceptions": [
        "把私钥 id_rsa 上传或粘贴到 GitHub，误以为两个文件都要登记。",
        "只在本地生成密钥而不在 GitHub 添加公钥，却以为推送会自动免密。",
        "已有密钥时仍重复生成，覆盖掉原本可用的密钥对。"
      ],
      "modules": [
