      },
      {
        "id": "model-footer-note",
        "moduleId": "page-footer",
        "depth": "support",
        "kind": "explanation",
        "title": "页脚也是固定文字",
        "markdown": "页脚“© 2018 HelloFlask”同样是模板中的固定文字，与电影数据无关。它让页面在视觉上收尾，并标明站点信息；修改电影数据不会影响页脚内容。",
        "provenance": {
          "origin": "model",
