                "第 1 章：准备工作",
                "使用命令行"
              ],
              "lineStart": 9,
              "lineEnd": 16,
              "assetRefs": [],
              "excerptSha256": "6cf4fca4a066ed413845b369ced2322d1cb48d357db58274f9c71390671f47bc"
            }
          ]
        }
      },
      {
        "id": "working-directory-check",
        "moduleId": "core-commands",
        "depth": "support",
        "kind": "warning",
        "title": "确认自己处在正确的目录",
        "markdown": "`mkdir` 只负责创建目录，不会自动进入新目录；创建后仍需用 `cd` 切换。执行命令前先确认当前所在目录，能避免把文件建到错误位置。在 macOS/Linux 终端可用 `pwd` 打印当前目录，在 Windows 命令提示符中可用不带参数的 `cd` 查看当前路径；无论使用哪种终端，关注命令输出中的路径是否指向 `watchlist/` 即可。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "project-root"
          ]
        }
      },
      {
        "id": "windows-tools",
        "moduleId": "cross-platform",
        "depth": "core",
        "kind": "note",
        "title": "Windows 下的终端选择",
        "markdown": "教材建议 Windows 用户使用 cmder（基于 ConEmu 的终端模拟器）代替系统自带的 `cmd.exe`，或在安装 Git for Windows 后使用附带的 Git Bash。cmder 集成了 Git Bash，支持 `ls`、`cat`、`nano`、`ssh` 等在 Linux 或 macOS 下常见的命令，这些命令在后续章节中会用到。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-e0a0d38f117bfe9c05dd311f",
              "blockIds": [
                "block-000003"
              ],
              "headingPath": [
                "第 1 章：准备工作",
                "使用命令行"
              ],
              "lineStart": 9,
              "lineEnd": 16,
              "assetRefs": [],
              "excerptSha256": "6cf4fca4a066ed413845b369ced2322d1cb48d357db58274f9c71390671f47bc"
            }
          ]
        }
      },
      {
        "id": "cross-platform-comparison",
        "moduleId": "cross-platform",
        "depth": "support",
        "kind": "comparison",
        "title": "三种常见终端入口的取舍",
        "markdown": "| 入口 | 适用平台 | 特点 |\n|---|---|---|\n| `cmd.exe` | Windows | 系统自带，命令集与类 Unix 终端不同 |\n| cmder / Git Bash | Windows | 提供 `ls`、`cat`、`nano`、`ssh` 等类 Unix 命令，便于跟随教材 |\n| Terminal | macOS / Linux | 系统自带终端，直接使用类 Unix 命令 |\n\n选择的原则不是“哪个更高级”，而是能否稳定执行教材给出的命令。若你主要在 Windows 上学习，使用 cmder 或 Git Bash 可以减少命令差异带来的困惑。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "windows-tools",
            "terminal-role"
          ]
        }
      },
      {
        "id": "practice-exercise",
        "moduleId": "practice-check",
        "depth": "core",
        "kind": "exercise",
        "title": "练习：准备好 watchlist 工作目录",
        "markdown": "1. 打开适合你操作系统的终端。\n2. 用 `whoami` 确认当前用户。\n3. 用 `mkdir watchlist` 创建项目文件夹。\n4. 用 `cd watchlist` 进入该文件夹。\n5. 确认当前路径指向 `watchlist/`，再执行教材给出的 Python 安装测试命令，观察是否报错。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "whoami-and-nav",
            "project-root",
            "windows-tools"
          ]
        }
      },
      {
        "id": "summary-bridge",
        "moduleId": "practice-check",
        "depth": "support",
        "kind": "summary",
        "title": "小结与下一步",
        "markdown": "命令行是本书所有后续操作的基础：你需要在其中创建并进入项目目录、确认环境，再运行 Python 与 Flask 相关命令。记住两个要点即可迁移到新任务：命令在当前工作目录下执行；`mkdir` 创建目录后还要 `cd` 进入。下一节将在此基础上使用 Git 管理 `watchlist/` 项目。",
        "provenance": {
          "origin": "model",
