        }
      },
      {
        "id": "model-maintenance",
        "moduleId": "maintenance",
        "depth": "core",
        "kind": "summary",
        "title": "补充：把维护变成清单",
        "markdown": "部署不是终点。可按固定节奏做三件事：拉取代码后先跑测试，再重载应用；每次更新后查看日志，确认没有新增异常；按流量变化评估是否需要调整配置。把这三步写成清单，线上维护就从一次性操作变成可重复的流程。需要比较传统部署与云部署的差异时，再按教材提到的资料继续深入。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-further-reading",
            "tb-logs-traffic",
            "model-observability"
          ]
        }
      }
    ],
