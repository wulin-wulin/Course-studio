    "learningDesign": {
      "primaryPattern": "procedure-with-verification",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材的 extends 与 block 讲解顺序和术语，围绕“能动手写出子模板”补充代码骨架、覆盖与追加的取舍规则和迁移检查清单。",
      "estimatedMinutes": 10,
      "outcomes": [
        {
          "id": "explain-extends",
          "text": "解释 extends 标签在子模板中的作用，并说明它应写在模板的什么位置。"
        },
        {
          "id": "apply-block",
          "text": "在子模板中定义与基模板同名的 block，把页面内容填到基模板对应位置。"
        },
        {
          "id": "choose-super",
          "text": "判断某个块应该直接覆盖，还是在子块中用 super() 追加父块内容。"
        },
        {
          "id": "migrate-page",
          "text": "把主页或错误页面改成继承基模板的子模板，并核对渲染结果。"
        }
      ],
      "misconceptions": [
        "以为声明 extends 之后，子模板里仍要重复编写完整的 HTML 骨架。",
        "把定义同名块理解成默认追加内容，忽略教材强调的默认覆盖行为。",
        "以为子模板覆盖一个块会连带清空基模板中的其他块。"
      ],
