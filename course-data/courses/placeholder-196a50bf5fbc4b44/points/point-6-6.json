{
  "id": "point-6-6",
  "title": "编写子模板",
  "shortSummary": "让子模板继承基础模板并覆盖区块，组织主页与错误页面等具体页面。",
  "keyTerms": [
    "子模板",
    "extends",
    "block"
  ],
