              "excerptSha256": "29e2910746e4d50a013cb627ca9f22ad771edf9bb9bb24a3ce9bdad18ca87038"
            }
          ]
        }
      },
      {
        "id": "model-observe-workflow",
        "moduleId": "debug-observe-state",
        "depth": "support",
        "kind": "worked-example",
        "title": "命中断点后看什么",
        "markdown": "程序在断点处停下后，按“位置—寄存器—数据”的顺序检查：\n\n1. 看反汇编窗口和 PC 寄存器，确认程序停在自己预期的语句上；\n2. 打开寄存器窗口，核对相关寄存器的值是否符合预期；\n3. 用变量观察窗口或存储器窗口，按地址查看目标数据。\n\n把这三件事对应起来，才能判断问题出在控制流走错，还是数据本身不对。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-observe-windows"
          ]
        }
      },
      {
        "id": "textbook-reload-reset",
        "moduleId": "debug-reset-and-check",
