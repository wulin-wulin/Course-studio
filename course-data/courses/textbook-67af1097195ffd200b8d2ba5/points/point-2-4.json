        {
          "id": "governance-mapping",
          "text": "说明法规、标准与技术方案如何分层回应应用安全风险。"
        },
        {
          "id": "case-evaluation",
          "text": "依据行业案例判断防护覆盖了哪些环节、还存在哪些盲区。"
        }
