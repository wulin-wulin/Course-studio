              "assetRefs": [],
              "excerptSha256": "89491beaa5839ba03baf0dac56155b23424b99c3a055f89f084033a1d7a32378"
            }
          ]
        }
      },
      {
        "id": "model-build-project-faq",
        "moduleId": "answers-as-knowledge",
        "depth": "support",
        "kind": "application",
        "title": "把答疑安排进计划",
        "markdown": "对规划而言，这意味着“回答问题”本身也是可以安排的工作。把重复出现的问题登记成 issue，再把结论写回描述或文档，就把一次性的答疑变成了可以复习的资产。安排计划时可以为这类维护工作留出固定位置，而不是把它当成随时打断开发者的偶发干扰。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "issue-answers-as-docs"
          ]
        }
      },
      {
        "id": "practice-classify-issues",
        "moduleId": "practice-and-check",
        "depth": "core",
        "kind": "exercise",
        "title": "练习：为三个描述安排处理",
        "markdown": "一个两人协作的小项目收到下面三条记录，请分别判断它们属于哪一类 issue，并说明理由：\n\n1. “在 macOS 上安装后，命令行工具启动时提示找不到配置文件。”\n2. “希望加一个 `--verbose` 选项，打印每一步处理的文件名。”\n3. “这个项目以后会支持 Python 3.11 吗？”\n\n对每一条，再写出为了让它可被规划，你会优先补全哪些字段（至少包括状态、负责人和描述），以及哪一条最适合在解决后整理进项目文档。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "three-kinds-of-issues",
            "issue-fields-table",
            "issue-answers-as-docs"
          ]
        }
      },
      {
        "id": "planning-summary",
        "moduleId": "practice-and-check",
        "depth": "support",
        "kind": "summary",
        "title": "本点小结",
        "markdown": "回看这个知识点：规划不是额外的表格，而是把待办任务、待修问题和待讨论的问题放进同一个可检索、可分配、可追踪状态的地方。一条 issue 的标题、状态、负责人和描述越清楚，团队对范围与进度的认识就越少依赖口头确认；把有价值的问答沉淀在 issue 里，还能让后来的成员直接复用结论。下一知识点将讨论如何写出好的缺陷报告。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "issue-tracking-intro",
            "issue-fields-table",
            "three-kinds-of-issues",
            "issue-answers-as-docs"
          ]
        }
      }
