{
  "id": "point-5-6",
  "title": "Bug Reports",
  "shortSummary": "编写可复现的缺陷报告，包含运行环境、复现步骤、预期结果和实际结果，减少来回追问。",
  "keyTerms": [
    "缺陷报告 bug report",
    "复现步骤 reproduction",
    "预期结果",
    "实际结果"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.8,
  "prerequisites": [],
  "origin": "textbook",
  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "procedure-with-checklist",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材的六步提交流程与社区规范，补充可操作的字段表、裁剪示例和提交前检查表，使学习者能直接写出可复现的报告。",
      "estimatedMinutes": 15,
      "outcomes": [
        {
          "id": "explain-report-purpose",
          "text": "说明缺陷报告的目的，以及一份合格报告应回答哪些问题。"
        },
        {
          "id": "write-reproducible-report",
          "text": "按标题、复现步骤、预期与实际结果、环境和附件撰写可复现的缺陷报告。"
        },
        {
          "id": "self-check-and-split",
          "text": "提交前自检问题是否确为缺陷，并把多个问题拆成独立报告。"
        }
      ],
      "misconceptions": [
        "认为报告只要描述“程序坏了”就够了，复现步骤可以省略。",
        "把多个互不相关的问题写进同一条报告，导致无法逐项修复和关闭。",
        "认为信息不全的报告不值得回应，忽略了提交者可能只能提供有限信息。"
      ],
      "modules": [
