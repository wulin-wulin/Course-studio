          "description": "按教材清单组织标题、描述、附件、环境和日志。",
          "outcomeRefs": [
            "write-reproducible-report"
          ],
          "order": 2
        },
        {
          "id": "splitting-and-community",
          "title": "拆分问题与社区回应",
          "role": "procedure",
          "description": "一问题一报告，用模板降低填写门槛，并对信息有限的提交者保持善意。",
          "outcomeRefs": [
            "self-check-and-split",
            "write-reproducible-report"
          ],
          "order": 3
        },
        {
          "id": "checklist-and-practice",
          "title": "提交前检查与改写练习",
          "role": "assessment",
          "description": "用检查表核对报告，并把一条含糊报告改写成合格版本。",
