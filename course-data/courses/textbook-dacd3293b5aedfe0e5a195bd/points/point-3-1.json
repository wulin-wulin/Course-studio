      "estimatedMinutes": 12,
      "outcomes": [
        {
          "id": "explain-why-configure",
          "text": "解释版本控制的提交记录为什么需要作者身份，以及该身份由哪个设置提供。"
        },
        {
          "id": "set-identity-globally",
          "text": "用 git config --global 正确设置姓名和邮箱，并说明各部分的含义。"
        },
        {
          "id": "verify-and-setup-check",
          "text": "用 git config --list 核对配置，并能判断和修复常见的配置错误。"
        }
      ],
      "misconceptions": [
        "把 --global 设置当成只对当前项目生效，换到别的项目后发现身份缺失。",
        "以为每次提交前都要重新运行 git config；实际上全局配置只需运行一次。"
      ],
