{
  "id": "point-3-1",
  "title": "Setting Up",
  "shortSummary": "配置 Git 的用户名、邮箱和换行处理等全局选项，为后续提交、协作和历史记录建立一致基础。",
  "keyTerms": [
    "Git 配置",
    "用户名与邮箱",
    "换行处理 line endings",
    "git config"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.7,
