              "assetRefs": [],
              "excerptSha256": "529a398d74ff85ea042b0e1a39cc2e8a26e72b758fa7db91ef438119dcb56a04"
            }
          ]
        }
      },
      {
        "id": "model-read-active-branch",
        "kind": "comparison",
        "title": "判断当前在哪个分支",
        "moduleId": "branch-visibility",
        "depth": "support",
        "markdown": "与其记住某个仓库的默认分支叫什么，不如养成“先查看、再操作”的习惯：运行 `git branch`，看哪一行带 `*`，那一条就是你接下来提交会推进的分支。无论仓库用的是 `master`、`main` 还是被改过的名字，`*` 标记的含义完全一致——它标出的是你当前所在的位置，而不是某个固定名称。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-git-branch-command",
            "textbook-default-branch-note"
          ]
        }
      },
      {
        "id": "textbook-plotcounts-example",
        "kind": "example",
        "title": "教材示例：在独立分支上试验曲线拟合",
        "moduleId": "worked-scenario",
        "depth": "core",
        "markdown": "`zipf` 项目里有一个用于画词频图的 `plotcounts.py`。之前生成的图看起来是线性的，但眼睛容易被骗，教材认为应该给数据拟合一条曲线。这会显著改动脚本，为了在尝试新版本时不破坏现有可用的 `plotcounts.py`，教材把这项工作放到一个单独的分支上进行；等曲线拟合成功加入后，再决定是否把改动合并回主线。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
