                "block-000257"
              ],
              "headingPath": [
                "自然语言处理：应用",
                "情感分析及数据集",
                "创建数据迭代器"
              ],
              "lineStart": 13902,
              "lineEnd": 13936,
              "assetRefs": [],
              "excerptSha256": "ddb8ef8063f93254d828bec0c1de5aec25343c83522c8d61a630a49cd625db2f"
            }
          ]
        }
      },
      {
        "id": "model-batch-shape",
        "moduleId": "pipeline",
        "depth": "support",
        "kind": "note",
        "title": "模型补充：读懂批次的形状",
        "markdown": "特征的第一维是样本数，第二维是时间步，这正是后面循环网络和卷积网络接受的输入布局；标签是长度为批大小的一维向量，与每个样本一一对应。\n\n理解这一点后，训练循环里要做的事就很直接：把 `X` 送进模型得到预测，把 `y` 送进损失函数计算误差。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "data-iterator"
          ]
        }
      },
      {
        "id": "integrated-loader",
        "moduleId": "pipeline",
        "depth": "core",
        "kind": "procedure",
        "title": "整合代码：一个函数完成全部准备",
        "markdown": "教材最后把上述步骤封装成 `load_data_imdb(batch_size, num_steps=500)`：它下载并解压数据集，读取训练集和测试集，词元化后只用训练词元构建 `min_freq=5` 的词表，用同一个词表把两个集合都截断填充到 `num_steps`，再分别创建训练迭代器和测试迭代器，最后返回 `train_iter`、`test_iter` 和 `vocab`。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-945d2620c63addae20887a5d",
