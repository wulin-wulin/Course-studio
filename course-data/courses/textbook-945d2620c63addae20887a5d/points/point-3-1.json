        "type": "formative-check",
        "anchorBlockId": "model-cue-contrast",
        "moduleId": "two-cue-framework",
        "depth": "core",
        "title": "判断注意力提示的来源",
        "outcomeRefs": [
          "distinguish-cues"
        ],
        "learningPurpose": "检查学习者能否把突出性驱动的注意与意识驱动的注意分开。",
        "grounding": {
          "basedOnBlockIds": [
            "tb-two-component"
          ]
        },
        "config": {
          "scenario": "桌上有一杯红色的咖啡和一本黑白印刷的书。",
          "prompt": "分别指出下面两种情况由哪类注意力提示驱动。",
          "items": [
            {
              "id": "salient",
              "text": "视线不由自主地被红色咖啡杯吸引",
              "expected": "non-autonomous"
            },
            {
              "id": "volitional",
              "text": "喝咖啡后主动转头去找书",
              "expected": "autonomous"
            }
          ]
        },
        "fallback": {
          "type": "markdown",
          "markdown": "红色咖啡杯因为突出性吸引视线，属于非自主性提示；喝咖啡后主动转头看书受意识控制，属于自主性提示。"
        }
      },
      {
        "id": "qkv-role-check",
        "type": "formative-check",
        "anchorBlockId": "model-qkv-example",
        "moduleId": "query-key-value",
        "depth": "core",
        "title": "为查询匹配键和值",
        "outcomeRefs": [
          "map-query-key-value"
        ],
        "learningPurpose": "检查学习者能否把解码器当前状态与编码器各位置表示对应到查询、键和值。",
        "grounding": {
          "basedOnBlockIds": [
            "tb-qkv"
          ]
        },
        "config": {
          "prompt": "在机器翻译解码时，把当前解码状态、编码器位置表示分别对应到查询、键和值。",
          "items": [
            {
              "id": "query",
              "text": "当前解码状态（自主性提示）",
              "expected": "query"
            },
            {
              "id": "key",
              "text": "编码器位置表示中用于与查询比较的部分",
              "expected": "key"
            },
