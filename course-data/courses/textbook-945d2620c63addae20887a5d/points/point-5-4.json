              ],
              "headingPath": [
                "自然语言处理：应用",
                "自然语言推断与数据集",
                "斯坦福自然语言推断（SNLI）数据集",
                "[**读取数据集**]"
              ],
              "lineStart": 14793,
              "lineEnd": 14840,
              "assetRefs": [],
              "excerptSha256": "ae179062c90c3dda09dede89b4e43c05c8f6bcbf1b7f70478610ce029fc0aab0"
