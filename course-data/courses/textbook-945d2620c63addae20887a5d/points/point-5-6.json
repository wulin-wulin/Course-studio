              "lineEnd": 15636,
              "assetRefs": [
                "https://raw.githubusercontent.com/d2l-ai/d2l-zh/e6b18ccea71451a55fcd861d7b96fddf2587b09a/img/bert-two-seqs.svg"
              ],
              "excerptSha256": "e1df79ed8987f8caabeeafec4971a441c99e59de27cfe7833e6586def503229d"
            }
          ]
        }
