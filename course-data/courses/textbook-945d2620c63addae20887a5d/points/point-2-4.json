                "block-000091"
              ],
              "headingPath": [
                "现代循环神经网络",
                "双向循环神经网络",
                "双向模型"
              ],
              "lineStart": 4710,
              "lineEnd": 4731,
              "assetRefs": [
                "https://raw.githubusercontent.com/d2l-ai/d2l-zh/e6b18ccea71451a55fcd861d7b96fddf2587b09a/img/birnn.svg"
              ],
              "excerptSha256": "179a538ab21a574ec146849ddf2f549f85eb0365b3e3cfad50396e68f8a87a25"
            }
          ]
        }
