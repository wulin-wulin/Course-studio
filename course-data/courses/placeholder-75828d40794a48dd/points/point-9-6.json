                "parts/part-0004/images/e92d51aa8c4f56673d639fe67e1dd26b6ad1388334ba9e347d165f17c57a6157.jpg",
                "parts/part-0004/images/0a14e4cdff045674e33d90cc280a0dbd66294aa02b96290cdd9f50205549e97e.jpg"
