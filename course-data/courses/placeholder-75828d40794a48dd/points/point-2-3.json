                "parts/part-0001/images/843fbec4f3c96c2aaa317c4cfdafb851679d5d454b5309bc181bc17c251192ba.jpg",
                "parts/part-0001/images/f4b13e1ec3f5df52d1c0c881193633321a5da75e0feb626a39060b8f3c1e3dad.jpg"
