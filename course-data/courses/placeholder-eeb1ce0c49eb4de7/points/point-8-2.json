              ],
              "lineStart": 7056,
              "lineEnd": 7070,
              "assetRefs": [
                "parts/part-0003/images/df0a1148504948cb6091170ea05fdf5952a2c08ff8f99d2ac447373ad74cfc0d.jpg",
                "parts/part-0003/images/fa45f3d6049dd5c74eaf53678d52dab2da186354b8d3e01f60007bb7a49934f5.jpg"
              ],
