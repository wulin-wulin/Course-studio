              "assetRefs": [],
              "excerptSha256": "f2020ace44149c2581ce0df087c0f8aa260e49f8445fda345ca5e8e3de3b1090"
            }
          ]
        }
      },
      {
        "id": "textbook-pipeline-role",
        "moduleId": "pipeline-efficiency",
        "depth": "core",
        "kind": "explanation",
        "title": "教材讲解：裁剪在观察流水线中的作用",
        "markdown": "裁剪最多应用于观察流水线，目的是从二维或三维场景中提取指定部分显示在输出设备上。在二维观察函数中，裁剪算法用来识别裁剪窗口内的图形部分，窗口外的内容会从送往输出设备的场景中消除。对裁剪窗口的规范化边界执行裁剪，是观察流水线中高效的裁剪方式；由于可以在裁剪前合并所有几何变换和观察变换矩阵再作用于场景描述，计算量会显著减少。裁剪后的场景再送到屏幕坐标系做最后处理。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-abebc170f9271e4546887278",
              "blockIds": [
                "block-000282"
              ],
              "headingPath": [
                "计算机图形学(第四版)",
                "裁剪算法"
              ],
              "lineStart": 7498,
              "lineEnd": 7521,
              "assetRefs": [],
              "excerptSha256": "f2020ace44149c2581ce0df087c0f8aa260e49f8445fda345ca5e8e3de3b1090"
            }
          ]
        }
      },
      {
        "id": "model-pipeline-efficiency",
        "moduleId": "pipeline-efficiency",
        "depth": "support",
        "kind": "mechanism",
        "title": "模型补充：为什么在规范化边界上裁剪更省",
        "markdown": "把裁剪放在规范化边界上执行有两个直接好处。第一，四条边界的比较条件固定，算法不必为每个对象重复推导窗口方程；第二，多个几何与观察变换可以先合成一个矩阵，再统一作用于对象，避免在中间坐标空间反复求交。因此“先合并变换、再裁剪”通常比逐阶段裁剪更省计算。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-pipeline-role",
            "textbook-clip-region"
          ]
        }
      },
      {
        "id": "textbook-other-uses",
        "moduleId": "pipeline-efficiency",
        "depth": "support",
        "kind": "application",
        "title": "教材列举：裁剪的其他用途",
        "markdown": "裁剪也用于对象边界的反走样、用实体建模法构造对象、管理多窗口环境，以及在绘画程序中移动、复制或擦除图的一部分。",
        "provenance": {
