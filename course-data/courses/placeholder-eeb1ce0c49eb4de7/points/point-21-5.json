              "assetRefs": [],
              "excerptSha256": "f4d06ab2647dcc02fa71d94418ecccd8c197034eab2426e37879440f63be08ad"
            }
          ]
        }
      },
      {
        "id": "model-radiosity-mechanism",
        "moduleId": "radiosity",
        "depth": "support",
        "kind": "comparison",
        "title": "能量平衡与视点关系",
        "markdown": "辐射度把表面看成接收和发射能量的片元，求解的是表面之间的能量平衡，因此结果描述的是场景自身的光照分布，与从哪个位置观察无关；光线跟踪则从像素出发，结果与视点相关。逐步求精先处理贡献最大的表面，用部分解快速得到可看的中间结果，再迭代补足。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-radiosity",
            "textbook-ray-tracing"
          ]
        }
      },
      {
        "id": "textbook-environment-mapping",
        "moduleId": "environment-mapping",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：环境映射",
        "markdown": "环境映射是一种全局光照效果的快速近似方法。它使用一个环境阵列来存储场景中的背景光强度信息，然后根据特定的观察方向将该阵列映射到场景中的对象表面。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
