                "parts/part-0001/images/3078bf2896e2b79bc7f76161c5012ef04a5fa5f5f7b883e06e855915717f21c9.jpg",
                "parts/part-0001/images/614b32ac99046d6474a0a7936d0211a79763fe8383c6ffe35fbc4961d0b8e12a.jpg",
                "parts/part-0001/images/e75681a5cf3578b1211498f79fc48f99f4638455db3af2d8e06f3fed7f2c6865.jpg"
