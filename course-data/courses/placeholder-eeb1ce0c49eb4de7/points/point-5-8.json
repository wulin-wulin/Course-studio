      {
        "id": "tb-attribute-basics",
        "moduleId": "attribute-overview",
        "depth": "core",
        "kind": "definition",
        "title": "曲线属性沿用线段参数",
        "markdown": "曲线属性的参数与线段相同：可以为曲线指定各种颜色、宽度、点划线模式和画笔或笔刷选择。属性如何落到画面上由绘制曲线的算法决定，这一点与画直线类似。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
