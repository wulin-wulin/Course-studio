                "parts/part-0003/images/3688b1afb1154739c8c925e401c3d7bec6fe66bdd968af73d5b5b47a44e8a1ea.jpg",
                "parts/part-0003/images/81637ec338c3ebe6be0f895f598d68b16af7ecf4dac1f65497962497c1f6b678.jpg",
                "parts/part-0003/images/9f12227dca91f8eae52ae6c1c4e9aaeb8cc18e0c155861f0f978d0aa2f001961.jpg"
              ],
              "excerptSha256": "86937efb577d668ff44a3a673ccdc9619bbc49542f178291126a7549c1e5ddd1"
