                "parts/part-0005/images/fa49e8702412a7da9b3c4cb40ddd46a65ecb61a2752bf5aafda8ea6b1dec3bd1.jpg"
              ],
              "excerptSha256": "a0d95080ae27f59b45fad4ee0af7036da5ec5cfb02d343b70e5cacabf6c5f9c2"
            }
          ]
