                "parts/part-0003/images/2e7662458408dc0eae60ddf5da88db929e09f66a5b851747c5bb299be7ee21a7.jpg",
                "parts/part-0003/images/85ede3e5e415110867d9fc9bcbfae21512f802625fd2085c2fb28894fb4b72af.jpg",
                "parts/part-0003/images/bae4f4894d3ef21d65d047acf6ebc8232e7ee95afd80ee26cc9a40713ac22a66.jpg",
                "parts/part-0003/images/631ec8fe2592fb779ebccbc2d402769c8db985f396a4e1af43e94fd783c21541.jpg",
