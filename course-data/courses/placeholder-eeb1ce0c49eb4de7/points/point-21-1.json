                "parts/part-0006/images/64366b7745976b5db2af905d577649971bead7f307c4b074ed6e16f63ebbc315.jpg",
                "parts/part-0006/images/3dacf0737d1d9df0eebb87d488e10cf4cc9e1c136f6e1a7c610b3e8641879ebd.jpg",
                "parts/part-0006/images/4d12142976242f8ac6c86d9072075ee016cbdfd7dcce6c90ddcbb647f83e786a.jpg"
              ],
              "excerptSha256": "a3b9d60e7fadc2dd181d19f70051c7fdc95e922ed123fe996a0acfbd4c94915b"
