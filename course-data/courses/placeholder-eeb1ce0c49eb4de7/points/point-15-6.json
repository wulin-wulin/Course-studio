    "learningAssets": [
      {
        "id": "hooke-direction-check",
        "type": "formative-check",
        "moduleId": "hooke-quantitative",
        "depth": "core",
        "title": "胡克定律方向与大小检查",
        "anchorBlockId": "model-hooke-sign",
        "outcomeRefs": [
          "apply-hooke-force"
        ],
        "learningPurpose": "检查学习者能否把公式中的负号、外力与弹簧常数分别对应到方向和大小，而不是只记住式子。",
        "grounding": {
          "basedOnBlockIds": [
            "textbook-hooke",
            "textbook-spring-network"
          ]
        },
        "config": {
          "attempts": 2,
