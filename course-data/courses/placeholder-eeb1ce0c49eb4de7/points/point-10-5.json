      "primaryPattern": "concept-comparison-application",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于投影时机、平行投影与透视投影的定义和比例性质，围绕情境选择补充直觉类比、对比表与判断练习。",
      "estimatedMinutes": 18,
      "outcomes": [
        {
          "id": "explain-projection-role",
          "text": "说明投影变换在观察流水线中的作用和发生时机。"
        },
        {
          "id": "distinguish-parallel-perspective",
          "text": "区分平行投影与透视投影在投影线走向、比例保持和远近尺寸上的差异。"
        },
        {
          "id": "choose-projection-for-context",
          "text": "根据工程制图或真实感显示等情境选择合适的投影方式并说明依据。"
        }
      ],
      "misconceptions": [
        "认为投影只影响对象在画面中的位置，不会改变不同深度对象的相对大小。",
        "认为平行投影会像透视投影那样让远处对象明显变小。",
        "认为透视投影仍然保持对象的相关比例。"
      ],
