      {
        "id": "handedness-compare",
        "moduleId": "handedness-boundary",
        "depth": "support",
        "kind": "comparison",
        "title": "补充对照：两套手性约定",
        "markdown": "可以用一张对照表记住约定差异：建模坐标和世界坐标采用标准右手系，适合按数学习惯描述三维几何；规范化坐标和屏幕坐标采用左手系，更贴近屏幕观察的习惯。判断深度方向时不能把两套约定混用，否则会把靠近或远离观察位置的方向理解反。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "handedness"
          ]
        }
      },
      {
        "id": "apply-exercise",
        "moduleId": "apply-check",
        "depth": "core",
        "kind": "exercise",
        "title": "检查：坐标阶段、范围与手性",
