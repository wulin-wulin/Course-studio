    "blocks": [
      {
        "id": "tb-character-role-and-typeface",
        "moduleId": "text-role-and-terms",
        "depth": "core",
        "kind": "definition",
        "title": "字符图元与字样",
        "markdown": "图形显示中经常需要文字信息，例如图表上的标记、建筑或车辆上的牌号，以及模拟与可视化应用中的标识。多数图形软件包都提供生成字符图元的子程序，但支持程度差别很大：有的系统提供庞大的字符函数集，有的只提供有限支持。\n\n字母、数字和其他字符可以显示成不同的大小和风格。一组字符的完整设计风格称为**字样（typeface）**，目前有上百种字样可供应用程序使用，常见的有 Courier、Helvetica、New York、Palatino 和 Zapf Chancery 等。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-abebc170f9271e4546887278",
