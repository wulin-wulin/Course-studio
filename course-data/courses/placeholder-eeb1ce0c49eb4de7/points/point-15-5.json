      },
      {
        "id": "model-summary",
        "moduleId": "check-and-summary",
        "depth": "support",
        "kind": "summary",
        "title": "模型补充：小结",
        "markdown": "BSP 树用任意位置与方向的平面把场景二分，递归形成前后层次；相比八叉树，它的价值在于自适应细分、可能更浅的树，以及由此带来的可见面识别与光线追踪加速。\n\n代价是构造时的平面选择与多边形切分，因此它主要适合几何相对固定的场景。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
