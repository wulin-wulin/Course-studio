      {
        "id": "tb-chapter-context",
        "moduleId": "need-and-definition",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：第15章为何另设其他三维表示",
        "markdown": "教材指出，边界表示的方法（包括多边形、二次曲面、超二次曲面和样条）已在前面的章节讨论过，第15章转而介绍另外几种实体建模方法。其中，运用相互作用力的基于物理建模可以描述形状和表面特征随运动或受到邻近物体影响而改变的非刚性行为，例如一块布或一个胶状球；空间分区表示用来描述内部性质，把包含对象的空间区域划分成一组较小的、非重叠的连续实体。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-abebc170f9271e4546887278",
              "blockIds": [
                "block-000487"
              ],
              "headingPath": [
                "计算机图形学(第四版)",
                "其他三维对象的表示"
              ],
