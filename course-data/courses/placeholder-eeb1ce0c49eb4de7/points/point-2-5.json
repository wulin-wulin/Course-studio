                "硬拷贝设备"
              ],
              "lineStart": 1237,
              "lineEnd": 1255,
              "assetRefs": [
                "parts/part-0001/images/8a9401c8147079786780633ad502a5bd23fe3a86257e1f8a69166abc46fab30e.jpg"
              ],
              "excerptSha256": "fa60dda8d11680f40c62592635639d8b0844a234f64dc1b4eb3d307fb07bae93"
            }
          ]
        }
      },
      {
        "id": "plotter-selection",
        "moduleId": "color-and-plotters",
        "depth": "support",
        "kind": "comparison",
        "title": "补充：喷墨绘图仪与笔式绘图仪的选择",
        "markdown": "| 选择维度 | 喷墨绘图仪 | 笔式绘图仪 |\n|---|---|---|\n| 成像方式 | 按打印行喷射青、品红、黄墨水 | 用一支或多支笔在纸上画线 |\n| 颜色与线宽 | 依靠三色组合形成彩色图案 | 通过更换不同颜色和粗细的笔获得线型与阴影 |\n| 更适合 | 需要彩色填充或较宽色彩范围的图面 | 以线型、线宽表达为主的工程线图 |\n\n当图纸主要靠线条和线宽传达信息时，笔式绘图仪的多种笔更直接；当需要较宽彩色范围或大面积着色时，喷墨绘图仪更合适。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "pen-plotters",
            "color-output"
          ]
        }
      },
      {
        "id": "check-transfer",
        "moduleId": "check-transfer",
        "depth": "core",
