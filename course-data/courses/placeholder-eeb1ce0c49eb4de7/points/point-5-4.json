      "primaryPattern": "concept-boundary-example",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材关于点属性、状态表取值和光栅点大小的原意，围绕易混边界补充像素开销解释与情境化检查。",
      "estimatedMinutes": 9,
      "outcomes": [
        {
          "id": "explain-point-attributes",
          "text": "说明点的颜色与大小两个属性，以及它们在状态系统中由属性表当前值决定的方式。"
        },
        {
          "id": "interpret-raster-sizing",
          "text": "解释光栅系统中点大小是像素整数倍、大点显示为像素方块的含义。"
        },
        {
          "id": "apply-attribute-impact",
          "text": "在具体绘制情境中判断点大小和颜色对可见性与渲染开销的影响。"
        }
      ],
      "misconceptions": [
        "把点当成没有尺寸的数学点，认为点的大小不会改变屏幕上实际覆盖的区域。",
        "认为光栅系统中的点可以显示成任意连续尺寸，忽略了点大小是像素大小的整数倍。",
        "认为点的颜色只能由 RGB 分量直接给出，忽略了颜色表索引这种取值方式。"
      ],
