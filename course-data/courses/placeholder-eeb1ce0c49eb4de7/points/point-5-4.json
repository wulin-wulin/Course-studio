{
  "id": "point-5-4",
  "title": "点的属性",
  "shortSummary": "介绍点的大小、颜色和形状等属性及其对点图元显示效果、可见性和渲染开销的影响。",
  "keyTerms": [
    "点属性",
    "点大小",
    "颜色"
  ],
  "animationType": "none",
  "difficulty": "基础",
