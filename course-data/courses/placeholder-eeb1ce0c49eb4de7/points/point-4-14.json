{
  "id": "point-4-14",
  "title": "图形分割",
  "shortSummary": "解释图形分割如何把复杂图元分解为可处理的子图元，并说明它在裁剪、填充和绘制中的作用。",
  "keyTerms": [
    "图形分割",
    "子图元",
    "裁剪"
  ],
  "animationType": "none",
