                "parts/part-0001/images/3b2395e7f9bfd3dfee31651bf7e4411d3a741b58acea163686e44f2b0b101226.jpg",
                "parts/part-0001/images/b37d6d352d490baf1239073405f865d6e300713458dca27a780d1e1a6e2f20fc.jpg"
              ],
              "excerptSha256": "38d8116f8bc5202b2b8ad16d77cef584d62213c2f51a5c9bac1c205f8839f95b"
            }
          ]
