                "parts/part-0003/images/ae4ec151a050e5bab3795a46eab1c7977fe311022d45bac50db8fd7c626cd7a8.jpg",
                "parts/part-0003/images/ba33fb15edb0476f2ff7392bc2d85b9a100c6fa2b6e47d8551663767a1442a6e.jpg",
