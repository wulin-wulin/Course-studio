                "parts/part-0003/images/6e3d060423710b9a4b01df3d0ebe6161d245ef6b52009be1c627c8e9837ca765.jpg",
                "parts/part-0003/images/0d04c88cedb1bb920cd89ab199f75f00ff3d42f67d010b22fd604928153b58b2.jpg"
              ],
              "excerptSha256": "6dead87019d24e7f6ef02ba005e9dbfed8edec18db7aec6565dfe0f44788c5f4"
