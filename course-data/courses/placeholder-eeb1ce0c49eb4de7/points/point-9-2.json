    "blocks": [
      {
        "id": "tb-rotation-overview",
        "moduleId": "convention-and-intuition",
        "depth": "core",
        "kind": "explanation",
        "title": "从二维旋转到三维旋转",
        "markdown": "围绕空间中任意一条轴都可以旋转对象，但绕平行于坐标轴的轴旋转最容易处理。教材的整体思路是：先把绕任意轴的旋转分解为绕坐标轴的旋转，必要时再与平移组合，从而得到任意旋转的复合矩阵。\n\n方向约定是理解旋转矩阵的前提：沿着坐标轴的正半轴观察原点，绕该轴的逆时针方向为正向旋转。这条约定与二维中绕 z 轴的正向旋转保持一致，因此三维旋转可以看作二维旋转的自然推广。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-abebc170f9271e4546887278",
              "blockIds": [
                "block-000303"
              ],
              "headingPath": [
                "计算机图形学(第四版)",
                "三维旋转"
              ],
              "lineStart": 8306,
              "lineEnd": 8318,
