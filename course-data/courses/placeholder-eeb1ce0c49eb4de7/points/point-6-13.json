    "blocks": [
      {
        "id": "tb-region-idea",
        "kind": "explanation",
        "title": "教材：从内点向外填充的基本思路",
        "markdown": "教材把区域填充的另一种方式描述为：从区域的一个内部点出发，由内向外逐点绘制，直到碰到边界。这类方法适合绘画程序生成的、边界不规则且难以用解析曲线描述的区域。执行前至少需要两类信息：待填充区域内的一个起始位置，以及关于边界颜色或内部颜色的信息。填充内容可以是单一颜色，也可以是颜色图案；图案填充相当于把颜色掩模叠加到区域上，按掩模值决定每个像素的颜色。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-abebc170f9271e4546887278",
              "blockIds": [
                "block-000200"
              ],
              "headingPath": [
                "计算机图形学(第四版)",
                "不规则边界区域的填充方法"
              ],
              "lineStart": 5234,
              "lineEnd": 5239,
              "assetRefs": [],
              "excerptSha256": "f4899102a5f3a17b46c2b800ecaf7daf08d8c8a1bfd059d6a2b397df84896821"
            }
          ]
        },
        "moduleId": "region-fill-intuition",
        "depth": "core"
      },
      {
        "id": "model-region-inputs",
        "kind": "note",
        "title": "模型补充：把方法拆成三个可检查的问题",
        "markdown": "把上述过程当作状态扩散，可以固定检查三项：起点是否确实落在待填充区域内；用什么条件判断“区域到此结束”（边界颜色还是内部颜色）；允许向哪些方向扩散（四邻域还是含对角）。这三项分别决定填充能否启动、在哪里停止以及能否覆盖完整区域，也是比较边界填充与泛滥填充的统一维度。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-region-idea"
          ]
        },
        "moduleId": "region-fill-intuition",
        "depth": "support"
