          "outcomeRefs": [
            "compare-representations",
            "choose-representation"
          ],
          "order": 3
        },
        {
          "id": "choosing-representation",
          "title": "按阅读任务选择表示",
          "role": "decision-practice",
          "description": "统一比较维度，用情境练习完成表示选择。",
          "outcomeRefs": [
