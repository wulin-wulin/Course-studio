                "parts/part-0002/images/5db711f3f443d3fbd718d9f5129e54f55d43610ddf39e3b029a4edf8255d358b.jpg",
                "parts/part-0002/images/5827636b86c6089e1b06cfb049f6721a9b82bfbcea5deb967611750ca5976b77.jpg"
              ],
