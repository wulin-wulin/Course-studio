  "content": {
    "schema_version": "textbook-content/2.0",
    "learningDesign": {
      "primaryPattern": "concept-application-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保持教材对以智助教的目标、支持范围与教师主导作用的表述，围绕教师工作流补充分组、案例与判断练习，不新增教材以外的能力项。",
      "estimatedMinutes": 11,
      "outcomes": [
        {
          "id": "explain-assist-teaching",
          "text": "解释“以智助教”的含义、目标以及它所强调的教师主导作用。"
        },
        {
          "id": "map-assist-practices",
          "text": "列举以智助教覆盖的主要教学实践，并说明其技术基础。"
        },
        {
          "id": "apply-assist-judgment",
          "text": "判断一个具体应用情境是否属于以智助教，并说明教师在其中承担的责任。"
        }
      ],
      "misconceptions": [
        "把以智助教等同于用人工智能替代教师授课，忽视教师仍承担教学目标设定与结果判断的主导作用。",
        "把“有效减负”理解为减少教师必要的教学判断与复核，直接采用未经审核的人工智能生成内容。"
      ],
      "modules": [
