{
  "id": "point-2-12",
  "title": "（一）以智助教",
  "shortSummary": "说明以智助教场景的内涵与典型做法，聚焦人工智能对教师教学准备与实施工作的支持。",
  "keyTerms": [
    "以智助教",
    "教师支持",
    "教学准备"
  ],
  "animationType": "none",
  "difficulty": "基础",
  "importance": 0.85,
