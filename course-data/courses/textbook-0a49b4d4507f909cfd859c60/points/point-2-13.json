            "textbook-scenarios",
            "textbook-hybrid-learning",
            "textbook-goals"
          ]
        }
      },
      {
        "id": "model-check",
        "moduleId": "goals-and-check",
        "depth": "core",
        "kind": "exercise",
        "title": "模型练习：判断场景归属",
        "markdown": "判断练习：某学校计划让学生在校内与校外分别使用同一个智能学伴，先在校内实验室完成实验探究，再在校外社区开展调查，由真人教师与智能体共同提供反馈。\n\n问题：这一安排体现了以智助学的哪些特点？请从教材列举的场景类型和混合学习模式两方面说明理由。\n\n（这是模型补充的形成性练习，考查能否把教材场景与混合学习要求迁移到新情境。）",
        "provenance": {
