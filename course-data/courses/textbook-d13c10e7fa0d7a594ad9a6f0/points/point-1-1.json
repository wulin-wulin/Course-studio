    "blocks": [
      {
        "id": "textbook-section-position",
        "moduleId": "evolution-map",
        "depth": "core",
        "kind": "definition",
        "title": "本节定位与四个发展阶段",
        "markdown": "本节属于教材第 1 章的“大语言模型技术发展概述”，讨论语言建模在进入大模型阶段之前经历的技术变化，以及大模型进入金融领域的产业背景。教材把语言建模划分为四个发展阶段：统计语言模型、神经语言模型、预训练语言模型和大模型语言模型。\n\n下面按“每个阶段相对前一阶段改变了什么”这一线索依次展开。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d13c10e7fa0d7a594ad9a6f0",
              "blockIds": [
                "block-000001"
              ],
