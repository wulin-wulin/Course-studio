              "excerptSha256": "c7115f22ae8c48a6682812be5d6e839fe28d0b5ea90f0e82eb46db9bfaef9869"
            }
          ]
        }
      },
      {
        "id": "model-policy-actions",
        "moduleId": "actor-division",
        "depth": "support",
        "kind": "explanation",
        "title": "补充：政策职能如何落到培养环节",
        "markdown": "把上述职能落到培养环节，可以理解为三类动作：用政策与资源投入明确合作方向，用公共服务和平台降低各方协作成本，用监督与评估保证合作不流于形式。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-government-role"
          ]
        }
      },
      {
        "id": "textbook-finance-university",
        "moduleId": "actor-division",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：金融机构与高校的协同育人",
        "markdown": "金融机构是大模型应用的主体，其用人需求直接影响人才培养的方向和重点。教材建议金融机构主动参与协同育人体系：与高校共建现代产业学院，校企共制人才培养方案、共建专业课程体系、共同开展人才实习实训，让人才参与企业金融大模型实践，实现用人标准与高校培养标准的有效对接。高校则需要创新产教融合治理机制，畅通人才双向流动机制，完善校企协同育人机制。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d13c10e7fa0d7a594ad9a6f0",
