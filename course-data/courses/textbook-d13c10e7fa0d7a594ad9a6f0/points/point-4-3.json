    "blocks": [
      {
        "id": "tb-overview",
        "moduleId": "practice-overview",
        "depth": "core",
        "kind": "explanation",
        "title": "两个实践案例：学术与工业两条路径",
        "markdown": "教材用两个案例呈现金融大模型评测的落地步骤：**FinEval** 由上海财经大学团队构建，用于展示学术界如何划分金融评测的维度；**Fin-Eva** 由蚂蚁集团设计，用于展示工业界如何面向金融业务开展评测，并形成工业化的评测框架。两者分别回答“评测维度怎么划分”和“业务评测怎么组织”两个问题。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d13c10e7fa0d7a594ad9a6f0",
              "blockIds": [
                "block-000015"
              ],
              "headingPath": [
                "第 4 章 4.1 通用大模型评测框架",
                "大模型在金融领域的评测实践"
              ],
              "lineStart": 235,
              "lineEnd": 242,
              "assetRefs": [],
              "excerptSha256": "76d875ca85c8c4ce0cf1a01437275e153aa610c1389eb04c5aea47dbb8b81338"
            }
          ]
        }
      },
      {
        "id": "model-why-two-paths",
        "moduleId": "practice-overview",
        "depth": "support",
        "kind": "note",
        "title": "为什么两条路径要一起看",
        "markdown": "学术评测集擅长把领域知识拆成可复核的学科与题型，工业评测框架擅长把模型能力映射到真实业务链路。实践中可以把公开学术评测集当作能力基线，把自建业务评测框架当作上线前验证；这是对教材两个案例的组织方式，不代表某一方可以替代另一方。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-overview"
          ]
        }
      },
      {
        "id": "tb-fineval-profile",
        "moduleId": "case-fineval",
        "depth": "core",
        "kind": "table",
        "title": "FinEval 的领域、题量与数据划分",
        "markdown": "| 维度 | 教材给出的信息 |\n|---|---|\n| 领域 | 金融、经济、会计、证书四大领域 |\n| 学科 | 34 个学科；金融与会计各 10 个科目，经济与证书各 7 个 |\n| 题型 | 多项选择题 |\n| 题量 | 共 4661 题，总集 4661 题 |\n| 数据划分 | 开发集 170 题、验证集 1151 题、测试集 3340 题，各含 34 个主题 |",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d13c10e7fa0d7a594ad9a6f0",
