          ]
        }
      },
      {
        "id": "model-model-vs-agent",
        "moduleId": "core-modules",
        "depth": "support",
        "kind": "explanation",
        "title": "补充：大模型与智能体的分工",
        "markdown": "大模型负责理解与生成，并判断“要不要求助外部资源”；智能体负责把复杂任务分解、规划、执行并反思改进。二者不是替代关系：没有大模型，智能体缺少语言理解与生成能力；没有智能体，大模型难以自主完成多步任务。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-module-roles"
          ]
        }
      },
      {
        "id": "textbook-rag-pipeline",
        "moduleId": "knowledge-retrieval",
        "depth": "core",
        "kind": "mechanism",
        "title": "教材：知识库如何支撑检索增强生成",
        "markdown": "检索增强生成（RAG）结合信息检索与答案生成。先建设金融知识库，收录历史金融数据、最新市场动态、研究报告与市场分析，并把内容转换为高维向量；用户提问时用 FAISS 等向量搜索从库中快速检索相关条目；再把检索结果与问题一起以 Prompt 输入语言模型，得到更有依据的回答。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
