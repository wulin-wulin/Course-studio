          "basedOnBlockIds": [
            "tb-sequence-labeling"
          ]
        }
      },
      {
        "id": "tb-autoregressive",
        "moduleId": "autoregressive-modeling",
        "depth": "core",
        "kind": "definition",
        "title": "教材：自回归序列建模",
        "markdown": "自回归序列建模根据历史前缀逐步预测后续符号。给定符号序列 $y_{1:M}=(y_1,\\dots,y_M)$，模型在第 $t$ 个时刻根据历史 $y_{1:t-1}$ 预测下一个符号 $y_t$，语言模型是其中最典型的任务。循环网络在每个时刻接收前一个符号的向量表示 $\\hat{y}_{t-1}$，输出对当前符号 $y_t$ 的预测；$t=1$ 时的输入通常是开始符号的向量表示。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-97f1fe376125afb2e4c552d6",
