                "block-000048"
              ],
              "headingPath": [
                "Creating Classes",
                "Abstract Classes"
              ],
              "lineStart": 323,
              "lineEnd": 330,
              "assetRefs": [],
              "excerptSha256": "301b9237afc569baa02e6364eae0a5f244acae0fa4eb62312b04fc6b6bbcb5d8"
            }
          ]
        }
      },
      {
        "id": "model-abstract-check",
        "moduleId": "abstract-types",
        "depth": "support",
        "kind": "misconception",
        "title": "模型补充：抽象类不是“不能用的类”",
        "markdown": "常见误解是把抽象类当成完全不能使用的类。它不能直接实例化，但可以声明引用、保存子类对象，并调用其中已实现的方法；真正被延迟的是那些留给子类填补的抽象方法。抽象方法也不同于空实现：空实现给了默认行为、子类可以选择不改，抽象方法则把实现责任明确交给子类。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-abstract-method",
            "tb-abstract-class"
          ]
        }
      },
