      {
        "id": "model-interface-summary",
        "moduleId": "interfaces-and-multiple-inheritance",
        "depth": "core",
        "kind": "summary",
        "title": "模型补充：从冲突出发串起整条线索",
        "markdown": "把这条线索连起来：多重继承的冲突来自两个具体实现竞争同一方法；抽象方法消除了实现冲突，接口则把“全抽象、无状态”固定成语言机制。于是 Java 用单继承保留状态与实现的复用，用多个接口获得多重类型契约。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "tb-diamond-problem",
            "tb-fixing-abstraction",
