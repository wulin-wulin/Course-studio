                "block-000006"
              ],
              "headingPath": [
                "Types, Objects and Classes",
                "Recap: Control Flow"
              ],
              "lineStart": 41,
              "lineEnd": 46,
              "assetRefs": [],
              "excerptSha256": "79a9fd5daf01cb2df116e0df007151af2a176260523a4b4f464333da1caf099f"
            }
          ]
        }
      },
      {
        "id": "model-if-else-example",
        "moduleId": "decision-making",
        "depth": "core",
        "kind": "worked-example",
        "title": "补充示例：条件决定走哪一支",
        "markdown": "下面的片段只执行其中一支：\n\n```java\nint score = 72;\nif (score >= 60) {\n    System.out.println(\"pass\");\n} else {\n    System.out.println(\"retry\");\n}\n```\n\n当 `score` 为 72 时条件为真，只执行 if 分支；把 `score` 改成 50，则只执行 else 分支。两条分支不会同时执行，这正是 decision-making 与顺序执行的区别。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-decision-making"
          ]
        }
      },
      {
        "id": "textbook-looping",
        "moduleId": "looping",
        "depth": "core",
        "kind": "mechanism",
        "title": "教材：looping",
        "markdown": "循环用 `for` 与 `while` 实现，教材强调重复执行并不需要 recursion。教材中的示例都循环八次；当需要遍历整个数组时，`for` 写法更常见。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
