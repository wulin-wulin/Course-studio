            "textbook-fragmentation-and-name",
            "model-stack-heap-comparison"
          ]
        }
      },
      {
        "id": "model-summary-bridge",
        "moduleId": "check-and-bridge",
        "depth": "support",
        "kind": "summary",
        "title": "小结与下一点",
        "markdown": "小结：栈负责“随调用而生、随调用而灭”的定长数据；当数据需要在函数返回后继续存活，或需要在运行时改变大小时，就要转向堆——从空闲内存池分配、在栈上保存定长指针、扩容时新建并复制。代价是碎片与压缩开销。下一知识点将专门讨论 **pointer 与 reference**：它们都是保存地址的变量，但对地址的使用权限不同，这决定了堆上的对象能否被安全访问。",
        "provenance": {
          "origin": "model",
          "basedOnBlockIds": [
            "textbook-heap-allocation",
