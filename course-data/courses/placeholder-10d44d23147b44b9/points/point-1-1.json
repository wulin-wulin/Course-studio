      {
        "id": "chapter-context",
        "moduleId": "framing",
        "depth": "core",
        "kind": "note",
        "title": "本章从哪里开始",
        "markdown": "本章 **Types, Objects and Classes** 从编程范式讲起，再逐步引入类型、对象与类。学习 OOP 之前，先要弄清它和其他编程方式在「如何组织代码」上的差别。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d998d2c477335adeea4bf2f2",
              "blockIds": [
                "block-000001"
              ],
              "headingPath": [
                "Types, Objects and Classes"
              ],
              "lineStart": 3,
              "lineEnd": 4,
              "assetRefs": [],
