{
  "id": "point-1-1",
  "title": "Imperative, Procedural, Object Oriented",
  "shortSummary": "比较 imperative、procedural 与 object oriented 三种程序设计范式的组织方式、关注重点和适用场景。",
  "keyTerms": [
    "imperative",
    "procedural",
    "object oriented",
    "programming paradigm"
  ],
