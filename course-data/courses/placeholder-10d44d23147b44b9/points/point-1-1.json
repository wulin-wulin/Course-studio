    "learningDesign": {
      "primaryPattern": "concept-comparison-check",
      "adaptationLevel": "balanced",
      "editorialPolicy": "保留教材对 declarative 与 imperative 的定义和演进脉络，围绕区分与迁移目标补充直觉、例子和检查题。",
      "estimatedMinutes": 14,
      "outcomes": [
        {
          "id": "distinguish-declarative-imperative",
          "text": "区分 declarative 与 imperative 对“做什么”和“怎么做”的不同规定方式。"
        },
        {
          "id": "trace-paradigm-evolution",
          "text": "说明 imperative → procedural → object oriented 的递进扩展逻辑。"
        },
        {
          "id": "classify-paradigm",
          "text": "根据代码的组织方式判断其主导范式，并解释范式边界为何是模糊的。"
        }
      ],
      "misconceptions": [
        "把「使用了 class」当作已经采用面向对象范式，而忽略状态与操作是否真正绑定在一起。",
        "认为声明式与命令式互斥，忽视现实语言往往混合多种特性。"
      ],
