        {
          "id": "compare-execution-models",
          "text": "用统一维度比较直接解释源码、编译为本机机器码、编译到中间码并由本地虚拟机执行三种执行模型。"
        },
        {
          "id": "justify-hybrid-design",
          "text": "用可移植性、分发体积与源码保护解释为何最终转向带虚拟机的混合方案。"
        }
