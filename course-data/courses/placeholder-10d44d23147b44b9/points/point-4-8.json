{
  "id": "point-4-8",
  "title": "Errors",
  "shortSummary": "区分 error、bug 与 exception 的概念，说明错误来源、可恢复性和工程上处理错误的层次。",
  "keyTerms": [
    "error",
    "bug",
    "exception",
    "recoverability"
  ],
  "animationType": "none",
  "difficulty": "基础",
