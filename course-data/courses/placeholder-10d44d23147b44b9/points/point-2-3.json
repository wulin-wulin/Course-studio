    "blocks": [
      {
        "id": "tb-address-binding",
        "moduleId": "memory-model",
        "depth": "core",
        "kind": "explanation",
        "title": "教材：变量名、内存地址与类型",
        "markdown": "在编译器眼中，变量名会映射到一个具体的内存地址，同时记录它的类型，以便知道如何解释这段内存：例如 `x` 是 `int`，就从地址 43526 开始占用 4 个字节。\n\n更低层的语言允许程序员直接操作内存地址，这类保存地址的变量被称为 pointer，有时也被叫作 reference。直接操作内存能写出更快、更高效的代码，但也让我们暴露在更大的风险中；一旦改错地址，程序通常会崩溃。",
        "provenance": {
          "origin": "textbook",
          "representation": "paraphrase",
          "sourceSpans": [
            {
              "materialId": "doc-d998d2c477335adeea4bf2f2",
              "blockIds": [
                "block-000023"
              ],
              "headingPath": [
                "Pointers, References and Memory",
                "Pointers and References"
              ],
              "lineStart": 127,
              "lineEnd": 128,
              "assetRefs": [],
              "excerptSha256": "6cc1aeae79598cb3cf518e8109b90aaafc602b9a734c3f1790e5b6c72370cb8f"
            },
            {
              "materialId": "doc-d998d2c477335adeea4bf2f2",
              "blockIds": [
                "block-000024"
              ],
